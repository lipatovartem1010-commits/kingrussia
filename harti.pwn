	strcat(sctring,str);
	format(str,sizeof(str),"������:\t%d\n",PI[targetid][pWanted]);
	strcat(sctring,str);
	format(str,sizeof(str),"����� ��������:\t%s\n",phone_text);
	strcat(sctring,str);
	if(PI[targetid][pSex] == 1) format(str,sizeof(str),"����� ��:\t%s\n",married_text);
