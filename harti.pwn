										SetPlayerRaceCheckpoint(proposition_id,1, fX, fY, fZ, 0.0, 0.0, 0.0, 3.0);

										PlayerRaceSphere[playerid] = CreateDynamicCircle(fX, fY, 4.0, 0, 0);
										PlayerRaceSphere[proposition_id] = CreateDynamicCircle(fX, fY, 4.0, 0, 0);
									}
									default:
									{
										fX = 2099.3411;
										fY = -1882.9119;
										fZ = 18.8125;

										SetPlayerRaceCheckpoint(playerid,1, fX, fY, fZ, 0.0, 0.0, 0.0, 3.0);
										SetPlayerRaceCheckpoint(proposition_id,1, fX, fY, fZ, 0.0, 0.0, 0.0, 3.0);

										PlayerRaceSphere[playerid] = CreateDynamicCircle(fX, fY, 4.0, 0, 0);
										PlayerRaceSphere[proposition_id] = CreateDynamicCircle(fX, fY, 4.0, 0, 0);
									}
								}

								TogglePlayerControllable(playerid, false);
								TogglePlayerControllable(proposition_id, false);

								SetPVarInt(playerid, "gonka_time", 5);
								SetPVarInt(proposition_id, "gonka_time", 5);

								GameTextForPlayer(playerid, "~y~5", 1000, 3);
								GameTextForPlayer(proposition_id, "~y~5", 1000, 3);
						}
					}
				case PROPOSITION_TYPE_SELL_YACHT:
					{
						if(GetPlayerRubble(playerid) < value_1)
						{
							SendMes(proposition_id, COLOR_GREY, "� ������ %s ������������ �������", GetName(playerid));
							SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
							return 1;
						}
						format(stringer1, 128, "SELECT `y_owner` FROM `yacht` WHERE y_owner = '%s'", GetName(playerid));
						mysql_tquery(db_prod, stringer1, "BuyYacht_C","idd",playerid,proposition_id,value_1);
					}
				case PROPOSITION_TYPE_SELL_COPTER:
					{
						if(GetPlayerRubble(playerid) < value_1)
						{
							SendMes(proposition_id, COLOR_GREY, "� ������ %s ������������ �������", GetName(playerid));
							SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
							return 1;
						}
						format(stringer1, 128, "SELECT `h_owner` FROM `helicopters` WHERE h_owner = '%s'", GetName(playerid));
						mysql_tquery(db_prod, stringer1, "BuyHelic_C","idd",playerid,proposition_id,value_1);
					}
				case PROPOSITION_TYPE_SELL_GARAGE:
					{
						if(GetPlayerLimitMoney(proposition_id, value_1))
						{
							SendErr(playerid, "� ������ ������������ ���������� �����.");
							SendErr(proposition_id, "� ��� ������������ ���������� �����.");
						}
						else
						{
							new g = GetPlayerGarage(proposition_id);
							strmid(GarageInfo[g][g_OWNER], GetName(playerid), 0, 24, 24);

							SendClientMessage(playerid, COLOR_GREEN, "����������� ��� � �������� ������! ���� ������: /garage");
							SendClientMessage(proposition_id, COLOR_RED, "�� ������� ������� �����");

							if(GetActivePlayerVehicleCount(proposition_id) != 0)
							{
								for(new i; i < MAX_LOAD_VEHICLE; i++)
								{
									if(PlayerVehicle[proposition_id][i] != INVALID_PLAYER_VEHICLE)
									{
										if(GetVehicleVirtualWorld(PlayerVehicle[proposition_id][i]) != 0)
										{
											DestroyPlayerVehicle(proposition_id, i);
										}
									}
								}
							}

							SetPlayerMoney(playerid, -value_1);
							SetPlayerMoney(proposition_id, value_1);

							PI[playerid][pGarage] = g;
							MysqlUpdatePlayerInt(playerid, "garage", PI[playerid][pGarage]);

							PI[proposition_id][pGarage] = -1;
							MysqlUpdatePlayerInt(proposition_id, "garage", PI[proposition_id][pGarage]);

							SaveGarageData(g);
							UpdateGarageData(g);

							vehicle_in_garage[proposition_id] = 0;
							vehicle_in_garage[playerid] = 0;
						}
					}
				case PROPOSITION_TYPE_CHANGE_GARAGE:
					{
						if(value_1)
						{
							if(GetPlayerLimitMoney(proposition_id, value_1))
							{
								SendErr(playerid, "� ������ ������������ ���������� �����.");
								SendErr(proposition_id, "� ��� ������������ ���������� �����.");
							}
							else
							{
								new cost = value_1, g1, g2;
								g1 = GetPlayerGarage(proposition_id); g2 = GetPlayerGarage(playerid);

								strmid(GarageInfo[g1][g_OWNER], GetName(playerid), 0, strlen(GetName(playerid)), 24);
								strmid(GarageInfo[g2][g_OWNER], GetName(proposition_id), 0, strlen(GetName(proposition_id)), 24);

								SendClientMessage(playerid, COLOR_GREEN, "�� ������� ���������� �������� � �������! ���� ������: /garage");
								SendClientMessage(proposition_id, COLOR_GREEN, "�� ������� ���������� �������� � �������! ���� ������: /garage");

								SetPlayerMoney(proposition_id, -cost);
								SetPlayerMoney(playerid, cost);

								if(GetActivePlayerVehicleCount(proposition_id) != 0)
								{
									for(new i; i < MAX_LOAD_VEHICLE; i++)
									{
										if(PlayerVehicle[proposition_id][i] != INVALID_PLAYER_VEHICLE)
										{
											if(GetVehicleVirtualWorld(PlayerVehicle[proposition_id][i]) != 0)
											{
												DestroyPlayerVehicle(proposition_id, i);
											}
										}
									}
								}

								if(GetActivePlayerVehicleCount(playerid) != 0)
								{
									for(new i; i < MAX_LOAD_VEHICLE; i++)
									{
										if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
										{
											if(GetVehicleVirtualWorld(PlayerVehicle[playerid][i]) != 0)
											{
												DestroyPlayerVehicle(playerid, i);
											}
										}
									}
								}

								PI[playerid][pGarage] = g1;
								MysqlUpdatePlayerInt(playerid, "garage", PI[playerid][pGarage]);

								PI[proposition_id][pGarage] = g2;
								MysqlUpdatePlayerInt(proposition_id, "garage", PI[proposition_id][pGarage]);

								SaveGarageData(g1);
								UpdateGarageData(g1);

								SaveGarageData(g2);
								UpdateGarageData(g2);
							}
						}
						else
						{
							new g1, g2;
							g1 = GetPlayerGarage(proposition_id); g2 = GetPlayerGarage(playerid);

							strmid(GarageInfo[g1][g_OWNER], GetName(playerid), 0, strlen(GetName(playerid)), 24);
							strmid(GarageInfo[g2][g_OWNER], GetName(proposition_id), 0, strlen(GetName(proposition_id)), 24);

							SendClientMessage(playerid, COLOR_GREEN, "�� ������� ���������� �������� � �������! ���� ������: /garage");
							SendClientMessage(proposition_id, COLOR_GREEN, "�� ������� ���������� �������� � �������! ���� ������: /garage");

							if(GetActivePlayerVehicleCount(proposition_id) != 0)
							{
								for(new i; i < MAX_LOAD_VEHICLE; i++)
								{
									if(PlayerVehicle[proposition_id][i] != INVALID_PLAYER_VEHICLE)
									{
										if(GetVehicleVirtualWorld(PlayerVehicle[proposition_id][i]) != 0)
										{
											DestroyPlayerVehicle(proposition_id, i);
										}
									}
								}
							}

							if(GetActivePlayerVehicleCount(playerid) != 0)
							{
								for(new i; i < MAX_LOAD_VEHICLE; i++)
								{
									if(PlayerVehicle[playerid][i] != INVALID_PLAYER_VEHICLE)
									{
										if(GetVehicleVirtualWorld(PlayerVehicle[playerid][i]) != 0)
										{
											DestroyPlayerVehicle(playerid, i);
										}
									}
								}
							}

							PI[playerid][pGarage] = g1;
							MysqlUpdatePlayerInt(playerid, "garage", PI[playerid][pGarage]);

							PI[proposition_id][pGarage] = g2;
							MysqlUpdatePlayerInt(proposition_id, "garage", PI[proposition_id][pGarage]);

							SaveGarageData(g1);
							UpdateGarageData(g1);

							SaveGarageData(g2);
							UpdateGarageData(g2);
						}

						vehicle_in_garage[proposition_id] = 0;
						vehicle_in_garage[playerid] = 0;
					}
				case PROPOSITION_TYPE_AREND_HOUSE:
					{
						new n = value_2, h = value_1;

						strmid(HouseArendName[h][n], GetName(playerid), 0, strlen(GetName(playerid)), 24);
						PI[playerid][pHouseArend] = h;
						MysqlUpdatePlayerInt(playerid, "house_arend", PI[playerid][pHouseArend]);

						mysql_format(db_prod,stringer1, 144, "UPDATE `house` SET `hArendName` = '%s,%s,%s' WHERE `id` = '%d'", HouseArendName[h][0], HouseArendName[h][1], HouseArendName[h][2], h);
						mysql_tquery(db_prod, stringer1, "", "");

						SendMes(proposition_id, COLOR_GREEN, "�� ������� ��������� � ���� ������ ��� ����� '%s'", GetName(playerid));
						SendMes(playerid, COLOR_ORANGE, "[���]: %s ������� ��� � ����� ���� - /setspawn", GetName(proposition_id));
					}
				}
			}
			else SendClientMessage(playerid, 0x999999FF, "����� ������� ������");
		}
		else SendClientMessage(playerid, 0x999999FF, "����� ����� �� ����");

		to_player_sell_car[playerid] = INVALID_PLAYER_ID;
		to_player_sell_car[proposition_id] = INVALID_PLAYER_ID;
		proposition_info[playerid] = g_proposition_default_values;
	}
	return 1;
}

CMD:no(playerid, params[])
{
	new proposition_id = proposition_info[playerid][P_ING_ID];

	if(proposition_id != INVALID_PLAYER_ID)
	{
		if(proposition_info[proposition_id][P_OUT_ID] == playerid)
		{
			proposition_info[proposition_id] = g_proposition_default_values;

			SCMF(proposition_id, 0xFF6600FF, "%s ��������� �� ������ �����������", GetName(playerid));
			SCMF(playerid, 0xFF6600FF, "�� ���������� �� ����������� ������ %s", GetName(proposition_id));
			GameTextForPlayer(proposition_id, "~r~no", 4000, 1);
		}
		else SendClientMessage(playerid, 0xFF6600FF, "�� ���������� �� ����������� ������");
		proposition_info[playerid] = g_proposition_default_values;
	}
	return 1;
}
CMD:cancel(playerid, params[])
{
	new proposition_id = proposition_info[playerid][P_OUT_ID];
	if(proposition_id != INVALID_PLAYER_ID)
	{
		if(proposition_info[proposition_id][P_ING_ID] == playerid)
		{
			proposition_info[proposition_id] = g_proposition_default_values;
			SCMF(proposition_id, 0xFF6600FF, "%s ������� ���� �����������", GetName(playerid));
			SCMF(playerid, 0xFF6600FF, "�� �������� ���� ����������� ��� %s", GetName(proposition_id));
		}
		else SendClientMessage(playerid, 0xFF6600FF, "�� �������� ���� ��������� �����������");
		proposition_info[playerid] = g_proposition_default_values;
	}
	return 1;
}

DLG(19030, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	if(!listitem)
	{
		ShowPlayerBankAccounts(playerid, 0);
		return 1;
	}
	ShowPlayerCreateBankAccount(playerid);
	return 1;
}
DLG(8333, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new len = strlen(inputtext);

		if(!(3 <= len <= 32)) return ShowPlayerCreateBankAccount(playerid);
		if(IsABadBankAccountName(inputtext)) return ShowPlayerCreateBankAccount(playerid);
		if(GetPlayerRubble(playerid) < 1000000) return SendClientMessage(playerid, COLOR_RED, "� ��� ������������ �����");

		STRING_GLOBAL[0] = EOS;
		mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT COUNT(*) FROM `bank_accounts` WHERE `owner` = '%d'", PI[playerid][pID]);
		mysql_tquery(db_prod, STRING_GLOBAL, "CreateBankAccount", "ds", playerid, inputtext);
	}
	return 1;
}

