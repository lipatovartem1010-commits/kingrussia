		format(str,sizeof(str),"���������:\t{63BD4E}%s (%d)"cWH"\n\n",frakRangName[PI[targetid][pMember]][PI[targetid][pRank]],PI[targetid][pRank]);
		strcat(sctring,str);
		format(str,sizeof(str),"����������� ��������������:\t{63BD4E}%d/3"cWH"\n",PI[targetid][pTWarn]);
		strcat(sctring,str);
	}
	else format(str,sizeof(str),"�����������:\t���\n");

	new number_bizz = GetPlayerBizz(targetid);

