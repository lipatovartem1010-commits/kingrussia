	else format(frmt_str, sizeof frmt_str, "{A1A09E}����������");

	global_string = "";

	format(global_string, 512, "- {63BD4E}������������ "cWH"���������� ����\n- {F04245}��������� "cWH"���������� ����\n- �������� ����� ��������� ���������� ����� %s\n- ������� ���������� %s", fmt_str, frmt_str);
	ShowPlayerDialog(playerid, 5400+6, DIALOG_STYLE_LIST, ""cMain"���������� ����", global_string, "�������", "������");

