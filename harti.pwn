								SendMes(playerid, COLOR_GREEN, "�� ��������� SIM-����� � %s �� %d�", GetName(proposition_id), value_1);
								SendMes(proposition_id, COLOR_GREEN, "%s ����� � ��� SIM-����� �� %d�", GetName(playerid), value_1);
								PI[playerid][pPhoneNumber] = PI[proposition_id][pPhoneNumber];
								PI[proposition_id][pPhoneNumber] = 1;
								MysqlUpdatePlayerInt(playerid, "phonenumber", PI[playerid][pPhoneNumber]);
								MysqlUpdatePlayerInt(proposition_id, "phonenumber", PI[proposition_id][pPhoneNumber]);
								SendMes(playerid, COLOR_YELLOW, "��� ����� �����: "cWH"%d", PI[playerid][pPhoneNumber]);
							}
						}
					}
				case PROPOSITION_TYPE_SKIN:
					{
						if(GetPlayerRubble(playerid) < value_1)
						{
							SendMes(proposition_id, -1, ""cER"� ������ %s ������������ �������!", GetName(playerid));
							SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
						}
						else
