			if(GetPlayerVehicleID(playerid) != PI[playerid][YachtID]) return SendClientMessage(playerid, COLOR_RED, "�� ������ ���������� � ����� ����");

			new Float:pos[4];
			GetVehiclePos(GetPlayerVehicleID(playerid), pos[0],pos[1],pos[2]);
