								SendMes(playerid, COLOR_GREEN, "�� ��������� ������ (id ����� %i) � %s �� %d�",  GetPlayerSkin(proposition_id), GetName(proposition_id), value_1);
								SendMes(proposition_id, COLOR_GREEN, "%s ����� � ��� ������ �� %d�", GetName(playerid), value_1);

								PI[playerid][pModel] = PI[proposition_id][pModel];

