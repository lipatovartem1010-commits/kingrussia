		MeAction(playerid, "������� �����");
		SetPlayerChatBubble(playerid, "������� �����", -1, 20.0, 500);
	}
	return 1;
}

cmd:healme(playerid, params[])
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "�� ����������� ������ ������������");
	if(PI[playerid][pAptechka] == 0) return SendClientMessage(playerid, COLOR_GREY,"� ��� ��� �������, ������ �� � ������������ ��� 24/7!");
	new Float:shealth;
	GetPlayerHealth(playerid, shealth);
	if(shealth >= 100) return SendClientMessage(playerid, COLOR_GREY, "���� �������� ������ � ������� ���������!");
	SetPlayerHealth(playerid, shealth+40);
	GetPlayerHealth(playerid, shealth);
	if(shealth > 100) SetPlayerHealth(playerid, 100);
	PI[playerid][pAptechka]--;
	format(stringer1, sizeof(stringer1), "UPDATE `accounts` SET aptechka=aptechka-1 WHERE id=%d", PI[playerid][pID]);
	mysql_tquery(db_prod, stringer1, "", "");

	if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"ped","gum_eat",4.0,0,0,0,0,0,1);
	if(PI[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"����������� �������",COLOR_PURPLE,30.0,1000);
	else SetPlayerChatBubble(playerid,"������������ �������",COLOR_PURPLE,30.0,1000);
	GameTextForPlayer(playerid, "~b~+40 HP", 100, 1);
	return 1;
}

cmd:jtime(playerid)
