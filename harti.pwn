DLG(1404, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"� ��� ������ �������!");
		return 1;
	}
	if(GetPlayerInterior(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[���������] �� ������� ���������� ���� ��������������. ������� �� ���������.");
	if(GetPlayerVirtualWorld(playerid) != 0) return SendClientMessage(playerid, COLOR_GREY, "[���������] �� ������� ���������� ���� ��������������. ������� �� ���������.");
	if(CallPolice[playerid] > unix) return SendClientMessage(playerid, -1, ""cER"�� ������� �������� �������!");
	if(strlen(inputtext) < 6 || strlen(inputtext) > 20) return SendClientMessage(playerid, -1, ""cER"� ��������� ������ ���� �� 6 �� 20 ��������!");
	new full = 0;
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(IsACopAndFSB(i) && i != playerid) full++;
	}
	if(!full) SendClientMessage(playerid, -1, ""cPS"� ������ ������ ��� ����������� �� ���������!");
	else SendClientMessage(playerid, -1, ""cDA"��� ������ ��� ��������� �������. ����� ������");
	PoliceON[playerid] = true;
	new trr[3];
	if(IsPlayerToSquare(playerid,-891.3302,-2950.0190,2915.9917,560.3257)) trr = "";
	else if(IsPlayerToSquare(playerid,-2929.6589,-2889.1660,-1326.9077,1493.1770)) trr = "";
	else trr = "";
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(IsACopAndFSB(i))
		{
			SendMes(i, COLOR_WHITE, "%s[%d] {FFFF00}� ������ "cWH"%s{FFFF00}, �������� �������, ��������������: "cWH"%s", GetName(playerid), playerid, trr, inputtext);
			SendClientMessage(i, COLOR_YELLOW, "����� ������� ����� ������� "cWH"/gopolice");
		}
	}
	return 1;
}
