	return 1;
}

CMD:setweather(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	extract params -> new weather; else return SendClientMessage(playerid, COLOR_WHITE, ""cPS"{9ACD32}�������: /setweather [������ (0-20)]");

	if(!(-1 <= weather <= 20))
	{
		SendClientMessage(playerid, COLOR_BBLUE, "������ 0 �� 20 [-1 - ��������])");
		SendClientMessage(playerid, COLOR_BBLUE, "�������������: 6, 10");
		return 1;
	}
	if(weather != -1) SetWeather(weather), world_weather = weather;
	else ServerUpdateTimer_Random();

	new fmt_text[70];
	if(weather != -1) format(fmt_text, sizeof fmt_text, "�� ���������� ������ %d", weather);
	else format(fmt_text, sizeof fmt_text, "�� ���������� ��������� ������");
	SendClientMessage(playerid, 0xFFCC00AA, fmt_text);

	if(weather != -1) format(fmt_text, sizeof fmt_text, "[A] %s[%d] ��������� ������ �� ������� �� %d", GetName(playerid), playerid, weather);
	else format(fmt_text, sizeof fmt_text, "[A] %s[%d] ��������� ��������� ������ �� �������", GetName(playerid), playerid);
	SendAdminMessage(0x999999FF, fmt_text);

	fLogs("[admin] %s /setweather %i", GetName(playerid), weather);
	return 1;
}

CMD:settime(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	extract params -> new time; else return SendClientMessage(playerid, COLOR_WHITE, ""cPS"{9ACD32}�������: /settime [time 00-23]");

	if(time > 23 || time < 00) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"{9ACD32}�������: /settime [time 00-23]");

	foreach(new i : Player) SetPlayerTime(i, time, 00);

	new fmt_text[70];
	format(fmt_text, sizeof fmt_text, "[A] %s[%d] ��������� ����� �� ������� �� %d", GetName(playerid), playerid, time);

	SCMF(playerid, 0xFFCC00AA, "�� ���������� ����� �� %d �����", time);
	SendAdminMessage(0x999999FF, fmt_text);

	fLogs("[admin] %s /settime %i", GetName(playerid), time);
	return 1;
}

