	return 1;
}
DLG(19007, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	g_player_listitem_use[playerid] = g_player_listitem[playerid][listitem];

	player_full_id[playerid] = listitem;

	ShowPlayerDialog(playerid, 19005+3, DIALOG_STYLE_LIST, ""cMain"�������� ��������:", "1. �������� �������� �����\n{FD7C7C}2. ����� � �������������� FullDostup", "�������", "������");
	return 1;
}
DLG(19008, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new full_id = player_full_id[playerid],
	ac_name[MAX_PLAYER_NAME];

	strcat(ac_name, g_player_full_name[full_id][playerid]);

	switch(listitem)
	{
	case 0: ShowPlayerDialog(playerid, 19005+4, DIALOG_STYLE_INPUT, ""cMain"������� �������� �����", ""cWH"������� �������� ����� ��� ��������������:", "�������", "������");
	case 1:
		{
			new id = GetPlayerID(ac_name);
			if(id != INVALID_PLAYER_ID)
			{
				SendMes(id, COLOR_RED, "������������� %s ������� � ��� FullDostup", GetName(playerid));
				g_player_full_access[id] = false;
			}

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "DELETE FROM `fullaccess` WHERE `name` = '%e'", ac_name);
			mysql_tquery(db_prod, STRING_GLOBAL, "", "");

			SendMes(playerid, COLOR_RED, "FullDostup ���� � �������������� %s", ac_name);
		}
	}
	return 1;
}
DLG(19009, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	format(stringer1, 128, "UPDATE fullaccess SET rank = '%s' WHERE name = '%s'", inputtext, g_player_full_name[ player_full_id[playerid] ][playerid]);
	mysql_tquery(db_prod, stringer1, "", "");

	new id = GetPlayerID(g_player_full_name[ player_full_id[playerid] ][playerid]);
	if(id != INVALID_PLAYER_ID) strmid(full_access_rank[id], inputtext, 0, strlen(inputtext), 64);

	SendMes(playerid, COLOR_GREEN, "�� �������� ���� �������������� %s �� %s", g_player_full_name[ player_full_id[playerid] ][playerid], inputtext);
	return 1;
}
DLG(18290, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	switch(listitem)
	{
	case 0..1:
		{
			global_string = "";

			format(global_string, 100, "SELECT `id`, `model`, `dostup` FROM `vehicle` WHERE `fraction` = '%d'", PI[playerid][pLeader]);
			mysql_tquery(db_prod, global_string, "ShowFractionCars", "i", playerid);

		}

	}

	listitem_car[playerid] = listitem;
