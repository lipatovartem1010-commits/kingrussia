	format(string, sizeof(string), "%s��������:\t%d\n", string, PI[params[0]][pCash]);
	format(string, sizeof(string), "%s���. ���������� ����:\t%d\n", string,g_player_bank_accounts[params[0]][PI[params[0]][pMainBankAccount]][B_BALANCE]);
	format(string, sizeof(string), "%s�������:\t%d\n", string,PI[params[0]][pLevel]);
	format(string, sizeof(string), "%sIP ����� (�����.):\t%s\n", string,PI[params[0]][pRegIP]);
	format(string, sizeof(string), "%sIP ����� (�������.):\t%s\n", string,PI[params[0]][pLastIP]);
	format(string, sizeof(string), "%s���� �����������:\t%s\n", string,PI[params[0]][pRegData]);
	format(string, sizeof(string), "%s�����:\t%d\n", string,PI[params[0]][pPerfectCoins]);
