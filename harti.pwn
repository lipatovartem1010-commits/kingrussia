SetServerConfiguration(bind[], port)
{
	//51.91.91.100
	if(!strcmp(bind, "127.0.0.1") && port == 2749) // - Main
	{
		format(SERVER_INFO, sizeof(SERVER_INFO), "Red");

		BONUS_CASH = 40000000;
		BONUS_LVL = 8;

		SetGameModeText("KING RUSSIA | RED");

		db_prod = mysql_connect("127.0.0.1", "gs360213", "vqAdYE2adPVX", "gs360213");
		db_vost = mysql_connect("127.0.0.1", "gs360213", "vqAdYE2adPVX", "gs360213");
	}
	else if(!strcmp(bind, "127.0.0.1") && port == 2749) // - Test
	{
		format(SERVER_INFO, sizeof(SERVER_INFO), "Test");

		BONUS_CASH = 99999999;
		BONUS_LVL = 99;

		SetGameModeText("KRP TEST");

		db_prod = mysql_connect("127.0.0.1", "gs360213", "vqAdYE2adPVX", "gs360213");
		db_vost = mysql_connect("127.0.0.1", "gs360213", "vqAdYE2adPVX", "gs360213");
	}
	else
	{
		printf("[debug] Ошибка подключения к базе данных!.");
		GameModeExit();
		return 1;
	}

	SetTimer("OnVoiceToggle", 200, 1);

	return 1;
}

public OnGameModeInit()
{
	PB_CLEAR();
	settext(PBP_WINNAME,"None");
	Iter_Clear(Vehicle);
	SetGravity(0.009);
	ManualVehicleEngineAndLights();
	EnableStuntBonusForAll(0);
	SetNameTagDrawDistance(24.0);
	ShowPlayerMarkers(2);
	DisableInteriorEnterExits();

	mysql_tquery(db_prod, "DELETE FROM `connections`");

	SendRconCommand("sleep 3");

	for(new idx; idx < 12; idx ++)
	{
		ClearGovData(idx);
		for(new i; i < 4; i ++) g_gov_send_text[idx][i][0] = EOS;
	}
	for(new vehicleid = 0; vehicleid != MAX_VEHICLES; vehicleid ++)
	{
		VehicleFamilyCars[vehicleid] = -1;
	}
	for(new i; i < sizeof(glFamilyCaptPos); i++) CreateFamilySquare(i);
	for(new i; i < MAX_VCARS; i++) VehInfo[i][vVehicle] = INVALID_VEHICLE_ID;

	happy_hours =
	happy_hours_hour =
	happy_h_time =
	happy_hours_time =
	happy_hours_minute =
	gamemodeloaded = 0;

	CreateDynamic3DTextLabel(\
	"[ ������� ����� ]\n\n{ffffff}5.000.000 ������\n{cccccc}������� ALT",0xFFFF00FF, 235.8488,-1277.1885,1539.1079, 5.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

