{
	if(!response) return 1;
	if(strval(inputtext) < 1000 || strval(inputtext) > 10000000) return SendClientMessage(playerid, COLOR_GREY, "���������� �� 1.000 ����� �� 10.000.000 �����!");
	if(GetPlayerRubble(playerid) < strval(inputtext)) return SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
	new idx = GetPlayerInBiz(playerid);
	if(idx == -1) return SendErr(playerid, "�� �� � �������");
	SetPlayerMoney(playerid, -strval(inputtext));

	format(string, sizeof(string), "�� ��������� "cWH"%d �����{ffff00} �� "cWH"%d�!", strval(inputtext), strval(inputtext));
	SendClientMessage(playerid, COLOR_YELLOW, string);
	format(string, sizeof(string), "+%d�", strval(inputtext));
	GameTextForPlayer(playerid, string, 3000, 1);
	PhoneNumbers[playerid][0] += strval(inputtext);
	if(BizzInfo[idx][bMoney] >= strval(inputtext)/500)
	{
		BizzInfo[idx][bMoney] += strval(inputtext)/500;
		MysqlUpdateBizzInt(idx, "money", BizzInfo[idx][bMoney]);
	}
	return 1;
}
