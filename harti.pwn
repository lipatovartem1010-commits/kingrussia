				Mobile[playerid] = i;
				SendMes(i, COLOR_WHITE, "��c ��������: %s (%d). ����� ��������, �������: /pickup (/p)", GetName(playerid), PI[playerid][pPhoneNumber]);
				format(string11, sizeof(string11), "� %s ������ ��������� �������", GetName(i));
				ProxDetector(13.0, i, string11,COLOR_PURPLE);
				SendClientMessage(playerid, COLOR_WHITE, "����� �������� ������, �������: /hangup (/h)");
