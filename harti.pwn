{
	foreach(new i : Player)
	{
		if(!IsPlayerConnected(i)) continue;
		if(PlayerLogged[i]) GetPoluchPayDay[i] = 1;
		else SendClientMessage(i, COLOR_DARKORANGE, "�� �� �������������� ��� ��������� ��������");
	}
	return 1;
}
