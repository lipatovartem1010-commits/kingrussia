			}
		}
		case 3:
		{
			if(BizzInfo[i][bType] == 2 || BizzInfo[i][bType] == 7)
			{
				SendClientMessage(playerid, COLOR_GREY, "� ������ ���� ������� ������ ��������� ����� �� ����!");
			}
			else
			{
				ShowPlayerDialog(playerid, 106+12, 1, ""cMain"����", ""cWH"������� ���� �� ����:", "�������", "������");
