DLG(1000, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			PI[playerid][pSpawnChange] = 0;
		}
	case 1:
		{
			if(!GetPlayerHouse(playerid)) return SendClientMessage(playerid, -1, ""cER"� ��� ��� ����!");
			PI[playerid][pSpawnChange] = 1;
		}
	case 2:
		{
			if(!PI[playerid][pMember]) return SendClientMessage(playerid, -1, ""cER"�� �� �������� � �����������!");
			PI[playerid][pSpawnChange] = 2;
