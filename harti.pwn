DLG(5407, playerid, response, listitem, inputtext[])
{
	if(!response) return ShowHappyHoursDialog(playerid);

	new h_hours, h_minute;

	if(sscanf(inputtext, "p<:>ii", h_hours, h_minute)) return ShowPlayerDialog(playerid, 5400+7, DIALOG_STYLE_INPUT, ""cMain"������� �����", ""cWH"������� �����, �� �������� ����� ����������� ���������� ����\n���������� ������� ��� � ������ ����� ':'. ������: 16:01\n\n������� �����:", "�����", "������");
	if(!(0 <= h_hours <= 23)) return ShowPlayerDialog(playerid, 5400+7, DIALOG_STYLE_INPUT, ""cMain"������� �����", ""cWH"������� �����, �� �������� ����� ����������� ���������� ����\n���������� ������� ��� � ������ ����� ':'. ������: 16:01\n\n������� �����:", "�����", "������");
	if(!(0 <= h_minute <= 59)) return ShowPlayerDialog(playerid, 5400+7, DIALOG_STYLE_INPUT, ""cMain"������� �����", ""cWH"������� �����, �� �������� ����� ����������� ���������� ����\n���������� ������� ��� � ������ ����� ':'. ������: 16:01\n\n������� �����:", "�����", "������");

	happy_hours_hour = h_hours;
	happy_hours_minute = h_minute;

	global_string = "";

	if(first_happy_hours[playerid])
	{
		happy_hours = (!happy_hours) ? (1) : (0);

		format(global_string, 128, "�� ������� ������������ '���������� ����'. �� %02d:%02d �� MCK �������� ����� X2 Donate, X2 EXP, X2 ��", happy_hours_hour, happy_hours_minute);
		SendClientMessageToAll(0xff9f21FF, global_string);

		doubling_exp 		=
		doubling_donate 	=
		doubling_job 		= 1;

		happy_hours_time 	= 30;

		if(IsValidDynamic3DTextLabel(DonateText[0])) DestroyDynamic3DTextLabel(DonateText[0]);
		if(IsValidDynamic3DTextLabel(DonateText[1])) DestroyDynamic3DTextLabel(DonateText[1]);
		if(IsValidDynamic3DTextLabel(DonateText[2])) DestroyDynamic3DTextLabel(DonateText[2]);
	}
	else
	{
		format(global_string, 128, "��������! '���������� ����' ���� �������� �� %02d:%02d �� MCK", happy_hours_hour, happy_hours_minute);
		SendClientMessageToAll(0xff9f21FF, global_string);
		SendClientMessageToAll(0xff9f21FF, "�� ����� ������� �� ������� �������� ����� X2 Donate, X2 EXP, X2 ��");

		if(IsValidDynamic3DTextLabel(DonateText[0])) DestroyDynamic3DTextLabel(DonateText[0]);
		if(IsValidDynamic3DTextLabel(DonateText[1])) DestroyDynamic3DTextLabel(DonateText[1]);
		if(IsValidDynamic3DTextLabel(DonateText[2])) DestroyDynamic3DTextLabel(DonateText[2]);
	}
	fLogs("[admin] %s /apanel ���������� ���������� ���� %i %i", GetName(playerid), happy_hours_hour, happy_hours_minute);
	first_happy_hours[playerid] = 0;
	return 1;
}
DLG(5403, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::apanel(playerid);
	if(listitem < 3)
	{
