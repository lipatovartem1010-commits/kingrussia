	strcat(sctring,str);
	format(str,sizeof(str),""cWH"�������:\t%d\n",PI[targetid][pAge]);
	strcat(sctring,str);
	format(str,sizeof(str),"��������������:\t%d / 3\n",PI[targetid][pWarn]);
	strcat(sctring,str);
	format(str,sizeof(str),"�����������������:\t%d\n",PI[targetid][pZakon]);
