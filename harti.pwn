	{
		PlayerALogin[playerid] = 1;
		ShowPlayerDialog(playerid, 3200, DIALOG_STYLE_INPUT, ""cMain"����������� ��������������", "\
		"cWH"������� ������, ������� ����� �� ������ ��������������\n\n\
