ShowBetCar(const playerid)
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "ListBetCar", "i", playerid);
}

callback::ListBetCar(playerid)
{
	new rows = cache_num_rows();
	if(rows == 0) return SendClientMessage(playerid, COLOR_RED, "������: � ��� ��� �����������");

	STRING_GLOBAL[0] = EOS;
	new car_number[64], car_model;
	for(new idx = 0; idx < rows; idx++)
	{
		DynamicInfo[playerid][CarID][idx] = cache_get_field_content_int(idx, "id");
		cache_get_field_content(idx, "c_number", car_number, db_prod, 64);
		car_model = cache_get_field_content_int(idx, "c_model");

		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cMain"%i."cWH"%s [�����: %s]\n", STRING_GLOBAL, idx + 1, VehicleNames[car_model-400], car_number);
	}
	ShowPlayerDialog(playerid, 2526, DIALOG_STYLE_LIST, ""cMain"�������� ���������� �� ������:", STRING_GLOBAL, "�������", "������");
	return 0x1;
}

DLG(2526, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"�� �� ���������� � ������");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `ownable_cars` WHERE `id` = '%d' AND `c_owner` = '%s' LIMIT 1", DynamicInfo[playerid][CarID][listitem], GetName(playerid));
	mysql_tquery(db_prod, STRING_GLOBAL, "LoadBetCar", "i", playerid);
	return 0x1;
}

callback::LoadBetCar(playerid)
{
	new rows = cache_num_rows();
	if(rows == 0) return SendClientMessage(playerid, COLOR_RED, "��������� ������");

	new car_ids;
	new car_model;
	new car_number[64];

	car_ids = cache_get_field_content_int(0, "id");
	car_model = cache_get_field_content_int(0, "c_model");
	cache_get_field_content(0, "c_number", car_number, db_prod, 64);

	for(new i; i < MAX_LOAD_VEHICLE; i++)
	{
		if(PlayerVehicleSQL[playerid][i] == car_ids)
			return SendErr(playerid, "��� ������ ��������� ������ ����������");
	}
	AddExchangeBet(playerid, BET_CAR, car_ids, car_number, car_model);
	return 0x1;
}

DLG(2521, playerid, response, listitem, inputtext[])
{
	if(!response) return 0x1;
	switch(listitem)
	{
		case 0: ShowBetMoney(playerid);
		case 1: ShowBetCar(playerid);
		case 2:
		{
			if(GetPlayerHouse(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"� ��� ��� ������������");
			AddExchangeBet(playerid, BET_HOUSE, GetPlayerHouse(playerid));
		}
		case 3:
		{
			if(GetPlayerBizz(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"� ��� ��� �������");
			AddExchangeBet(playerid, BET_BIZ, GetPlayerBizz(playerid));
		}
	}
	return 0x1;
}

EndExchange(const playerid)
{
	if(DynamicInfo[playerid][ExchangeTargetid] == INVALID_PLAYER_ID) return 0x1;

	new targetid = DynamicInfo[playerid][ExchangeTargetid];
	DeletePVar(playerid, "Exchange:Ready");
	DeletePVar(playerid, "Exchange:Confirmed");

	DeletePVar(targetid, "Exchange:Ready");
	DeletePVar(targetid, "Exchange:Confirmed");
	Delete3DTextLabel(DynamicInfo[playerid][ExchangeText] ? DynamicInfo[playerid][ExchangeText] : DynamicInfo[targetid][ExchangeText]);

	SetPlayerVirtualWorld(targetid, 0);
	SetPlayerVirtualWorld(playerid, 0);

	SendClientMessage(targetid, -1, ""cDA"����� ��������.");
	SendClientMessage(playerid, -1, ""cDA"����� ��������.");

	DynamicInfo[targetid][ExchangeTargetid] = 0xFFFF;
	DynamicInfo[playerid][ExchangeTargetid] = 0xFFFF;
	return 0x1;
}

StartExchange(const playerid, const targetid)
{
	if(DynamicInfo[playerid][ExchangeTargetid] != 0xFFFF || DynamicInfo[targetid][ExchangeTargetid] != 0xFFFF) return 0x0;

	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		gExchange[playerid][i][xType] =
		gExchange[playerid][i][xId] = INVALID_EXCHANGE;

		gExchange[targetid][i][xType] =
		gExchange[targetid][i][xId] = INVALID_EXCHANGE;

		gExchange[playerid][i][xNumber][0] = EOS;
		gExchange[targetid][i][xNumber][0] = EOS;
	}

	DeletePVar(playerid, "Exchange:Ready");
	DeletePVar(playerid, "Exchange:Confirmed");

	DeletePVar(targetid, "Exchange:Ready");
	DeletePVar(targetid, "Exchange:Confirmed");

	DynamicInfo[playerid][ExchangeTargetid] = targetid;
	DynamicInfo[targetid][ExchangeTargetid] = playerid;

	SetPlayerVirtualWorld(playerid, playerid + 10000);
	SetPlayerVirtualWorld(targetid, playerid + 10000);

	DynamicInfo[playerid][ExchangeText] = Create3DTextLabel("*", 0xCCCCCCFF, 1979.4351, 495.8600, 3323.9719, 30.0, playerid + 10000, 0);
	UpdateExchangeText(playerid);

	SendClientMessage(playerid, 0xCCCCCCFF, "���� ���������� �������: /emenu");
	SendClientMessage(targetid, 0xCCCCCCFF, "���� ���������� �������: /emenu");
	return 0x1;
}

UpdateExchangeText(const playeridEx)
{
	if(DynamicInfo[playeridEx][ExchangeTargetid] == 0xFFFF) return 0x0;

	new playerid = DynamicInfo[playeridEx][ExchangeTargetid] ? playeridEx : DynamicInfo[playeridEx][ExchangeTargetid];
	new targetid = DynamicInfo[playerid][ExchangeTargetid];

	new PlayerBuffer[(MAX_EXCHANGE + 1) * 60];
	new TargetBuffer[(MAX_EXCHANGE + 1) * 60];
	FormatExchange3DText(playerid, PlayerBuffer);
	FormatExchange3DText(targetid, TargetBuffer);

	new string_echange[(MAX_EXCHANGE + 1) * 60 * 2];
	strcat(string_echange, PlayerBuffer);
	strcat(string_echange, TargetBuffer);
	Update3DTextLabelText(DynamicInfo[playerid][ExchangeText], 0xCCCCCCFF, string_echange);
	return 0x1;
}


FormatExchange3DText(const playerid, buffer[], len = sizeof buffer)
{
	format(buffer, len, "** ����� ������ {00FF00}%s{CCCCCC} **\n", GetName(playerid));
	if(GetPVarInt(playerid, "Exchange:Ready"))
	{
		strcat(buffer, "{FFFFFF}����� � ������\n{CCCCCC}", len);
	}

	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[playerid][i][xType] == INVALID_EXCHANGE) continue;
		switch(gExchange[playerid][i][xType])
		{
			case BET_RUBBLE:
			{
				format(buffer, len, "%s����� %d\n", buffer, gExchange[playerid][i][xId]);
			}
			case BET_EURO:
			{
				format(buffer, len, "%s���� %d\n", buffer, gExchange[playerid][i][xId]);
			}
			case BET_CAR:
			{
				format(buffer, len, "%s���������� %s [%s{CCCCCC}]\n", buffer, VehicleNames[gExchange[playerid][i][xModel] - 400], gExchange[playerid][i][xNumber]);
			}
			case BET_HOUSE:
			{
				format(buffer, len, "%s��� �%d "cWH"|{CCCCCC} ���������: %d ������\n", buffer, gExchange[playerid][i][xId], HouseInfo[gExchange[playerid][i][xId]][hPrice]);
			}
			case BET_BIZ:
			{
				format(buffer, len, "%s������ �%d "cWH"|{CCCCCC} ���������: %d ������ "cWH"|{CCCCCC} ��������: %s\n", buffer, gExchange[playerid][i][xId], BizzInfo[gExchange[playerid][i][xId]][bPrice], BizzInfo[gExchange[playerid][i][xId]][bName]);
			}
		}

	}
}




ConfirmExchange(const playerid)
{
	new targetid = DynamicInfo[playerid][ExchangeTargetid];

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cWH"����� ������ "cMain"%s\n", GetName(playerid));

	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[playerid][i][xType] == INVALID_EXCHANGE) continue;
		switch(gExchange[playerid][i][xType])
		{
			case BET_RUBBLE:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}����� "cMain"%d\n", STRING_GLOBAL, gExchange[playerid][i][xId]);
				fLogs("[EXCHANGE] %s ������� � ����� %i ������", GetName(playerid), gExchange[playerid][i][xId]);
			}
			case BET_EURO:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}���� "cMain"%d\n", STRING_GLOBAL, gExchange[playerid][i][xId]);
				fLogs("[EXCHANGE] %s ������� � ����� %i ����", GetName(playerid), gExchange[playerid][i][xId]);
			}
			case BET_CAR:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}���������� "cMain"%s{CCCCCC} [%s{CCCCCC}]\n", STRING_GLOBAL, VehicleNames[gExchange[playerid][i][xModel] - 400], gExchange[playerid][i][xNumber]);
				fLogs("[EXCHANGE] %s ������� � ����� ����������: %s � ������� %s", GetName(playerid), VehicleNames[gExchange[playerid][i][xModel] - 400], gExchange[playerid][i][xNumber]);
			}
			case BET_HOUSE:
			{
				if(gExchange[playerid][i][xId] != INVALID_EXCHANGE)
				{
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}��� "cMain"�%d "cWH"| {CCCCCC}���������: "cMain"%d {CCCCCC}%s\n", STRING_GLOBAL, gExchange[playerid][i][xId], HouseInfo[gExchange[playerid][i][xId]][hPrice], HouseInfo[gExchange[playerid][i][xId]][hType] ? ("����") : ("������"));
					fLogs("[EXCHANGE] %s ������� � ����� ��� %i", GetName(playerid),  gExchange[playerid][i][xId]);
				}
			}
			case BET_BIZ:
			{
				if(gExchange[playerid][i][xId] != INVALID_EXCHANGE)
				{
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}������ "cMain"�%d "cWH"| {CCCCCC}���������: "cMain"%d {CCCCCC}������ "cWH"| ��������: "cMain"%s\n", STRING_GLOBAL, gExchange[playerid][i][xId], BizzInfo[gExchange[playerid][i][xId]][bPrice], BizzInfo[gExchange[playerid][i][xId]][bName]);
					fLogs("[EXCHANGE] %s ������� � ����� ������ %i", GetName(playerid),  gExchange[playerid][i][xId]);
				}
			}
		}
	}

	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cWH"����� ������ "cMain"%s\n", STRING_GLOBAL, GetName(targetid));
	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		if(gExchange[targetid][i][xType] == INVALID_EXCHANGE) continue;
		switch(gExchange[targetid][i][xType])
		{
			case BET_RUBBLE:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}����� "cMain"%d\n", STRING_GLOBAL, gExchange[targetid][i][xId]);
				fLogs("[EXCHANGE] %s ������� � ����� %i ������", GetName(targetid), gExchange[targetid][i][xId]);
			}
			case BET_EURO:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}���� "cMain"%d\n", STRING_GLOBAL, gExchange[targetid][i][xId]);

				fLogs("[EXCHANGE] %s ������� � ����� %i ����", GetName(targetid), gExchange[targetid][i][xId]);
			}
			case BET_CAR:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}���������� "cMain"%s [%s"cWH"]\n", STRING_GLOBAL, VehicleNames[gExchange[targetid][i][xModel] - 400], gExchange[targetid][i][xNumber]);
				fLogs("[EXCHANGE] %s ������� � ����� ����������: %s � ������� %s", GetName(targetid), VehicleNames[gExchange[targetid][i][xModel] - 400], gExchange[targetid][i][xNumber]);
			}
			case BET_HOUSE:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}��� "cMain"�%d "cWH"| {CCCCCC}���������: "cMain"%d {CCCCCC}%s\n", STRING_GLOBAL, gExchange[targetid][i][xId], HouseInfo[gExchange[targetid][i][xId]][hPrice], HouseInfo[gExchange[targetid][i][xId]][hType] ? ("����") : ("������"));
				fLogs("[EXCHANGE] %s ������� � ����� ��� %i", GetName(targetid),  gExchange[targetid][i][xId]);
			}
			case BET_BIZ:
			{
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s{CCCCCC}������ "cMain"�%d "cWH"| {CCCCCC}���������: "cMain"%d {CCCCCC}������ "cWH"| ��������: "cMain"%s\n", STRING_GLOBAL, gExchange[targetid][i][xId], BizzInfo[gExchange[targetid][i][xId]][bPrice], BizzInfo[gExchange[targetid][i][xId]][bName]);
				fLogs("[EXCHANGE] %s ������� � ����� ������ %i", GetName(targetid),  gExchange[targetid][i][xId]);
			}
		}
	}
	strcat(STRING_GLOBAL, "\n�� ������������� �����?");
	ShowPlayerDialog(playerid, 2525, DIALOG_STYLE_MSGBOX, ""cMain"������������� ������", STRING_GLOBAL, "��", "���");
	ShowPlayerDialog(targetid, 2525, DIALOG_STYLE_MSGBOX, ""cMain"������������� ������", STRING_GLOBAL, "��", "���");
	return 0x1;
}

DLG(2525, playerid, response, listitem, inputtext[])
{
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return SendClientMessage(playerid, -1, ""cER"�� �� ���������� � ������");
	if(!response)
	{
		SetPVarInt(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Ready", false);
		SetPVarInt(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Confirmed", false);
		SetPVarInt(playerid, "Exchange:Ready", false);
		UpdateExchangeText(playerid);

		SendClientMessage(DynamicInfo[playerid][ExchangeTargetid], -1, ""cER"����� ��������� �� ������");
		SendClientMessage(playerid,  -1, ""cER"�� ���������� �� ������");
		return 0x1;
	}

	SetPVarInt(playerid, "Exchange:Confirmed", true);
	if(GetPVarInt(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Confirmed"))
	{
		Exchange(playerid);
		return 0x1;
	}

	SendClientMessage(playerid, -1, ""cDA"�������� ������������� �� ������� ���������");
	SendClientMessage(playerid, -1, ""cDA"�� ����������� �����");
	return 0x1;
}

ExchangeFailed(const playerid, const reason[])
{
	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cER"������ ��� ������ � %s[%d]. �������: %s", GetName(playerid), playerid, reason);
	SendClientMessage(DynamicInfo[playerid][ExchangeTargetid], 0xCCCCCCFF, STRING_GLOBAL);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""cER"������ ��� ������ � %s[%d]. �������: %s", GetName(DynamicInfo[playerid][ExchangeTargetid]), DynamicInfo[playerid][ExchangeTargetid], reason);
	SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);

	UpdateExchangeText(playerid);

	DeletePVar(playerid, "Exchange:Ready");
	DeletePVar(playerid, "Exchange:Confirmed");

	DeletePVar(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Ready");
	DeletePVar(DynamicInfo[playerid][ExchangeTargetid], "Exchange:Confirmed");
	return 0x0;
}

Exchange(const playerid)
{
	if(DynamicInfo[playerid][ExchangeTargetid] == 0xFFFF) return 0x0;
	new targetid = DynamicInfo[playerid][ExchangeTargetid];

	new status1 = CheckPlayerExchange(playerid);
	new status2 = CheckPlayerExchange(targetid);

	if((status1 + status2) == 2)
	{
		TransferExchange(playerid, targetid);
		TransferExchange(targetid, playerid);
		EndExchange(playerid);
	}
	fLogs("[EXCHANGE] %s �������� ����� � %s", GetName(playerid), GetName(targetid));
	return 0x1;
}

CheckPlayerExchange(const playerid)
{
	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		switch(gExchange[playerid][i][xType])
		{
			case BET_CAR:
			{

				new str_query[128];
				format(str_query, sizeof(str_query), "SELECT `c_status` FROM `ownable_cars` WHERE `id` = '%d' AND `c_owner` = '%s' LIMIT 1", gExchange[playerid][i][xId], GetName(playerid));
				new Cache:result = mysql_query(db_prod, str_query);
				if(cache_num_rows() == 0)
				{
					ExchangeFailed(playerid, "����������� ���������");
					cache_delete(result);
					return 0x1;
				}

				new cid;
				cid = cache_get_field_content_int(0, "id");

				for(new z; z < MAX_LOAD_VEHICLE; z++)
				{
					if(PlayerVehicleSQL[playerid][z] == cid)
						return SendErr(playerid, "��� ������ ��������� ������ ����������");
				}

				STRING_GLOBAL[0] = EOS;
				new targetid = DynamicInfo[playerid][ExchangeTargetid];
				format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `ownable_cars` WHERE `c_owner` = '%s'", GetName(targetid));
				new Cache:results = mysql_query(db_prod, STRING_GLOBAL);
				new reason_car = cache_num_rows();
				cache_delete(results);

				if(PI[targetid][pCountCars] < (reason_car)) return ExchangeFailed(targetid, "������������� ���������� ������ ��� ����������");
			}
			case BET_EURO:
			{
				if(gExchange[playerid][i][xId] > playerEuro[playerid]) return ExchangeFailed(playerid, "���������� �����");
			}
			case BET_RUBBLE:
			{
				if(gExchange[playerid][i][xId] > GetPlayerRubble(playerid)) return ExchangeFailed(playerid, "���������� �����");
				if(GetPlayerLimitMoney(DynamicInfo[playerid][ExchangeTargetid], gExchange[playerid][i][xId]))
				{
					SendErr(playerid, "� ������ ������������ ���������� �����.");
					SendErr(DynamicInfo[playerid][ExchangeTargetid], "� ��� ������������ ���������� �����.");
					return 1;
				}
			}
			case BET_HOUSE:
			{
				if(GetPlayerHouse(playerid) != gExchange[playerid][i][xId]) return ExchangeFailed(playerid, "���������� ����");
			}
			case BET_BIZ:
			{
				if(GetPlayerBizz(playerid) != gExchange[playerid][i][xId]) return ExchangeFailed(playerid, "���������� �������");
			}
		}
	}
	return 0x1;
}
TransferExchange(const playerid, const targetid) //kakaxa
{
	for(new i = 0; i < MAX_EXCHANGE; i++)
	{
		switch(gExchange[playerid][i][xType])
		{
			case BET_EURO:
			{
				TransferEuro(-1, targetid, gExchange[playerid][i][xId], "����� �����");
				TransferEuro(playerid, -1, gExchange[playerid][i][xId], "����� �����");
			}
			case BET_RUBBLE:
			{
				SetPlayerMoney(targetid, gExchange[playerid][i][xId]);
				SetPlayerMoney(playerid, -gExchange[playerid][i][xId]);
			}
			case BET_CAR:
			{
				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `ownable_cars` SET `c_owner` = '%s' WHERE `id` = '%d'", GetName(targetid), gExchange[playerid][i][xId]);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");

				fLogs("[cars][�����] %s +%i /setcar", GetName(targetid), gExchange[playerid][i][xModel]);
				fLogs("[cars][�����] %s -%i /setcar", GetName(playerid), gExchange[playerid][i][xModel]);
			}
			case BET_HOUSE:
			{
				if(GetPlayerHouse(targetid) != 0)
				{
					new house_id = GetPlayerHouse(targetid);
					HouseInfo[house_id][hLock] = 1;
					strmid(HouseInfo[house_id][hOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

					UpdateHouse(house_id);
					PI[playerid][pHouse] = -1;
					PI[playerid][pSpawnChange] = 0;
					MysqlUpdatePlayerInt(playerid, "house", PI[playerid][pHouse]);

					STRING_GLOBAL[0] = EOS;
					mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET  `hOwner` = '%s', `hOwned` = '-1', `buyprice` = '0', `hLock` = '%d', `hOplata` = '0', `hGarage` = '0', `hAutoDoors` = '0' WHERE `id` = '%d' LIMIT 1", HouseInfo[house_id][hOwner], HouseInfo[house_id][hLock], house_id);
					mysql_tquery(db_prod, STRING_GLOBAL, "", "");
				}

				new house_id = gExchange[playerid][i][xId];
				PI[playerid][pHouse] = -1;
				PI[playerid][pSpawnChange] = 0;
				PI[targetid][pHouse] = house_id;
				HouseInfo[house_id][hOwned] = PI[targetid][pID];

				MysqlUpdatePlayerInt(targetid, "house", PI[targetid][pHouse]);
				MysqlUpdatePlayerInt(playerid, "house", PI[playerid][pHouse]);
				strmid(HouseInfo[house_id][hOwner], GetName(targetid), 0, strlen(GetName(targetid)), MAX_PLAYER_NAME);

				UpdateHouse(house_id);

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `house` SET `hOwner` = '%s', `hOwned` = '%d', `hOplata` = '%d', `buyprice` = '%d', `hLock` = '%d' WHERE `id` = '%d' LIMIT 1", HouseInfo[house_id][hOwner], HouseInfo[house_id][hOwned], HouseInfo[house_id][hOplata], HouseInfo[house_id][hBuyPrice], HouseInfo[house_id][hLock], house_id);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");
			}
			case BET_BIZ: //kakaxa
			{
				if(GetPlayerBizz(targetid) != 0)
				{
					new bizz_id = GetPlayerBizz(targetid);
					PI[targetid][pBiz] = -1;

					BizzInfo[bizz_id][bOwned] = -1;
					BizzInfo[bizz_id][bMoney] = 0;
					BizzInfo[bizz_id][bProduct] = 0;
					BizzInfo[bizz_id][bBuyPrice] = 0;
					MysqlUpdatePlayerInt(targetid, "business", PI[targetid][pBiz]);
					strmid(BizzInfo[bizz_id][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME);

					STRING_GLOBAL[0] = EOS;
					mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bizz` SET `owner` = 'None', `owned` = '-1', `block` = '0', `money` = '0', `penter` = '0', `till` = '50', `buyprice` = '%d', `product` = '%d', `oplata` = '0' WHERE `id` = '%d'", BizzInfo[bizz_id][bOwner], BizzInfo[bizz_id][bBuyPrice], BizzInfo[bizz_id][bProduct], bizz_id);
					mysql_tquery(db_prod, STRING_GLOBAL, "", "");
					UpdateBizz(bizz_id);
				}

				new bizz_id = gExchange[playerid][i][xId];
				PI[targetid][pBiz] = bizz_id;
				PI[playerid][pBiz] = -1;

				BizzInfo[bizz_id][bOwned] = PI[targetid][pID];
				MysqlUpdatePlayerInt(targetid, "business", PI[targetid][pBiz]);
				MysqlUpdatePlayerInt(playerid, "business", PI[playerid][pBiz]);
				strmid(BizzInfo[bizz_id][bOwner], GetName(targetid), 0, strlen(GetName(targetid)), MAX_PLAYER_NAME);
				UpdateBizz(bizz_id);

				STRING_GLOBAL[0] = EOS;
				mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `bizz` SET `owner` = '%s', `owned` = '%d', `buyprice` = '%d', `product` = '%d', `money` = '%d', `oplata` = '%d' WHERE `id` = '%d' LIMIT 1", BizzInfo[bizz_id][bOwner], BizzInfo[bizz_id][bOwned], BizzInfo[bizz_id][bBuyPrice], BizzInfo[bizz_id][bProduct],BizzInfo[bizz_id][bMoney], BizzInfo[bizz_id][bOplata], bizz_id);
				mysql_tquery(db_prod, STRING_GLOBAL, "", "");
			}
		}
	}
	return 0x1;
}

stock ShowNotify(playerid, text[])
{
	PlayerTextDrawSetString(playerid, info_money_PTD[playerid], text);
	PlayerTextDrawShow(playerid, info_money_PTD[playerid]);
	TextDrawShowForPlayer(playerid, info_money_TD);
	SetTimerEx("HideNotify", 2500, false, "i", playerid);
	return true;
}

callback:: HideNotify(playerid)
{
	PlayerTextDrawHide(playerid, info_money_PTD[playerid]);
	TextDrawHideForPlayer(playerid, info_money_TD);
	return true;
}

stock ShowAltInfo(playerid)
{
	TextDrawShowForPlayer(playerid, info_alt_TD);
	return true;
}

stock HideAltInfo(playerid)
{
	TextDrawHideForPlayer(playerid, info_alt_TD);
	return true;
}


ClearPlayerFreeTune(playerid, CAR_MODE)
{
	new
		c1,
		c2,
		paint_job,
		tune[14],
		tune_string[64],
		query[256];

	new vehicleid = GetPlayerVehicleID(playerid);

	if(GetPlayerVehicle(playerid))
	{
		format(query, sizeof(query), "SELECT * FROM `ownable_cars` WHERE `id` = '%i' LIMIT 1", GetPlayerVehicleSqlID(playerid));
		new Cache:result = mysql_query(db_prod, query);
		new rows = cache_num_rows();
		if(rows > 0)
		{
			c1 = cache_get_field_content_int(0, "c_color1");
			c2 = cache_get_field_content_int(0, "c_color2");
			paint_job = cache_get_field_content_int(0, "c_paintjob");
			cache_get_field_content(0, "c_vehcom", tune_string, db_prod, 64);
			sscanf(tune_string, "p<,>a<i>[14]", tune);
		}
		cache_delete(result);
	}

	if(CAR_MODE == CARMODTYPE_REAR_BUMPER)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][ZBUMPER][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_FRONT_BUMPER)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][PBUMPER][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_EXHAUST)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][EXHAUST][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_SIDESKIRT)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][SIDESKIRT][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_SPOILER)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), TUNING_DATA[playerid][SPOILER][PlayerIDMode[playerid]]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_PAINTJOB)
	{
		if(paint_job != 3) ChangeVehiclePaintjob(GetPlayerVehicleID(playerid),paint_job);
		else
		{
			ChangeVehiclePaintjob(GetPlayerVehicleID(playerid), 3);
			ChangeVehicleColor(GetPlayerVehicleID(playerid), c1, c2);
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_NITRO)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), g_nitro[PlayerIDMode[playerid]][D_ID]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}
	if(CAR_MODE == CARMODTYPE_WHEELS)
	{
		if(GetPlayerState(playerid) && GetPlayerVehicle(playerid))
		{
			RemoveVehicleComponent(GetPlayerVehicleID(playerid), g_disk[PlayerIDMode[playerid]][D_ID]);
			for(new s; s < 14; s ++)
			{
				if(tune[s] != 0)
				{
					AddVehicleComponent(GetPlayerVehicleID(playerid), tune[s]);
				}
			}
		}
		for(new i = 0; i != 11; i ++) TextDrawHideForPlayer(playerid, sto_td_global[i]);
		for(new i = 0; i != 2; i ++) PlayerTextDrawHide(playerid, sto_td_player[playerid][i]);
	}

	switch(CAR_MODE)
	{
		case CAR_MODE_TYPE_NEON:
		{
			EnableVehicleNeon
			(
				playerid,
				vehicleid,
				GetVehicleTuning(vehicleid, VT_NEON_COLOR_R),
				GetVehicleTuning(vehicleid, VT_NEON_COLOR_G),
				GetVehicleTuning(vehicleid, VT_NEON_COLOR_B),
				100
			);

			SetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_R, 0);
			SetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_G, 0);
			SetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_B, 0);
		}

		case CAR_MODE_TYPE_LIGHTS:
		{
			EnableVehicleLights(playerid, vehicleid, GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_R), GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_G), GetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_B));

			SetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_R, 100);
			SetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_G, 100);
			SetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_B, 100);
		}

		case CAR_MODE_TYPE_TINING:
		{
			EnableVehicleTining
			(
				playerid,
				vehicleid,
				1,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			EnableVehicleTining
			(
				playerid,
				vehicleid,
				2,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			EnableVehicleTining
			(
				playerid,
				vehicleid,
				3,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			EnableVehicleTining
			(
				playerid,
				vehicleid,
				0,
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_R),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_G),
				GetVehicleTuning(vehicleid, VT_TINING_COLOR_B),
				GetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT)
			);

			SetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_R, 0);
			SetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_G, 0);
			SetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_B, 0);
		}

		case CAR_MODE_TYPE_COLOR:
		{
			SetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_R, 255);
			SetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_G, 255);
			SetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_B, 255);

			//printf("[debug] tuning -> CAR_MODE_TYPE_COLOR -> VT_MAIN_COLOR_R: %d VT_MAIN_COLOR_G: %d VT_MAIN_COLOR_B: %d", GetVehicleTuning(vehicleid, VT_MAIN_COLOR_R), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_G), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_B));

			EnableVehicleColor(playerid, vehicleid, GetVehicleTuning(vehicleid, VT_MAIN_COLOR_R), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_G), GetVehicleTuning(vehicleid, VT_MAIN_COLOR_B));
		}
	}

	return 0x1;
}

stock GetPlayerCostTune(playerid, CAR_MODE, COST_BIZZ)
{
	new REASON_COST;
	switch(CAR_MODE)
	{
		case CARMODTYPE_SPOILER:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_SPOILER)  * COST_BIZZ;
		}
		case CARMODTYPE_SIDESKIRT:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_SIDESKIRT)  * COST_BIZZ;
		}
		case CARMODTYPE_EXHAUST:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_EXHAUST)  * COST_BIZZ;
		}
		case CARMODTYPE_FRONT_BUMPER:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_PBUMPER)  * COST_BIZZ;
		}
		case CARMODTYPE_REAR_BUMPER:
		{
			REASON_COST = ((PlayerIDMode[playerid] + 1) * COST_ZBUMPER)  * COST_BIZZ;
		}
	}
	return REASON_COST;
}
BuyTuneCarMode(playerid, CAR_MODE)
{
	new bizz_id = CTObizzid[playerid];
	new COST_BIZZ = BizzInfo[bizz_id][bTill];

	new vehicleid = GetPlayerVehicleID(playerid);

	if(CAR_MODE == CARMODTYPE_REAR_BUMPER)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_REAR_BUMPER, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"�� ������ ��� ��������");
	}
	if(CAR_MODE == CARMODTYPE_FRONT_BUMPER)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_FRONT_BUMPER, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"�� ������ ��� ��������");
	}
	if(CAR_MODE == CARMODTYPE_EXHAUST)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_EXHAUST, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"�� ������ ��� ��������");
	}
	if(CAR_MODE == CARMODTYPE_SIDESKIRT)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_SIDESKIRT, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"�� ������ ��� ��������");
	}
	if(CAR_MODE == CARMODTYPE_SPOILER)
	{
		new i = PlayerIDMode[playerid];
		new price = GetPlayerCostTune(playerid, CARMODTYPE_SPOILER, COST_BIZZ);
		if(GetPlayerRubble(playerid) < price) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		SetPlayerMoney(playerid, -price, 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += ((price / 100) * 25);
			BizzInfo[bizz_id][bProduct] -= 250;
			BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}

		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"�� ������ ��� ��������");
	}
	if(CAR_MODE == CARMODTYPE_NITRO)
	{
		new i = PlayerIDMode[playerid];
		if(GetPlayerRubble(playerid) < g_nitro[i][D_PRICE] * COST_BIZZ) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		SetPlayerMoney(playerid, -(g_nitro[i][D_PRICE] * COST_BIZZ), 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzInfo[bizz_id][bProduct] -= 50;
			BizzPay[i] += g_paintjob[i][D_PRICE] * COST_BIZZ;
			BizzInfo[bizz_id][bMoney] += g_nitro[i][D_PRICE] * COST_BIZZ;
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"�� ������ ��� ��������");
	}
	if(CAR_MODE == CARMODTYPE_PAINTJOB)
	{
		new i = PlayerIDMode[playerid];
		if(GetPlayerRubble(playerid) < g_paintjob[i][D_PRICE] * COST_BIZZ) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		if(GetPlayerVehicle(playerid))
		{
			SetPlayerMoney(playerid, -(g_paintjob[i][D_PRICE] * COST_BIZZ), 1);
			if(BizzInfo[i][bProduct] > 0)
			{
				BizzInfo[i][bProduct] -= 50;
				BizzPay[i] += g_paintjob[i][D_PRICE] * COST_BIZZ;
				BizzInfo[i][bMoney] += g_paintjob[i][D_PRICE] * COST_BIZZ;
				MysqlUpdateBizzInt(i, "money", BizzInfo[i][bMoney]);
				MysqlUpdateBizzInt(i, "product", BizzInfo[i][bProduct]);
			}
			SendMes(playerid,COLOR_GREEN,"�� �������� %d ��� �� ����������� ������", g_paintjob[i][D_PRICE] * COST_BIZZ);

			format(stringer1, 128, "UPDATE `ownable_cars` SET c_paintjob = '%i' WHERE c_owner = '%s' AND id = '%d'", g_paintjob[i][D_ID], GetName(playerid), GetPlayerVehicleSqlID(playerid));
			mysql_tquery(db_prod, stringer1, "", "");
		}
	}
	if(CAR_MODE == CARMODTYPE_WHEELS)
	{
		new i = PlayerIDMode[playerid];
		if(GetPlayerRubble(playerid) < g_disk[i][D_PRICE] * COST_BIZZ) return SendClientMessage(playerid, -1, ""cER"������������ �������!");

		SetPlayerMoney(playerid, -(g_disk[i][D_PRICE] * COST_BIZZ), 1);
		if(BizzInfo[i][bProduct] > 0)
		{
			BizzPay[bizz_id] += g_disk[i][D_PRICE] * COST_BIZZ;
			BizzInfo[bizz_id][bProduct] -= 50;
			BizzInfo[bizz_id][bMoney] += g_disk[i][D_PRICE] * COST_BIZZ;
			MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
			MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
		}
		SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		SendClientMessage(playerid,-1, ""cDA"�� ������ ��� ��������");
	}

	switch(CAR_MODE)
	{
		case CAR_MODE_TYPE_NEON:
		{
			new i = PlayerIDMode[playerid];
			new price = NEON_PRICE;

			if(PI[playerid][pPerfectCoins] < price)
				return SendClientMessage(playerid, -1, ""cER"������������ Perfect Coins! ��������� ����: {ffffff}kaif-crmp.com/donate");

			PI[playerid][pPerfectCoins] -= price;
			UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 25);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"�� ������� ������ �������� ���������");

			SetVehicleTuning(vehicleid, VT_NEON_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_R));
			SetVehicleTuning(vehicleid, VT_NEON_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_G));
			SetVehicleTuning(vehicleid, VT_NEON_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_NEON_COLOR_B));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}

		case CAR_MODE_TYPE_LIGHTS:
		{
			new i = PlayerIDMode[playerid];
			new price = LIGHTS_PRICE;

			if(PI[playerid][pPerfectCoins] < price)
				return SendClientMessage(playerid, -1, ""cER"������������ Perfect Coins! ��������� ����: {ffffff}kaif-crmp.com/donate");

			PI[playerid][pPerfectCoins] -= price;
			UpdatePlayerData(playerid, "credits", PI[playerid][pPerfectCoins]);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 25);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"�� ������� ������ ��������� ����� ���");

			SetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_R));
			SetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_G));
			SetVehicleTuning(vehicleid, VT_LIGHTS_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_LIGHTS_COLOR_B));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}

		case CAR_MODE_TYPE_TINING:
		{
			new i = PlayerIDMode[playerid];
			new price = TINING_PRICE;

			if(GetPlayerRubble(playerid) < price)
				return SendClientMessage(playerid, -1, ""cER"������������ �������!");

			SetPlayerMoney(playerid, -price, 1);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 45);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"�� ������� ������ ���������");

			SetVehicleTuning(vehicleid, VT_TINING_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_R));
			SetVehicleTuning(vehicleid, VT_TINING_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_G));
			SetVehicleTuning(vehicleid, VT_TINING_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_TINING_COLOR_B));
			SetVehicleTuning(vehicleid, VT_TINING_TRANSPARENT, GetVehicleTuningTemp(vehicleid, VT_TINING_TRANSPARENT));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}

		case CAR_MODE_TYPE_COLOR:
		{
			new i = PlayerIDMode[playerid];
			new price = COLOR_PRICE;

			if(GetPlayerRubble(playerid) < price)
				return SendClientMessage(playerid, -1, ""cER"������������ �������!");

			SetPlayerMoney(playerid, -price, 1);

			if(BizzInfo[i][bProduct] > 0)
			{
				BizzPay[bizz_id] += ((price / 100) * 25);

				BizzInfo[bizz_id][bProduct] -= 250;
				BizzInfo[bizz_id][bMoney] += ((price / 100) * 25);

				MysqlUpdateBizzInt(bizz_id, "money", BizzInfo[bizz_id][bMoney]);
				MysqlUpdateBizzInt(bizz_id, "product", BizzInfo[bizz_id][bProduct]);
			}

			SendClientMessage(playerid,-1, ""cDA"�� ������� ������ RGB ���� ����������");

			SetVehicleTuning(vehicleid, VT_MAIN_COLOR_R, GetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_R));
			SetVehicleTuning(vehicleid, VT_MAIN_COLOR_G, GetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_G));
			SetVehicleTuning(vehicleid, VT_MAIN_COLOR_B, GetVehicleTuningTemp(vehicleid, VT_MAIN_COLOR_B));

			SaveVehicleTuning(playerid, GetPlayerVehicleSqlID(playerid));
		}
	}

	return 0x1;
}

ShowPlayerTuneDraw(playerid, CAR_MODE)
{
	new string_td[100];
	PlayerIDMode[playerid] = 0;
	PlayerCarMode[playerid] = CAR_MODE;
	new vehicleid = GetPlayerVehicleID(playerid);
	new COST_BIZZ = BizzInfo[CTObizzid[playerid]][bTill];

	if(CAR_MODE == CARMODTYPE_REAR_BUMPER)
	{
		GetTypeModelComponent(playerid, GetVehicleModel(vehicleid), CARMODTYPE_REAR_BUMPER);
		if(TUNING_DATA[playerid][ZBUMPER_COUNT] == -1) return SendClientMessage(playerid, -1, ""cER"�� ���� ������ ���������� ��� ������ �������");

		format(string_td, sizeof(string_td), "%s", GetNameComponent(playerid, TUNING_DATA[playerid][ZBUMPER][0]));
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][0], string_td);

		new price = GetPlayerCostTune(playerid, CARMODTYPE_REAR_BUMPER, COST_BIZZ);
		format(string_td, sizeof(string_td), "%d ������", price);
		PlayerTextDrawSetString(playerid, sto_td_player[playerid][1], string_td);

