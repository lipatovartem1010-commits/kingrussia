CMD:call(playerid, params[])
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"� ��� ��� SIM-�����!");
	new number;
	if(sscanf(params, "i", number)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/call [����� ��������]");

	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"� ��� ��� ��������!");}
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"� ��� ������ �������!");
	if(Mobile[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "�� ��� �������������� �� ��������!");
	if(Phone[playerid] == false) return SendClientMessage(playerid, -1, ""cER"� ��� �������� �������!");
	if(Ether[playerid] == true) return SendClientMessage(playerid, -1, ""cER"�������� ����������!");

	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] == VIP_STATE_NONE) return SendClientMessage(playerid, COLOR_RED, "��������� ���� ���-����� � ����� ��������� ������! ������ ������ /callbalance");
	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipCall] == 0) return SendClientMessage(playerid, COLOR_RED, "��������� ���� ���-����� � ����� ��������� ������! ������ ������ /callbalance");

	if(number == 1111)
	{
		if(PI[playerid][MobileBank] == 0) return SendClientMessage(playerid, -1, ""cER"� ��� ��� ���������� ��������� �������");
		ShowPlayerBankMenu(playerid);
		return 0x1;
	}
	if(number == SMI_NUMBER)
	{
		if(PI[playerid][pNews] != 1) return SendClientMessage(playerid, -1, ""cPS"�� ������ ������������� �� ����� ���� ������!");
		if(PI[playerid][pNews] < 1) return SendClientMessage(playerid, -1, ""cER"News ID Error!");
		if(EtherCall == false) return SendClientMessage(playerid, -1, ""cER"����� �� ��������� �������!");

		foreach(new i: Player)
		{
			if(PlayerLogged[i] == true && (Ether[i] == true) && PI[i][pMember] == TEAM_SMI)
			{
				if(Mobile[i] != -1) return SendClientMessage(playerid, COLOR_GREY, "����� ��� ������������� �� ��������!");
				if(PI[i][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "������� �������� ����������!");
				Mobile[playerid] = i;
				SendMes(i, COLOR_WHITE, "��c ��������: %s (%d).", GetName(playerid), PI[playerid][pPhoneNumber]);
				SendClientMessage(i, COLOR_WHITE, "����� �������� ������� /pickup (/p) ��� ����� ��������� ����� /hangup (/h)");

				format(stringer1, 144, "� %s ������ ��������� �������", GetName(i));
				ProxDetector(13.0, i, stringer1, COLOR_PURPLE);

				SendClientMessage(playerid, COLOR_WHITE, "����� �������� ������, �������: /hangup (/h)");
				if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, 11);
				CellTime[playerid] = 0;

				phone_call_to_id[playerid] = i;
				phone_caller_id[i] = playerid;
				return 1;
			}
		}
	}
	foreach(new i: Player)
	{
		if(number == PI[i][pPhoneNumber] && PlayerLogged[i] == true)
		{
			if(Phone[i] == false) return SendClientMessage(playerid, -1, ""cER"����� �������� �������!");
			if(Ether[i] == true)  return SendClientMessage(playerid, -1, ""cER"�������� ����������!");
			if(Mobile[i] != -1) return SendClientMessage(playerid, -1, ""cER"����� ��� ������������� �� ��������!");
			if(PI[i][pJail]) return SendClientMessage(playerid, COLOR_GREY, "������� �������� ����������!");

			Mobile[playerid] = i;
			SendMes(i, COLOR_WHITE, "��c ��������: %s (%d).", GetName(playerid), PI[playerid][pPhoneNumber]);
			SendClientMessage(i, COLOR_WHITE, "����� �������� ������� /pickup (/p) ��� ����� ��������� ����� /hangup (/h)");

			format(stringer1, 144, "� %s ������ ��������� �������", GetName(i));
			ProxDetector(13.0, i, stringer1, COLOR_PURPLE);

			SendClientMessage(playerid, COLOR_WHITE, "����� �������� ������, �������: /hangup (/h)");
			if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, 11);
			CellTime[playerid] = 0;

			phone_call_to_id[playerid] = i;
			phone_caller_id[i] = playerid;
			return 1;
		}
	}
	SendClientMessage(playerid, COLOR_RED, "������ � ����� ������� ���");
	return 1;
}
alias:call("c");

CMD:sms(playerid, params[])
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"� ��� ��� SIM-�����!");
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"� ��� ��� ��������!");}

	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"� ��� ������ �������!");
	if(Phone[playerid] == false) return SendClientMessage(playerid, -1, ""cER"� ��� �������� �������!");

	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] == VIP_STATE_NONE) return SendClientMessage(playerid, COLOR_RED, "�� ����� ������������ �������");
	if(PI[playerid][pPhoneBalance] < 5 && TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipSms] == 0) return SendClientMessage(playerid, COLOR_RED, "�� ����� ������������ �������");
	if(!strlen(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/sms [����� ��������] [���������]");
	extract params -> new number, string:message[66];

	new full, to_player = INVALID_PLAYER_ID;
	if(number == SMI_NUMBER) full++;
	if(full == 0)
	{
		foreach(new i: Player) if(number == PI[i][pPhoneNumber] && PlayerLogged[i] == true)
		{
			if(Phone[i] == false)
			{
				SendClientMessage(playerid, -1, ""cPS"����� �������� �������!");
				break;
			}
			if(PI[i][pJail] > 0)
			{
				SendClientMessage(playerid, -1, ""cPS"������� �������� ����������!");
				break;
			}
			to_player = i;
			full++;
			break;
		}
	}
	if(to_player == INVALID_PLAYER_ID && number != SMI_NUMBER)
	{
		SendClientMessage(playerid, COLOR_RED, "������� ��������� ��� ���� �������");
		return 1;
	}
	if(!strlen(message)) return SendClientMessage(playerid, COLOR_RED, "������� ��������� ��� ��������");
	if(strlen(message) >= 65) return SendClientMessage(playerid, COLOR_RED, "������� ������� ���������");

	if(IsIpFound(message) || CheckString(message)) return PlayerGetsChatBan(playerid, message);


	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		if(VipData[TYPE_VIP[playerid]][VipSms] == 0)
		{
			if(PI[playerid][pPhoneBalance] >= 5)
			{
				GameTextForPlayer(playerid, "SMS  ~n~~y~-5 rub", 4000, 1);
				PI[playerid][pPhoneBalance] -= 5;
			}
			if(PI[playerid][pPhoneBalance] <= 4) PI[playerid][pPhoneBalance] = 0;
		}
	}
	if(TYPE_VIP[playerid] == VIP_STATE_NONE)
	{
		if(PI[playerid][pPhoneBalance] >= 5) PI[playerid][pPhoneBalance] -= 5;
		if(PI[playerid][pPhoneBalance] <= 4) PI[playerid][pPhoneBalance] = 0;
		GameTextForPlayer(playerid, "SMS  ~n~~y~-5 rub", 4000, 1);
	}

	full = 0;
	if(number == SMI_NUMBER)
	{
		if(PI[playerid][pNews] != 1) return SendClientMessage(playerid, -1, ""cPS"�� ������ ������������� �� ����� ���� ������!");
		if(EtherSms == false) return SendClientMessage(playerid, -1, ""cER"����� �� ��������� ���!");

		if(PI[playerid][pPhoneBalance] < SmsPrice) return SendClientMessage(playerid, COLOR_GREY, "�� ����� ����� � ����� �� ������� �����!");

		foreach(new i: Player)
		{
			if((Ether[i] == true) && PI[i][pMember] == TEAM_SMI)
			{
				PI[playerid][pPhoneBalance] -= SmsPrice;
				FracBank[8] += SmsPrice;
				MysqlUpdateOtherInt("lsnbank", FracBank[8]);

				global_string = "";
				format(global_string, 144, "SMS: "cWH"%s {FFFF00}�����������: "cWH"%s {FFFF00}���.: "cWH"%d", message, GetName(playerid), PI[playerid][pPhoneNumber]);
				SendClientMessage(i, COLOR_YELLOW, global_string);

				global_string = "";
				format(global_string, 144, "SMS: "cWH"%s {FFFF00}����������: "cWH"��� {FFFF00}���.: "cWH"555", message);
				SendClientMessage(playerid, COLOR_YELLOW, global_string);

				SendClientMessage(playerid, COLOR_WHITE, "���� ��������� ����������");
				MeAction(playerid, "������ ��������� �������");
				full ++;
				break;
			}
		}
	}
	if(full == 0)
	{
		new fmt_msg[128];
		format(fmt_msg, sizeof fmt_msg, "SMS: %s | �����������: %s [�.%d]", message, GetName(playerid), PI[playerid][pPhoneNumber]);
		SendClientMessage(to_player, 0xFFFF00FF, fmt_msg);
		SetPlayerChatBubble(to_player, "SMS <<", 0xFFFF00FF, 5.0, 1500);

		format(fmt_msg, sizeof fmt_msg, "SMS: %s | ����������: %s [�.%d]", message, GetName(to_player), PI[to_player][pPhoneNumber]);
		SendClientMessage(playerid, 0xFFFF00FF, fmt_msg);
		SetPlayerChatBubble(playerid, "SMS >>", 0xFFFF00FF, 5.0, 1500);

		format(global_string,sizeof(global_string),"[SMS]: %s[%d] ��� %s[%d] %s",GetName(playerid),playerid,GetName(to_player),to_player,message);
		foreach(new i: Player)
		{
			if(PI[i][pAdmin] && PA_ChatSMS[i]) SendClientMessage(i,COLOR_GRAD1,global_string);
		}
		global_string = "";
	}
	MeAction(playerid, "������ ��������� �������");
	return 1;
}

cmd:pickup(playerid)
{
	if(Mobile[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "�� ��� �������������� �� ��������!");
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(Mobile[i] == playerid)
		{
			if(Ether[playerid] == true) CallNews++, EtherCalled[i] = true;
			Mobile[playerid] = i;
			SendMes(i, COLOR_GRAD2, "%s ������ ������ ����������", GetName(playerid));



			if(TYPE_VIP[i] != VIP_STATE_NONE)
			{
				if(VipData[TYPE_VIP[i]][VipCall] == 0)
				{
					if(PI[i][pPhoneBalance] >= 10) PI[i][pPhoneBalance] -= 10;
					if(PI[i][pPhoneBalance] <= 9) PI[i][pPhoneBalance] = 0;
				}
			}
			if(TYPE_VIP[i] == VIP_STATE_NONE)
			{
				if(PI[i][pPhoneBalance] >= 10) PI[i][pPhoneBalance] -= 10;
				if(PI[i][pPhoneBalance] <= 9) PI[i][pPhoneBalance] = 0;
			}


			MeAction(playerid, "������� �� ������");
			if(!IsPlayerInAnyVehicle(playerid)) SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
			return 1;
		}
	}
	return 1;
}
alias:pickup("p");

CMD:hangup(playerid)
{
	if(Mobile[playerid] == -1) return SendClientMessage(playerid, COLOR_GREY, "�� �� �������������� �� ��������!");
	new callerid = Mobile[playerid];
	SendClientMessage(callerid, COLOR_GRAD2, "������� ������� ������");
	SetPlayerSpecialAction(callerid,SPECIAL_ACTION_STOPUSECELLPHONE);
	CellTime[callerid] = -1;
	CellTime[playerid] = -1;
	Mobile[callerid] = -1;
	if(EtherCalled[playerid] == true) EtherCalled[playerid] = false;
	if(EtherCalled[callerid] == true) EtherCalled[callerid] = false;
	SendClientMessage(playerid,  COLOR_GRAD2, "�� �������� ������");
	Mobile[playerid] = -1;
	SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
	CallTime[playerid] = 0;
	CallTime[callerid] = 0;
	return 1;
}
alias:hangup("h");

cmd:togphone(playerid, params[])
{
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"� ��� ��� ���������� SIM-�����!");
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"� ��� ��� ��������!");}
	if(Phone[playerid])
	{
		Phone[playerid] = false;
		SendSucc(playerid, "�� ��������� �������");
		SetPlayerChatBubble(playerid, "�������� �������", COLOR_PURPLE, 13.0, 10000);
		PhoneMenuExit(playerid);
	}
	else
	{
		Phone[playerid] = true;
		SendSucc(playerid, "�� �������� �������");
		SetPlayerChatBubble(playerid, "������� �������", COLOR_PURPLE, 13.0, 10000);
	}

	if(TYPE_VIP[playerid] != VIP_STATE_NONE)
	{
		if(VipData[TYPE_VIP[playerid]][VipPhone] == 1)
		{
			UpdatePlayerData(playerid, "togphone", Phone[playerid]);
			SendClientMessage(playerid, 0xFFCC00AA, "��������� ������ �������� ���������");
		}
	}
	return 1;
}

cmd:phone(playerid)
{
	if(IsPlayerEvent(playerid)) return SendErr(playerid, "�� ����������� ������ ������������");
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"� ��� ��� SIM-�����!");
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"� ��� ��� ��������!");}

	if(IsPlayerFromThePhone(playerid))
	{
		if(Phonesmenu[playerid] == 1) return PhoneMenuExit(playerid);
		SendInf(playerid, "����� ������ ������� ������� /phone ������.");
	}

	PhoneMenu(playerid);
	return 1;
}

cmd:number(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/number [id/��� ������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[params[0]][pPhoneNumber] <= 1) return SendClientMessage(playerid, COLOR_GREY, "����� �� ������� ��������� ��� � ���� ��� SIM-�����!");

	format(string, sizeof(string), "����� ������ %s[%d]: {33CCFF}%d", GetName(params[0]), params[0], PI[params[0]][pPhoneNumber]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	return 1;
}

