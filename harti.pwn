CMD:yes(playerid, params[])
{
	new proposition_id = proposition_info[playerid][P_ING_ID];
	new offer_type = proposition_info[playerid][P_INCOMING_TYPE];

	new value_1 = proposition_info[playerid][P_INCOMING_VALUE][0];
	new value_2 = proposition_info[playerid][P_INCOMING_VALUE][1];

	if(proposition_id != INVALID_PLAYER_ID)
	{
		if(IsPlayerConnected(proposition_id))
		{
			if(proposition_info[proposition_id][P_OUT_ID] == playerid)
			{
				proposition_info[proposition_id] = g_proposition_default_values;
			}
			else offer_type = -1;

			new Float: x, Float: y, Float: z;
			new Float: dist;

			GetPlayerPos(proposition_id, x, y, z);
			dist = GetPlayerDistanceFromPoint(playerid, x, y, z);

			if(dist <= 20.0)
			{
				switch(offer_type)
				{
				case PROPOSITION_TYPE_HEAL:
					{
						if(GetPlayerRubble(playerid) < value_1)
						{
							SendMes(proposition_id, -1, ""cER"� ������ %s ������������ �������!", GetName(playerid));
							SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
						}
						else
						{
							if(GetPlayerLimitMoney(proposition_id, value_1))
							{
								SendErr(playerid, "� ������ ������������ ���������� �����.");
								SendErr(proposition_id, "� ��� ������������ ���������� �����.");
							}
							else
							{
								if(IsPlayerInAnyVehicle(proposition_id) && !IsPlayerInVehicle(playerid, GetPlayerVehicleID(proposition_id))) SendClientMessage(playerid, COLOR_GREY, "����� ������ ���������� ������ � ���� � ������!");
								else
								{
									SetPlayerMoney(playerid, -value_1);
									SetPlayerMoney(proposition_id, value_1);

									SetPlayerHealth(playerid, 100);

									if(GetPlayerDrunkLevel(playerid) > 0) SetPlayerDrunkLevel(playerid, 0);
									SCMF(playerid, COLOR_GREEN, "%s %s ������� ��� �� %d�", frakRangName[PI[proposition_id][pMember]][PI[proposition_id][pRank]], GetName(proposition_id), value_1);
									SCMF(proposition_id, COLOR_GREEN, "�� �������� %s �� %d�", GetName(playerid), value_1);
								}
							}
						}
					}
				case PROPOSITION_TYPE_HOOK:
					{
						if(playerHookID[proposition_id] == -1) SendClientMessage(playerid, COLOR_RED, "��������� ������");
						else
						{

							playerHookID[playerid] = value_1;

							SCMF(playerid, 0x66CC00FF, "�� ������� ����������� %s �������� ������ �� ��� ��������", GetName(proposition_id));
							SCMF(proposition_id, 0x66CC00FF, "%s ��������� ���� ����������� �������� ������ �� ��� ��������", GetName(playerid));
							new pos = GetHookFreePos(value_2, value_1);
							if(pos == -1) SendClientMessage(proposition_id, COLOR_RED, "� ��� ��� ����� �� ������, �������� 4");
							else
							{
								HookTableArendators[value_2][value_1][pos] = playerid;
								HookTableStatus[value_2][value_1] = 1;
								SetHookLabel(value_2);
