callback::Onmysql_query(playerid,id,params[])
{
	new rows,fields;
	cache_get_data(rows,fields,db_prod);
	if(id == 100)
	{
		new plid = DialogSlot[playerid][g_player_listitem_use[playerid]];
		if(PI[playerid][pFamilySozd] == 0) return SendClientMessage(playerid,COLOR_GREY,"��� ���������� ��� �������.");
		if(rows > 3) return SendClientMessage(playerid,COLOR_GREY, "�������� ����� ������ ���� ������������.");
		else
		{
			if(PI[playerid][pFamilySozd] == 0) return SendClientMessage(playerid, COLOR_GREY,"��������� ������ ������������ ����� ������ ��������� �����.");
			if(plid == playerid) return SendClientMessage(playerid, COLOR_GRAD1, "�� �� ������ ��������� ������������ ������ ����!");

			PI[plid][pFamilyZam] = 1;
			PI[plid][pFamilyRank] = 6;
			format(string,sizeof(string),"{%s}[%s]{FFD39B} %s(%s) �������� ������ %s ������������ �����",family_chat_color [family_info[PI[playerid][pFamily]] [f_chat_color ]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid),family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], GetName(plid));
			family_message(PI[playerid][pFamily],-1, string);

			format(string, sizeof string, "UPDATE `accounts` SET familyrank = 6, familyzam = 1 WHERE name = '%s'", GetName(plid));
			mysql_function_query ( db_prod, string, false, "", "");
			return true;
		}
	}
	return true;
}
