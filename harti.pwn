	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(IsPlayerInAnyVehicle(playerid)&&!IsPlayerInVehicle(targetid, GetPlayerVehicleID(playerid)) || !IsPlayerInAnyVehicle(playerid) && GetDistanceBetweenPlayers(playerid,targetid) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������ ���������� � ���� � ����������!");
