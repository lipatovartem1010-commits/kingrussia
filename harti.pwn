			}
			return 1;
		}
		for(new i = TOTALBIZZ; i > 0; i --)
		{
			if(areaid == BizzInfo[i][bMenu])
			{
				switch(BizzInfo[i][bType])
				{
				case 1: MagazineList(playerid);
				case 3: HookList(playerid, i);
				case 4,9: BarList(playerid);
				case 5: EatList(playerid, i);
				case 6: GunShopList(playerid);
				case 8: SkinShopList(playerid);
				case 10: AccessoriesShowList(playerid);
				}
				return 1;
			}
		}
	}
	if(PI[playerid][pMember] == TEAM_ARMY)
	{
		foreach(new vehicleid:VehicleGun)
		{
			if(!IsValidDynamicArea(metall_info[vehicleid][mArea])) return 1;
			if(areaid == metall_info[vehicleid][mArea])
			{
				if(metall_info[vehicleid][mLoading] && RefillBoxTake[playerid])
				{
					RefillBoxTake[playerid] = 0;
					RemovePlayerAttachedObject(playerid, 0);
					ApplyAnimation(playerid, "CARRY", "putdwn", 1.0, 0, 1, 1, 0, 0, 1);
					if(metall_info[vehicleid][mLoad] + 1 > 20) return SendClientMessage(playerid, COLOR_RED, "� ���������� ������������ �����");

					metall_info[vehicleid][mLoad] += 1;
					format(stringer1, 128, ""cMain"��� ����������\n"cMain"��������� %d / 20 ������", metall_info[vehicleid][mLoad]);
					UpdateDynamic3DTextLabelText(metall_info[vehicleid][mLabel], 0x0099FFFF, stringer1);
				}
				if(!metall_info[vehicleid][mLoading] && !RefillBoxUnLoad[playerid])
				{
					if(metall_info[vehicleid][mLoad] < 1) return SendClientMessage(playerid, COLOR_RED, "� ���� ��� ������� ����������");
					metall_info[vehicleid][mLoad] --;
					format(stringer1, 128, ""cMain"��� ����������\n"cMain"��������� %d / 20 ������", metall_info[vehicleid][mLoad]);
					UpdateDynamic3DTextLabelText(metall_info[vehicleid][mLabel], 0x0099FFFF, stringer1);

					ApplyAnimation(playerid, "CARRY", "liftup", 1.0, 0, 1, 1, 0, 0, 1);
					SetPlayerAttachedObject(playerid, 0, 3014, 6, -0.076000, 0.070000, -0.192999, -105.200119, 0.100001, -8.799991, 0.521999, 1.00, 0.468999);
					RefillBoxUnLoad[playerid] = 1;

					if(metall_info[vehicleid][mLoad] == 0)
					{
						if(metall_info[vehicleid][mLoading]) return 1;

						DestroyDynamicArea(metall_info[vehicleid][mArea]);
						DestroyPickup(metall_info[vehicleid][mPickup]);
						metall_info[vehicleid][mPickup] = 0;
						metall_info[vehicleid][mArea] = 0;
						metall_info[vehicleid][mArea] = 0;
						SendClientMessage(playerid, COLOR_GREEN, "��������� ���������");

						metall_info[vehicleid][mLoading] = -1;
						Iter_Remove(VehicleGun, vehicleid);
					}
				}
				return 1;
			}
		}
	}
	IterateVehicle(v) if(vBoomBoxArea[v] == areaid)
	{
		PlayAudioStreamForPlayer(playerid, vBoomBoxStati[v]);
		return 1;
	}
	foreach(new i: Player)
	{
		if(IsValidDynamicArea(Mfon[i][p_area]))
		{
			if(areaid == Mfon[i][p_area])
			{
				SendClientMessage(playerid,COLOR_LIGHTBLUE, "�� ������ � ����������� ���� �����������");
				PlayAudioStreamForPlayer(playerid, Mfon[i][p_station], 0.0, 0.0, 0.0, 20.0, 0);
				break;
			}
		}
	}
	return 1;
}

public OnPlayerLeaveDynamicArea(playerid, areaid)
{
	if(areaid >= AltArea[0] && areaid <= AltArea[sizeof(AltArea)-1])
	{
		HideAltInfo(playerid);
	}
	if(AreaInfo[arGreenZone][0] <= areaid <= AreaInfo[arGreenZone][sizeof(AreaInfo[arGreenZone])-1])
	{
		InAntiDMZone[playerid] = 0;
		antidmcount{playerid} = 0;

		PI[playerid][P_IN_GREEN_ZONE] = 0;
	}
	foreach(new i:Player)
	{
		if(IsValidDynamicArea(Mfon[i][p_area]))
		{
			if(areaid == Mfon[i][p_area])
			{
				SendClientMessage(playerid,COLOR_LIGHTBLUE,#�� �������� ����������� ���� �����������);
				StopAudioStreamForPlayer(playerid);

				return 1;
			}
		}
	}
	IterateVehicle(v) if(vBoomBoxArea[v] == areaid)
	{
		StopAudioStreamForPlayer(playerid);
		return 1;
	}
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
	switch(newstate)
	{
	case PLAYER_STATE_ONFOOT:
		{
			if(player_use_mp3[playerid]) StopAudioStreamForPlayer(playerid);

			if(gDerbyStatus == 2 && playerGameDerby{playerid})
			{
				DestroyVehicle(playerDerbyVehicleID[playerid]);
				playerDerbyVehicleID[playerid] = 0;

				playerGameDerby{playerid} = 0;

				SCM(playerid, COLOR_RED, "�� ���� ���������� � �� ��������� �� �����������");

				ResetPlayerWeapons(playerid);
				SpawnPlayer(playerid);

				gDerbyCount--;

				if(gDerbyCount == 2)
				gDerbyWinners[2] = playerid;

				else if(gDerbyCount == 1)
				{
					gDerbyWinners[1] = playerid;

					IteratePlayer(otherid)
					{
						if(playerid == otherid) continue;

						if(playerGameDerby{otherid})
						{
							gDerbyWinners[0] = otherid;
							EndDerby();
						}
					}
				}

				else if(gDerbyCount <= 0)
				{
					gDerbyWinners[0] = playerid;
					EndDerby();
				}
			}
		}
	case PLAYER_STATE_DRIVER:
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(VehicleFamilyCars[vehicleid] != -1)
			{
				if(VehicleFamilyCars[vehicleid] != PI[playerid][pFamily] && PI[playerid][pCarTheft] != vehicleid)
				{
					STRING_GLOBAL[0] = EOS;
					format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "������ ��������� ����������� �����: %s", family_info[VehicleFamilyCars[vehicleid]][f_name]);
					SendClientMessage(playerid, 0xCCCCCCFF, STRING_GLOBAL);
					RemovePlayerFromVehicle(playerid);
				}
			}

			if(!InShop[playerid])
			{
				if(GetVehicleType(vehicleid) != 4 && GetVehicleType(vehicleid) != 7 && GetVehicleType(vehicleid) != 5 && GetVehicleType(vehicleid) != 2 && GetVehicleType(vehicleid) != 3)
				{
					Speed_Show_Player(playerid);
				}
				if(RadioVeh[vehicleid] != 0) PlayAudioStreamForPlayer(playerid, Radio[RadioVeh[vehicleid]][1]);
				for(new v = 1; v <= TOTALVEH; v++)
				{
					if(vehicleid == VehInfo[v][vVehicle])
					{
						if(VehInfo[v][vFraction] != PI[playerid][pMember] || PI[playerid][pRank] < VehInfo[v][vDostup])
						{
							if(PI[playerid][pAdmin] < 11)
							{
								SendClientMessage(playerid, -1, ""cER"���� ��������� �� ����������� ����� ����������� / ������ ����� ���������� ���� ����������");
								RemovePlayerFromVehicle(playerid);
								return 1;
							}
						}
					}
				}
				if(Engine[vehicleid] == false)
				{
					if(GetVehicleType(vehicleid) == 7)
					{
						GetVehicleParamsEx(vehicleid,engine_global,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
						SetVehicleParamsEx(vehicleid,true,lights_global,alarm_global,doors_global,bonnet_global,boot_global,objective_global);
					}
					else
					{
						if(IsPlayerFromThePhone(playerid))
						{
							SendClientMessage(playerid, COLOR_GREEN, ""cPS"������� ������� 'CTRL' (��� ������� /e), ����� ������� ���������, ���� ������: /cm");
						}

						else
						{
							SendClientMessage(playerid, COLOR_GREEN, ""cPS"������� ������� '2' (/e), ����� ������� ���������, ���� ������ ('CTRL' ��� /cm)");
							SendClientMessage(playerid, COLOR_GREEN, ""cPS"������� ������� 'NUM4' ��� 'NUM6' ����� �������� �����������");
						}
					}
				}
				new arend_id = INVALID_PLAYER_ID;
				if(GetArendCarID(vehicleid, arend_id) != (-1))
				{
					if(arend_id == INVALID_PLAYER_ID || !IsPlayerConnected(arend_id))
					{
						new rc = GetArendCarID(vehicleid);
						format(stringer1,sizeof(stringer1), ""cWH"��������� ��� ������!\n\n- ������: {46ca00}%s"cWH"\n- ���������: {46ca00}%d�"cWH"\n\n{afafaf}����� ����������, ������� `������`", VehicleNames[GetVehicleModel(vehicleid)-400], ArendInfo[rc][aCost]);
						ShowPlayerDialog(playerid, 131+23, 0, ""cMain"������", stringer1, "������", "������");
						return 1;
					}
					else if(arend_id != playerid)
					{
						SendClientMessage(playerid, COLOR_FADE1, "���� ��������� ��� ��������");
						RemovePlayerFromVehicle(playerid);
						return 1;
					}
				}
				if(vehicleid ==	PI[playerid][pCarTheft])
				{
					SendClientMessage(playerid, 0xFFCC00AA, "�� ���� � ����������. ��������� ��� � ����������� �����");
					SetPlayerRaceCheckpoint(playerid, 1, 1821.6149,2258.0195,15.2729, 0.0, 0.0, 0.0, 5.0);
					CarTheft[playerid] = 2;
					return 1;
				}
				if(metall_info[0][mVehicle] <= vehicleid <= metall_info[3][mVehicle])
				{
					if(PI[playerid][pMember] != TEAM_ARMY)
					{
						SendErr(playerid, "� ��� ��� ������ �� ������� �/�");
						return RemovePlayerFromVehicle(playerid);
					}
					new idx = vehicleid - metall_info[0][mVehicle];
					if(PI[playerid][pMember] != TEAM_ARMY && metall_info[idx][mLoad] < 1)
					{
						SendErr(playerid, "� ��� ��� ������ �� ������� �/�");
						return RemovePlayerFromVehicle(playerid);
					}
					if(metall_info[idx][mLoading] == 1 && PI[playerid][pMember] == TEAM_ARMY)
					{
						if(!Iter_Contains(VehicleGun, idx)) return 1;
						if(metall_info[idx][mLoad] == 0) return 1;
						ShowPlayerDialog(playerid, 8367, DIALOG_STYLE_MSGBOX,""cMain"��������",""cWH"�� ������������� ������ ��������� ��������?","��", "���");
					}
					else if(metall_info[idx][mLoading] == 0)
					{
						if(!Iter_Contains(VehicleGun, idx)) return 1;
						if(metall_info[idx][mLoad] == 0) return 1;
						ShowPlayerDialog(playerid, 7256, DIALOG_STYLE_MSGBOX,""cMain"���������",""cWH"�� ������������� ������ ��������� ���������?","��", "���");
					}
				}
			}
		}
	case PLAYER_STATE_PASSENGER:
		{
			if(GetPlayerVehicleID(playerid))
			{
				if(RadioVeh[GetPlayerVehicleID(playerid)] != 0) PlayAudioStreamForPlayer(playerid, Radio[RadioVeh[GetPlayerVehicleID(playerid)]][1]);
			}
			SetPlayerArmedWeapon(playerid, 0);
		}
	}
	if(oldstate == PLAYER_STATE_DRIVER)
	{
		Speed_Hide_Player(playerid);

		if(playerAdminVeh[playerid])
		{
			DestroyVehicle(playerAdminVeh[playerid]);
			Iter_Remove(adm_vehicles, playerAdminVeh[playerid]);
		}
	}
	return 1;
}
