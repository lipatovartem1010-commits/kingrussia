cmd:kiss(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/kiss [id ������]");
	if(!IsPlayerConnected(params[0])) return SendErr(playerid, "����� �� � ����");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, ""cER"�� �� ������ ���������� �������� ����!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 1.5) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_KISS);
	return 1;
}
CMD:tpcor(playerid, params[])
