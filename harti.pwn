cmd:givegun(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "uii", params[0],params[1],params[2])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/givegun [id ������] [id ������] [���-�� ��������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[1] < 1 || params[1] > 34) return SendClientMessage(playerid, COLOR_GREY, "ID ������ �� 1 �� 34!");
	if(params[2] > 500 || params[2] < 1 && !g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "���������� �������� �� 1 �� 500!");

	new tuc;
	for(new i; i < sizeof(prohibited_weapons); i++)
	{
		if(params[1] == prohibited_weapons[i]) tuc++;
	}
	if(tuc && PI[params[0]][pAdmin] < 11 && !g_player_full_access[playerid]) return SendClientMessage(playerid, COLOR_GREY, "ID ������ �� 1 �� 47!");

	GivePlayerWeapon(params[0], params[1], params[2]);
	global_string = "";
	format(global_string, 128, "[A] ������������� %s(%d) ����� ������ %s(%d) ������ %s (ID: %d | �������: %d)", GetName(playerid), playerid, GetName(params[0]), params[0], GunNames[params[1]], params[1], params[2]);
	if(!g_player_full_access[playerid]) SendAdminMessage(COLOR_GREY, global_string);

	SendMes(playerid, COLOR_LIME, "�� ���������� ������ %s",GetName(params[0]));
	fLogs("[admin] %s /givegun %s %i %i", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return 1;
}
