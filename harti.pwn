						if(!IsPlayerInAnyVehicle(proposition_id))ApplyAnimation(proposition_id,"BD_FIRE","GRLFRD_KISS_03",4.0,0,0,0,0,0,1);
						if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"BD_FIRE","PLAYA_KISS_03",4.0,0,0,0,0,0,1);
					}
				case PROPOSITION_TYPE_JAIL:
					{
						if(GetPlayerRubble(playerid) < value_1)
