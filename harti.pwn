cmd:med(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/med [id ������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	new med_status[25], gender_text[8];
	switch(PhoneNumbers[playerid][2])
	{
	case 0: return SendClientMessage(playerid, -1, ""cER"� ��� ��� ���. �����");
	case 1: med_status = "�� ���������";
	case 2: med_status = "���������� �� ������(-�)";
	case 3: med_status = "����������� ����������";
	case 4: med_status = "��������� ��������(-��)";
	}
	if(PI[playerid][pSex] == 1) gender_text = "�������";
	else if(PI[playerid][pSex] == 2) gender_text = "�������";

	string = ""cWH"";
	format(string, sizeof(string), "%s���: %s\n", string, GetName(playerid));
	format(string, sizeof(string), "%s�������: %d\n", string, PI[playerid][pAge]);
	format(string, sizeof(string), "%s���: %s\n", string, gender_text);
	format(string, sizeof(string), "%s������: %s\n", string, med_status);
	ShowPlayerDialog(params[0], 0, DIALOG_STYLE_MSGBOX, ""cMain"���. �����", string, "�������", "");

	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "������� ���� ���. ����� %s", GetName(params[0]));
	else format(string, sizeof(string), "�������a ���� ���. ����� %s", GetName(params[0]));
	MeAction(playerid, string);
	return true;
}

cmd:eject(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"�� ������ ��������� � ����������!");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� �� ����� ���������!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/eject [id ������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(playerid == params[0]) return SendClientMessage(playerid, -1, ""cER"�� �� ������ �������� ����!");
	if(!IsPlayerInVehicle(params[0],GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "����� ������ ���������� � ����� ����������!");

	SendMes(playerid, COLOR_LIGHTBLUE, "�� �������� �� ���������� %s", GetName(params[0]));
	SendMes(params[0], COLOR_LIGHTBLUE, "%s ������� ��� �� ����������", GetName(playerid));
	TogglePlayerControllable(params[0], 1);
	format(string, sizeof(string), "������� �� ���������� %s", GetName(params[0]));
	MeAction(playerid, string);
	RemovePlayerFromVehicle(params[0]);
	return 1;
}

cmd:payday(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 11) return 1;
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		PayDay();
		fLogs("[admin] %s /payday", GetName(playerid));
	}
	return 1;
}
CMD:auninvite(playerid, params[])
{
	if(PI[playerid][pAdmin] < 10) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "�������� ��������������� ��������� ��������� �������");
	if(sscanf(params, "us[32]", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, "� {66CC00}[ ��������� ] "cWH"�������: /auninvite [id ������] [�������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[params[0]][pMember]) return SendClientMessage(playerid, COLOR_GREY, "����� �� ��������� � �����������!");
	if(PI[params[0]][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "������ ��������� �������!");

	format(string, sizeof(string), "[F] ������������� %s[%d] ������ %s[%d]. �������: %s",PI[playerid][pName],playerid,PI[params[0]][pName],params[0],params[1]);
	SendFMes(PI[params[0]][pMember], COLOR_YELLOW2, string);
	SaveHistoryBan(GetName(params[0]), string);
	SendMes(playerid, COLOR_BLUE, "�� ������� %s �� �����������. �������: %s",GetName(params[0]),params[1]);
	SendMes(params[0], COLOR_BLUE, "������������� %s ������ ��� �� �����������. �������: %s",GetName(playerid),params[1]);
	LeaveFractionPlayer(params[0]);
	fLogs("[admin] %s /auninvite %s %s", GetName(playerid), GetName(params[0]), params[1]);
	return 1;
}

cmd:gcontrol(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		if(PI[playerid][pAdmin] < 10) return 1;
		else if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		ShowDialogGhetto(playerid);
	}
	return 1;
}

cmd:pay(playerid, params[])
{
	if(payer[playerid] > unix) return SendClientMessage(playerid, -1, ""cER"���������� ������ ����� ��� � ������");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/pay [id ������] [�����]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "������ ���������� ������ ������ ����");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	if(params[1] < 1 || GetPlayerRubble(playerid) < params[1]) return SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
	if(params[1] < 1 || params[1] > 100000) return SendClientMessage(playerid, COLOR_GREY, "������ ����� ���������� ������ �� 100.000�");

	if(!strcmp(PI[params[0]][pIP], PI[playerid][pIP], true))
	{
		SendClientMessage(playerid, COLOR_RED, "* �������� �������� ������� �� �������������� ���������.");
		return 1;
	}
	SetPlayerMoney(playerid, -params[1]);
	SetPlayerMoney(params[0], params[1]);
	SendMes(params[0], COLOR_GREY, "����� %s ������� ��� %d�", GetName(playerid), params[1]);
	SendMes(playerid, COLOR_GREY, "�� �������� %d� ������ %s", params[1], GetName(params[0]));

	if(PI[playerid][pSex] == 1) format(stringer1, sizeof(stringer1), "������ ������ �� ������� � ������� �� %s", GetName(params[0]));
	else format(stringer1, sizeof(stringer1), "������� ������ �� ������� � �������� �� %s", GetName(params[0]));
	MeAction(playerid, stringer1);

	ApplyAnimation(playerid, "DEALER", "shop_pay", 4.1, 0, 1, 1, 0, 0, 1);
	if(!PI[playerid][pAdmin]) payer[playerid] = unix+60;
	return 1;
}

cmd:idbiz(playerid)
{
	if(g_player_full_access[playerid])
	{
		for(new idx = TOTALBIZZ; idx > 0; idx--)
		{
			if(IsPlayerInRangeOfPoint(playerid, 1.0, BizzInfo[idx][bEntrx], BizzInfo[idx][bEntry], BizzInfo[idx][bEntrz])) SendMes(playerid, COLOR_RED, "ID ����� �������: %d", idx);
		}
	}
	return true;
}

cmd:setbizpos(playerid, params[])
{
	if(GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Winston") || GetString(GetName(playerid), "Eduard_Haunted"))
	{
		new biz_id = 0, Float:pos[3];
		if(sscanf(params, "i", biz_id)) return SendClientMessage(playerid, -1, ""cPS"�����������: /setbizpos [ID �������(������ /idbiz)]");
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);

		BizzInfo[biz_id][bEntrx] = pos[0];
		BizzInfo[biz_id][bEntry] = pos[1];
		BizzInfo[biz_id][bEntrz] = pos[2];

		MysqlUpdateBizzFloat(biz_id, "x", BizzInfo[biz_id][bEntrx]);
		MysqlUpdateBizzFloat(biz_id, "y", BizzInfo[biz_id][bEntry]);
		MysqlUpdateBizzFloat(biz_id, "z", BizzInfo[biz_id][bEntrz]);

		if(IsValidDynamicMapIcon(BizzInfo[biz_id][bIcon]))
		{
			DestroyDynamicMapIcon(BizzInfo[biz_id][bIcon]);
			BizzInfo[biz_id][bIcon] = CreateDynamicMapIcon(BizzInfo[biz_id][bEntrx],BizzInfo[biz_id][bEntry],BizzInfo[biz_id][bEntrz], BizzInfo[biz_id][bMIcon], 0);
		}

		new fee[64];
		if(BizzInfo[biz_id][bEnter] == 0) fee = "����������";
		else format(fee, sizeof(fee), "%d�", BizzInfo[biz_id][bEnter]);

		if(BizzInfo[biz_id][bType] != 2 && BizzInfo[biz_id][bType] != 7)
		{
			DestroyPickup(BizzInfo[biz_id][bPickup]);
			DestroyDynamic3DTextLabel(LABELBIZZ[biz_id]);
			BizzInfo[biz_id][bPickup] = CreatePickup(19132,1, BizzInfo[biz_id][bEntrx],BizzInfo[biz_id][bEntry],BizzInfo[biz_id][bEntrz],-1);
			if(!strcmp(BizzInfo[biz_id][bOwner],"None",true))
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"��������: {99cc00}�����������\n"cWH"���������: "cMain"%d�\n"cWH"�������: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bPrice], BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "���");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
			else
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"��������: {99cc00}%s\n"cWH"����: "cMain"%s\n"cWH"�������: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bOwner], fee, BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "���");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+0.5,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
		}
		else if(BizzInfo[biz_id][bType] == 2)
		{
			DestroyDynamic3DTextLabel(LABELBIZZ[biz_id]);
			if(!strcmp(BizzInfo[biz_id][bOwner],"None",true))
			{
				format(string, sizeof(string), "{ffcc33}H - ���� ���\n\n{33adff}%s\n"cWH"��������: {99cc00}�����������\n"cWH"���������: {99cc00}%d�\n"cWH"���� �� 1 ���� �������: "cMain"%d�\n"cWH"������ ��������: /buyfuel\n"cWH"�������: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bPrice], BizzInfo[biz_id][bTill] / 3, BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "���");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
			}
			else
			{
				format(string, sizeof(string), "{ffcc33}H - ���� ���\n\n{33adff}%s\n"cWH"��������: {99cc00}%s\n"cWH"���� �� 1 ���� �������: "cMain"%dp\n"cWH"������ ��������: /buyfuel\n"cWH"�������: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bOwner], BizzInfo[biz_id][bTill] / 3, BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "���");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz]+1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID);
			}
		}
		else
		{
			DestroyDynamic3DTextLabel(LABELBIZZ[biz_id]);
			if(!strcmp(BizzInfo[biz_id][bOwner],"None",true))
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"��������: {99cc00}�����������\n"cWH"���������: {99cc00}%d�\n"cWH"���� �� 1 �������� - "cMain"%d�\n\n{ffcc33}H - ������� � ���\n"cWH"�������: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bPrice], BizzInfo[biz_id][bTill], BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "���");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
			else
			{
				format(string, sizeof(string), "{33adff}%s\n"cWH"��������: {99cc00}%s\n"cWH"���� �� 1 �������� - "cMain"%d�\n\n{ffcc33}H - ������� � ���\n"cWH"�������: "cMain"%s", BizzInfo[biz_id][bName], BizzInfo[biz_id][bOwner], BizzInfo[biz_id][bTill], BizzInfo[biz_id][bMafia] ? Fraction_Name[BizzInfo[biz_id][bMafia]] : "���");
				LABELBIZZ[biz_id] = CreateDynamic3DTextLabel(string,-1,BizzInfo[biz_id][bEntrx], BizzInfo[biz_id][bEntry], BizzInfo[biz_id][bEntrz],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
			}
		}
		UpdateBizz(biz_id);
		SendClientMessage(playerid, COLOR_GREEN, "������ ��������� �� ����� ����������");
		fLogs("[admin] %s /setbizpos %i", GetName(playerid), biz_id);
	}
