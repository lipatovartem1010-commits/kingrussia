		if(playerGameSkyDiving{playerid} && playerSkyDivingCount[playerid])
		{
			if(areaid == areaWinSkyDiving)
			{
				if(gSkyDivingWinners[0] == INVALID_PLAYER_ID) gSkyDivingWinners[0] = playerid;
				else if(gSkyDivingWinners[1] == INVALID_PLAYER_ID) gSkyDivingWinners[1] = playerid;
				else if(gSkyDivingWinners[2] == INVALID_PLAYER_ID) gSkyDivingWinners[2] = playerid;

