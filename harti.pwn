			LABELATM[idx] = CreateDynamic3DTextLabel("��������\n"cWH"�������: ALT", 0xBBBBBBFF, ATMInfo[idx][aX],ATMInfo[idx][aY],ATMInfo[idx][aZ]+1.1,10.0);
