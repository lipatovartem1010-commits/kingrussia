DLG(18291, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new f_id = GetPlayerListitemValue(playerid, listitem);
	f_car_id[playerid] = f_id;

	if(listitem_car[playerid] == 0)
	{
		ShowPlayerDialog(playerid, 18290+2, DIALOG_STYLE_INPUT, ""cMain"��������� ����� ������� � ����������", ""cWH"������� ����� �����, � �������� ����� �������� ������ ����������:", "�����", "������");
	}
	else
	{
		global_string = "";
		for(new idx; idx < sizeof(fraction_cars); idx++)
		{
			format(string, sizeof string, "- %s(%d)\n", VehicleNames[fraction_cars[idx]-400], fraction_cars[idx]);
			strcat(global_string, string);
		}
		ShowPlayerDialog(playerid, 18290+3, DIALOG_STYLE_LIST, ""cMain"�������� ������:", global_string, "�������", "������");
	}
	return 1;
}
DLG(18293, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	for(new idx = 1; idx <= TOTALVEH; idx++)
	{
		if(VehInfo[idx][vID] == f_car_id[playerid])
		{
			SaveMileage();
			if(VehInfo[idx][vVehicle] != INVALID_VEHICLE_ID)
			{
				DestroyVehicle(VehInfo[idx][vVehicle]);
				VehInfo[idx][vVehicle] = INVALID_VEHICLE_ID;
			}
			VehInfo[idx][vModel] = fraction_cars[listitem];
