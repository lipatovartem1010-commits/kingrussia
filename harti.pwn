cmd:find(playerid)
{
	if(!PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new full;
	global_string = "{FFFF00}ID\t�������\t����\t��� ������\n\n";
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pMember] == PI[playerid][pMember])
		{
			if(PI[i][pAFK] >= 3) format(global_string, sizeof(global_string),"%s"cWH"%d\t%d\t%s [%d]\t%s[AFK: %s]\n", global_string, i, PI[i][pLevel], (PI[i][pTempLeader]) ? ("�����") : (GetFrackRangName(i)), PI[i][pRank], GetName(i), ConvertSeconds(PI[i][pAFK]));
			else format(global_string, sizeof(global_string),"%s"cWH"%d\t%d\t%s [%d]\t%s\n", global_string, i, PI[i][pLevel], (PI[i][pTempLeader]) ? ("�����") : (GetFrackRangName(i)), PI[i][pRank], GetName(i));
			full++;
		}
	}
	format(stringer1, sizeof stringer1, ""cMain"����� ����������� � ���� (%d ���.)", full);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, stringer1, global_string, "�������", "");
	return 1;
}

cmd:allfind(playerid)
{
	if(PI[playerid][pAdmin] < 9) return 0x1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);

	new fraction_online[11];

	foreach(new i: Player)
	{
		if(!PI[i][pMember] || PlayerLogged[i] == false) continue;
		switch(PI[i][pMember])
		{
		case 1: fraction_online[0] ++; //��������� �������������
		case 2: fraction_online[1] ++; //���
		case 3: fraction_online[2] ++; //���
		case 4: fraction_online[3] ++; //��������
		case 5: fraction_online[4] ++; //����
		case 6: fraction_online[5] ++; //�������
		case 7: fraction_online[6] ++; //�������
		case 8: fraction_online[7] ++; //�����
		case 9: fraction_online[8] ++; //��
		case 10: fraction_online[9] ++; //��
		case 11: fraction_online[10] ++; //���
		}
	}

	format(global_string, 800, "\
	{5992C1}��������������� �����������:\n\n\
	"cWH"��������� �������������: {EEC522}%d ���.\n\
	"cWH"���: {EEC522}%d ���.\n\
	"cWH"���: {EEC522}%d ���.\n\
	"cWH"��������: {EEC522}%d ���.\n\
	"cWH"�����: {EEC522}%d ���.\n\
	"cWH"���: {EEC522}%d ���.\n\n\
	{FB5C1D}����������� �����������:\n\n\
	"cWH"�� '����': {EEC522}%d ���.\n\
	"cWH"�� '�������': {EEC522}%d ���.\n\
	"cWH"�������: {EEC522}%d ���.\n\
	"cWH"����������� �����: {EEC522}%d ���.\n\
	"cWH"������� �����: {EEC522}%d ���.\n\n\
	"cWH"������� ������: %d\n����: %02d.%02d.%04d\n\
	�����: %02d:%02d:%02d",
	fraction_online[0],
	fraction_online[1],
	fraction_online[2],
	fraction_online[3],
	fraction_online[7],
	fraction_online[10],
	fraction_online[4],
	fraction_online[5],
	fraction_online[6],
	fraction_online[8],
	fraction_online[9],
	Iter_Count(Player), day, month, year, hour, minute, second);
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, ""cMain"���������� ������� �����������", global_string, "�������", "");

	fLogs("[admin] %s /allfind", GetName(playerid));
	return 1;
}
cmd:invite(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new targetid;
	if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/invite [id ������]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "����� ����� ������ �����������!");
	if(PI[targetid][pMember] > 0) return SendClientMessage(playerid, COLOR_GREY, "����� ���������� � ������ �����������!");
	if(PI[targetid][pWarn] > 0) return SendClientMessage(playerid, -1, ""cER"� ������ ��������������!");
	if(IsPlayerInAnyVehicle(targetid)) return SendClientMessage(playerid, COLOR_GREY, "����� �� ������ ���������� � ����������!");
	if(GetDistanceBetweenPlayers(playerid, targetid) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	if(PI[targetid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "�������� ��������������� ��������� ���������� � �����������");
	if(PI[targetid][Billet] == 0)
	{
		if(IsACopAndFSB(playerid))
		{
			SendClientMessage(targetid, -1, ""cER"��� ���������� � ������ ������� ��� ���������� �������� ������� ����� � �����");
			SendClientMessage(playerid, -1, ""cER"� ������� ������ ��� �������� ������");
			return 1;
		}
	}
	switch(PI[playerid][pMember])
	{
	case 1:if(BlackList[targetid][0] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 2:if(BlackList[targetid][1] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 3:if(BlackList[targetid][2] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 4:if(BlackList[targetid][3] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 5:if(BlackList[targetid][4] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 6:if(BlackList[targetid][5] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 7:if(BlackList[targetid][11] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 8:if(BlackList[targetid][12] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 12:if(BlackList[targetid][6] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 15:if(BlackList[targetid][7] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 16:if(BlackList[targetid][8] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 18:if(BlackList[targetid][9] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	case 21:if(BlackList[targetid][10] == 1) return SendClientMessage(playerid, COLOR_GREY, BlockInvite);
	}
	SendMes(playerid,COLOR_BLUE,"�� ���������� %s �������������� � ���� �����������",GetName(targetid));
	format(string,sizeof(string),"%s %s ���������� ��� �������������� � \"%s\"\n\n�� ��������?",frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), Fraction_Name[PI[playerid][pMember]]);
	ShowPlayerDialog(targetid, 18, 0, ""cMain"���������� �� �������",string,"��","���");

	offerfractionid[targetid] = PI[playerid][pMember];
	offerplayer[targetid] = playerid;
	actplayerid[playerid] = targetid;
	return 1;
}

cmd:changeskin(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new targetid;
	if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/changeskin [id ������]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "����� �� ���������� � �����������!");
	if(PI[targetid][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "����� ���������� � ������ �����������!");
	if(GetDistanceBetweenPlayers(playerid,targetid) > 5.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(targetid)) return SendClientMessage(playerid,COLOR_GREY,"�� ������ ���� �� �����");
	if(PI[targetid][pRank] > PI[playerid][pRank]) return SendClientMessage(playerid, COLOR_GREY, "��� ���� ������������");
	actplayerid[playerid] = targetid;
	new fractionid = PI[playerid][pMember];
	new mes[128];
	for(new i; i < 9; i++)
	{
		new skinid = Fraction_Skin[fractionid][i];
		if(!skinid) break;
		if(!i) format(mes, sizeof(mes), "���� %d [%d]", i+1, skinid);
		else format(mes, sizeof(mes), "%s\n���� %d [%d]", mes, i+1, skinid);
	}
	ShowPlayerDialog(playerid, 49+8, 2, ""cMain"����� �����", mes, "�������", "");
	return 1;
}

cmd:leave(playerid, params[])
{
	if(!PI[playerid][pMember]) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � �����������!");
	if(PI[playerid][pLeader] > 0) return SendClientMessage(playerid, -1, ""cER"�� �� ������ ���� �������!");
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cER"�� �� ������ ���������� � ����������!");

