DLG(5003, playerid, response, listitem, inputtext[])
{
	if(!response) return callcmd::business(playerid);

	new i = GetPlayerBizz(playerid);

	if(BizzInfo[i][bUpdate] == 10)
		return SendErr(playerid, "�� �������� ������������� ���������");

	if(playerEuro[playerid] < (BizzInfo[i][bUpdate] + 1) * 1000) return SendClientMessage(playerid, -1, ""cER"� ��� ������������ �������� �������");

	BizzInfo[i][bUpdate] += 1;
	TransferEuro(playerid, -1, (BizzInfo[i][bUpdate] + 1) * 1000, "��������� � �������");
	MysqlUpdateBizzInt(i, "update_biz", BizzInfo[i][bUpdate]);

	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
	"cMain"1."cWH" ����������� ������\t"cMain"���������: %d/10"cWH"\t"cMain"���������:"cMain" %d ����"cWH"", BizzInfo[i][bUpdate], (BizzInfo[i][bUpdate] + 1) * 1000);
	ShowPlayerDialog(playerid, 5003, DIALOG_STYLE_LIST, ""cMain"���������", STRING_GLOBAL, "�������", "������");
	return 0x1;
}

