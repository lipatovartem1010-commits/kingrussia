	if(Phone[playerid] == false) return SendClientMessage(playerid, COLOR_RED, "������� ��������. ��� ��������� �������� ����������� /togphone");
	if(PhoneInternetStatus[playerid] == false) return SendClientMessage(playerid, COLOR_RED, "����� ������������ ��������, ���������� �������� �������� ������(/phone)");
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"� ������ ����������!");
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/soc [�����]");
	if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "��������� "cWH"| %s[%d]: %s", GetName(playerid), playerid, params[0]);
