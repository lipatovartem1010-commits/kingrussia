DLG(15420, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(!PI[playerid][pModel]) return 1;
			SetPlayerSkin(playerid, PI[playerid][pModel]);
			SendClientMessage(playerid,COLOR_YELLOW,"�� �����������!");
		}
	case 1:
		{
			if(!PI[playerid][pMemberSkin]) return SendClientMessage(playerid,COLOR_GREY,"�� �� �������� � �����������");
			SetPlayerSkin(playerid, PI[playerid][pMemberSkin]);
			SendClientMessage(playerid,-1, ""cDA"�� ������ ����� �����������");
		}
	case 2:
		{
			if(PI[playerid][pRank] >= 3)
			{
				new str[90], str2[600];
				for(new i = 1; i < MAX_FRACTIONS; i++)
				{
					format(str, sizeof(str), "�%d - %s\n", i, Fraction_Name[i]);
					strcat(str2, str);
				}
				ShowPlayerDialog(playerid, 18248, 2, ""cMain"�������� �����������:", str2, "�������", "������");
			}
			else SendClientMessage(playerid, COLOR_RED, "���������� �� ������ �����");
		}
	}
	return 1;
}
