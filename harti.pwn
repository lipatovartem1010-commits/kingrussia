DLG(5204, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new targetid, price;
	if(sscanf(inputtext, "ui", targetid, price)) return ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"�������", ""cWH"������� ��� ������ � ���������� ����� ����� �������\n\n������: Ivan_Ivanov, 10000", "�������", "�����");
	if(!IsPlayerConnected(targetid))
	{
		ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"�������", ""cWH"������� ��� ������ � ���������� ����� ����� �������\n\n������: Ivan_Ivanov, 10000", "�������", "�����");
		return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	}
	if(PlayerLogged[targetid] == false)
	{
		ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"�������", ""cWH"������� ��� ������ � ���������� ����� ����� �������\n\n������: Ivan_Ivanov, 10000", "�������", "�����");
		return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	}
	if(g_player_bank_accounts[playerid][ PI[playerid][pMainBankAccount] ][B_BALANCE] < price)
	{
		ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"�������", ""cWH"������� ��� ������ � ���������� ����� ����� �������\n\n������: Ivan_Ivanov, 10000", "�������", "�����");
		return SendClientMessage(playerid, COLOR_GREY, "�� ����� ����� � ����� �� ������� �����!");
	}
	if(price < 1) return ShowPlayerDialog(playerid, 5200+4, 1, ""cMain"�������", ""cWH"������� ��� ������ � ���������� ����� ����� �������\n\n������: Ivan_Ivanov, 10000", "�������", "�����");

	if(!strcmp(PI[targetid][pIP], PI[playerid][pIP], true))
	{
		SendClientMessage(playerid, -1, "* �������� �������� ������� �� �������������� ���������.");
		return 1;
	}

	if(PI[playerid][pLevel] == BONUS_LVL && PI[playerid][pExp] < 12)
		return SendClientMessage(playerid, COLOR_RED, "��� ����� �������� 12 ����� ��� ���������� ������");

	if(PI[targetid][pLevel] == BONUS_LVL && PI[targetid][pExp] < 12)
		return SendClientMessage(playerid, COLOR_RED, "������ ����� �������� 12 ����� ��� ���������� ������");

	GiveBankMoney(playerid, -price);
	GiveBankMoney(targetid, price);

	fLogs("[money] %s ������� %s [%i]", GetName(playerid), GetName(targetid), price);
	SendMes(playerid, COLOR_WHITE, "�� �������� %d� ������ %s[%d] �� ����", price, GetName(targetid), playerid);
	SendMes(targetid, COLOR_WHITE, "��� �������� ������� �� ��� ���� � ������� %d� �� ������ %s[%d]", price, GetName(playerid), playerid);
	TransferReset[playerid] = 60;
	return 1;
}
DLG(5205, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new h = GetPlayerHouse(playerid);
	new dayss = strval(inputtext), g_rent = GetHomeOplata(h) * dayss;

	if(!dayss) return SendClientMessage(playerid, COLOR_RED, "���������� ���� �� ����� ���� ����� 0 ��� ���� ����� 0");
	new accountid = g_player_listitem_use[playerid];
	if(!IsValidBankAccount(playerid, accountid)) return SendClientMessage(playerid, COLOR_RED, "��������� ���������� ������ #1. ���������� � �������������");
	if(GetPlayerBankAccountData(playerid, accountid, B_BALANCE) < g_rent) return SendClientMessage(playerid, COLOR_RED, "� ��� �� ������� ������� ��� ������ ������ ����");
	if(dayss < 1 || dayss > 7) return SendClientMessage(playerid, COLOR_RED, "���������� ���� �� 1 �� 7");
	if((HouseInfo[h][hOplata] + dayss) > 7) return SendClientMessage(playerid, COLOR_RED, "������ �������� ����� ��� �� 7 ����");

	HouseInfo[h][hOplata] += dayss;
	SCMF(playerid, COLOR_GREEN, "�� �������� ��� �� %d ����. � ������ ����� �������: %d ������", dayss, g_rent);
	SetPlayerMoney(playerid, -g_rent);
	MysqlUpdateHouseInt(h, "hOplata", HouseInfo[h][hOplata]);
	return 1;
}
