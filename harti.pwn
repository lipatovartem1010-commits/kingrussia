		(!doubling_donate) 	? ("{FF0000}���������") : ("{00FF00}��������"),
		(!doubling_job) 	? ("{FF0000}���������") : ("{00FF00}��������"),
		(!happy_hours) 		? ("{FF0000}���������") : ("{00FF00}��������"),
