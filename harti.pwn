cmd:bizlist(playerid, params[])
{
	if(!IsAMafia(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	SendClientMessage(playerid, COLOR_GREEN, "����������� �������:");
	for(new h = 0; h < MAX_BIZZ; h++)
	{
		new mafiapay = BizzPay[h] / 10;
		switch(PI[playerid][pMember])
		{
		case TEAM_RUSMAFIA:
			{
				if(BizzInfo[h][bMafia] == TEAM_RUSMAFIA)
				{
					format(string, sizeof(string), "- %s, �������: %d", BizzInfo[h][bName], mafiapay);
					SendClientMessage(playerid, COLOR_YELLOW2, string);
				}
			}
		case TEAM_ITALMAFIA:
			{
				if(BizzInfo[h][bMafia] == TEAM_ITALMAFIA)
				{
					format(string, sizeof(string), "- %s, �������: %d", BizzInfo[h][bName], mafiapay);
					SendClientMessage(playerid, COLOR_YELLOW2, string);
				}
			}
		}
	}
	return 1;
}

CMD:ganginfo(playerid, params[])
{
	if(IsAGang(playerid) == 0) return SendClientMessage(playerid, -1, ""cER"��� �� �������� ������ �����������");

	new count = 0;
	STRING_GLOBAL[0] = EOS;
	foreach(new targetid : Player)
	{
		if(PI[playerid][pMember] == PI[targetid][pMember] && (DynamicInfo[targetid][CaptureKill] > 0 || DynamicInfo[targetid][CaptureDeath] > 0))
		{
			count ++;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s"cMain"%s\t"cMain"����: "cWH"%d\t"cMain"����: "cWH"%d\n", STRING_GLOBAL, GetName(targetid), DynamicInfo[targetid][CaptureKill], DynamicInfo[targetid][CaptureDeath]);
		}
	}
	if(count == 0) return ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"���������� ����� �� ����", "��� ���������� � ���������/������� �� ������ � ����� �������", "�������", "������");
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"���������� ����� �� ����", STRING_GLOBAL, "�������", "������");
	return 0x1;
}

