		(AdminInfo[playerid][admGethere]) ? ("{F04245}��������") : ("{63BD4E}��������"),
		(AdminInfo[playerid][admSpectate]) ? ("{F04245}���������") : ("{63BD4E}���������"));
		ShowPlayerDialog(playerid, 5400+3, 2, ""cMain"��������� ��������������", global_string, "�������", "�����");
	}
	else
	{
