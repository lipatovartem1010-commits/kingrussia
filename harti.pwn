cmd:arrest(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(!IsPlayerInRangeOfPoint(playerid, 10.0,-1704.6469,-2808.0452,14.2065) && !IsPlayerInRangeOfPoint(playerid, 30.0, 2516.8201, 757.8386, 2019.7719) && !IsPlayerInRangeOfPoint(playerid, 20.0, -1704.6469,-2808.0452,14.2065)) return SendClientMessage(playerid, -1, ""cER"��� ���������� ��������� ����� ������ � ������ ��� ����� ������ � ������!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/arrest [id ������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	if(PI[params[0]][pJail] > 0) return SendClientMessage(playerid, COLOR_GREY, "������ ����� ��� ���������� � ������!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"�� �� ������ ���������� ������ ����!");
	if(IsACopAndFSB(params[0]) || PI[params[0]][pMember] == TEAM_ARMY) return SendClientMessage(playerid, COLOR_GREY, "������ ����� �����������/�����/�������!");
	if(PI[params[0]][pWanted] == 0) return SendClientMessage(playerid, COLOR_GREY, "����� ������ ����� ���� �� 1 ������� �������!");

	ResetPlayerWeapons(params[0]);
	PI[playerid][pScoreIvent] ++;
	MysqlUpdatePlayerInt(playerid, "scoreivent", PI[playerid][pScoreIvent]);

	PI[params[0]][pJailTime] = PI[params[0]][pWanted]* 5 * 60;
	PI[params[0]][pWanted] = 0;
	if(pCuff[params[0]][pCuffer] != INVALID_PLAYER_ID)
	{
		new cuffer = pCuff[params[0]][pCuffer];
		SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(params[0], 0);
		pCuff[params[0]][pCuffer] = INVALID_PLAYER_ID;
		pCuff[params[0]][pCuffee] = INVALID_PLAYER_ID;
		pCuff[cuffer][pCuffee] = INVALID_PLAYER_ID;
		pCuff[cuffer][pCuffer] = INVALID_PLAYER_ID;
	}
	SetPlayerColorEx(params[0],TeamColors[0]);
	SendMes(playerid, COLOR_BLUE, "�� �������� � ��������� ������ %s[%d] �� %d ������", GetName(params[0]), params[0], PI[params[0]][pJailTime]);
	SendMes(params[0], COLOR_BLUE, "%s %s[%d] ������� ��� � ��������� ������ �� %d ������", frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid, PI[params[0]][pJailTime]);

	new r = random(10);
	SetPlayerPos(params[0],SetPlayerPosJail[r][0], SetPlayerPosJail[r][1], SetPlayerPosJail[r][2]);
	SetPlayerFacingAngle(params[0], SetPlayerPosJail[r][3]);
	SetPlayerVirtualWorld(params[0], playerid+1);
	SetPlayerInterior(params[0], 1);

	PI[params[0]][pJail] = 1;
	SetPlayerWantedLevel(params[0], 0);
	TogglePlayerControllable(params[0], 1);
	SetPlayerSkin(params[0], 48);
	return 0x1;
}

cmd:megaphone(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ����������!");
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(isnull(params)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/megaphone [�����]");
	format(stringer1, sizeof(stringer1), "[�������] %s %s: %s",frakRangName[PI[playerid][pMember]][PI[playerid][pRank]],GetName(playerid),params[0]);
	ProxDetector(45.0, playerid, stringer1, COLOR_YELLOW);
	return 1;
}
alias:megaphone("m");

cmd:clear(playerid, params[])
{
	if(!IsACopAndFSB(playerid) || PI[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ����������!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/clear [id ������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"�� �� ������ ����� ���� ������!");
	if(!PI[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY, "����� ������ ���������� � �������!");
	if(!IsPlayerInVehicle(params[0], GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREY, "����� ������ ���������� � ���� � ����������!");
	SendMes(playerid, COLOR_LIGHTBLUE, "�� ����� ������ ������� � %s'�", GetName(params[0]));
	SendMes(params[0], COLOR_LIGHTBLUE, "������ %s ���� � ��� ������ �������", GetName(playerid));
	format(stringer1, sizeof(stringer1), "������ %s �����(��) � ���� ������ �������", GetName(playerid));
	ProxDetector(13.0,playerid, stringer1, COLOR_PURPLE);
	PI[params[0]][pWanted] = 0;
	SetPlayerWantedLevel(params[0], 0);
	return 1;
}

cmd:aclear(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return 1;
	{
		if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/clear [id ������]");
		if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
		if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
		if(!PI[params[0]][pWanted]) return SendClientMessage(playerid, COLOR_GREY, "����� ������ ���������� � �������!");
		SendMes(playerid, COLOR_LIGHTBLUE, "�� ����� ������ ������� � %s'�", GetName(params[0]));
		SendMes(params[0], COLOR_LIGHTBLUE, "������������� %s ���� � ��� ������ �������", GetName(playerid));
		PI[params[0]][pWanted] = 0;
		SetPlayerWantedLevel(params[0], 0);
		fLogs("[admin] %s /aclear %s", GetName(playerid), GetName(params[0]));
	}
	return 1;
}

cmd:push(playerid, params[])
{
	if(!IsACopAndFSB(playerid)) return SendClientMessage(playerid, COLOR_GREY, "��� ���������� ��� �������!");
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���� � ����!");
	if(sscanf(params, "ui", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/push [id ������] [�����(1-3)]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "����� �� ����� � ����!");
	if(IsPlayerInAnyVehicle(params[0])) return SendClientMessage(playerid, COLOR_GREY, "����� �� ������ ��������� � ����������!");
	if(pCuff[params[0]][pCuffer] == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "����� �� � ����������!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"�� �� ������ �������� � ���������� ������ ����!");
	if(params[1] > 3 || params[1] < 1) return SendClientMessage(playerid, COLOR_GREY, "���������� ���� �� 1 �� 3!");
	if(params[0] == playerid) return SendClientMessage(playerid, -1, ""cER"�� �� ������ �������� � ���������� ������ ����!");

	PutPlayerInVehicle(params[0], GetPlayerVehicleID(playerid), params[1]);
	TogglePlayerControllable(params[0], 0);
	if(PI[playerid][pSex] == 1) format(string, sizeof(string), "������� � ���� %s", GetName(params[0]));
	else format(string, sizeof(string), "�������� � ���� %s", GetName(params[0]));
	MeAction(playerid, string);
	return true;
}
