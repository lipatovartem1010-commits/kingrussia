public OnPlayerUpdate(playerid)
{
	PI[playerid][pAFK] = 0;
	return 1;
}

callback::ReFill(playerid)
{
	if(!Refueling[playerid]) return 1;
	Fuel[GetPlayerVehicleID(playerid)]++;
	Filling[playerid] ++;
	format(string,32,"Fill: %d",Filling[playerid]);
	GameTextForPlayer(playerid, string, 600, 6);
	if(Refueling[playerid] <= Filling[playerid])
	{
		KillTimer(ReFuelTimer[playerid]);
		Refueling[playerid] = 0;
		Filling[playerid] = 0;
		TogglePlayerControllable(playerid, true);
		SendClientMessage(playerid, COLOR_GREEN, "��������� ���������");
	}
	return 1;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	if(PlayerLogged[playerid] == false) return 0;
	if(!IsPlayerConnected(playerid)) return 0;

	if(!AntiFlood(playerid, 0, 1))
	{
		SendErr(playerid, "�� ������� ����������.");
		return 0;
	}
	if((obcar_status[playerid] || obmen_status[playerid]) && strfind(cmd, "acceptchangecar", true) == -1 && strfind(cmd, "time", true) == -1 && strfind(cmd, "deniedchangecar", true) == -1) return SendClientMessage(playerid, -1, ""cER"�� ������������� ������������, ������ ������������ ������� ������� ����� /acceptchangecar � /deniedchangecar") & 0;
	if(PI[playerid][pJail] && strfind(cmd, "time", true) == -1 && strfind(cmd, "b", true) == -1 && strfind(cmd, "n", true) == -1 && strfind(cmd, "animlist", true) == -1 && strfind(cmd, "mm", true) == -1 && !PI[playerid][pAdmin]) return SendClientMessage(playerid, COLOR_RED, "� ������ ��������� ����� ������� ����� /time, /animlist, /mm, /n, /b") & 0;
	if(IsPlayerInRangeOfPoint(playerid, 80.0, -196.6820,1405.3795,1502.0037) && strfind(cmd, "animlist", true) == -1 && strfind(cmd, "mm", true) == -1 && strfind(cmd, "time", true) == -1 && !PI[playerid][pAdmin]) return SendClientMessage(playerid, COLOR_RED, "� ���������� ����� ��������� ����� �������, ����� /animlist, /time, /mm") & 0;
	return 1;
}

cmd:use(playerid)
{
	if(GetPlayerInHouse(playerid) == -1) return SendClientMessage(playerid, COLOR_DARKORANGE, "�� ���������� �� �����");
	new i = GetPlayerInHouse(playerid), id = GetPlayerHouse(playerid);
	if(HouseInfo[i][hID] != HouseInfo[id][hID] && HouseInfo[i][hCS] == 1) return SendClientMessage(playerid, COLOR_DARKORANGE, "���� ���� ������");
	if((!IsPlayerInRangeOfPoint(playerid,60.0,HouseInfo[i][hExitx],HouseInfo[i][hExity],HouseInfo[i][hExitz]) || IsPlayerInRangeOfPoint(playerid,3.0,2934.4077,2967.4949,3176.5769)) && GetPlayerVirtualWorld(playerid) == HouseInfo[i][hVirtual]) return SendClientMessage(playerid, COLOR_DARKORANGE, "�� ������ ���� � ����");
	if(!IsPlayerInRangeOfPoint(playerid, 2.0, g_house_info[ HouseInfo[i][hDiscript] ][3], g_house_info[ HouseInfo[i][hDiscript] ][4], g_house_info[ HouseInfo[i][hDiscript] ][5])) return SendClientMessage(playerid, COLOR_GREY, "�� ������ �� �����");
	ShowPlayerDialog(playerid, 18000, DIALOG_STYLE_LIST, ""cMain"����",
	""cMain"1. "cWH"����� ������\n\
	"cMain"2. "cWH"�������� ������\n\
	"cMain"3. "cWH"����� �������\n\
	"cMain"4. "cWH"�������� �������\n\
	"cMain"5. "cWH"����� ���������\n\
	"cMain"6. "cWH"�������� ���������", "�����", "������");
	safeid[playerid] = id;
	return 1;
}

cmd:mutelist(playerid)
{
	if(PI[playerid][pAdmin] < 1) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	new list,full,str[100];
	global_string = "";

	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pMuted] > 0) list++;
	}
	foreach(new i: Player)
	{
		if(PlayerLogged[i] == false) continue;
		if(PI[i][pMuted] > 0)
		{
			format(str,sizeof(str),""cWH"%s[%d] - {FF6347}TIME: %s\n",PI[i][pName], i, ConvertSeconds(PI[i][pMuted]));
			strcat(global_string, str);
			full++;
		}
	}
	if(full == 0) strcat(global_string, ""cWH"���������� �� �������");
	ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,""cMain"MUTE LIST",global_string,"�������","");
	fLogs("[admin] %s /mutelist", GetName(playerid));
	return 1;
}

cmd:jaillist(playerid)
{
	if(PI[playerid][pAdmin] > 0 || IsACopAndFSB(playerid))
	{
		new list,full,str[100];
		global_string = "";
		foreach(new i: Player)
		{
			if(PlayerLogged[i] == false) continue;
			if(PI[i][pJail] > 0) list++;
		}
		foreach(new i: Player)
		{
			if(PlayerLogged[i] == false) continue;
			if(PI[i][pJail] > 0)
			{
				format(str,sizeof(str),""cWH"%s[%d] - {FF6347}TIME: %s\n",PI[i][pName], i, ConvertSeconds(PI[i][pJailTime]));
				strcat(global_string, str);
				full++;
			}
		}
		if(full == 0) strcat(global_string, ""cWH"���������� �� �������");
		ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,""cMain"������ �����������",global_string,"�������","");
		fLogs("[admin] %s /jaillist", GetName(playerid));
	}
	return 1;
}
cmd:hook(playerid)
{
	if(PI[playerid][pMember] != TEAM_MVD)
	return SendClientMessage(playerid, COLOR_DARKORANGE, "�� �� �������� � ���!");
	new car = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(car)!=525) return SCM(playerid,COLOR_DARKORANGE,"����� ��������� ���������, �� ������ ���������� � ����������.");
	if(IsTrailerAttachedToVehicle(car))
	{
		DetachTrailerFromVehicle(car);
		SCM(playerid,-1,"{32CD32}| "cWH"�� �������� ��������� �� ����������.");
		return 1;
	}
	new Float:posx, Float:posy, Float:posz, bool:found = false;
	new Float:oldposx, Float:oldposy, Float:oldposz;
	new Float:tempposx, Float:tempposy, Float:tempposz;
	new Float:Radi=6.0;
	new Float:AngRange=90.0;
	new Float:plAngle;    GetVehicleZAngle(car, plAngle);
	new Float:crAngle,Float:Angle,Float:Angle2;
	GetVehiclePos(car, posx, posy, posz);
	foreach(new v: Vehicle)
	{
		if(car == v) continue;
		GetVehiclePos(v, oldposx, oldposy, oldposz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);
		if (((tempposx < Radi) && (tempposx > -Radi)) && ((tempposy < Radi) && (tempposy > -Radi)) && ((tempposz < Radi) && (tempposz > -Radi)))
		{
			if(GetVehicleType(v) <= 1)
			{
				GetVehicleZAngle(v, crAngle);
				Angle = (plAngle -crAngle);
				Angle2= (Angle-180.0);
				if (( ((Angle < AngRange) && (Angle > -AngRange)) || ((Angle2 < AngRange) && (Angle2 > -AngRange)) ))
				{
					AttachTrailerToVehicle(v, car);
					SCM(playerid,-1,"{32CD32}| "cWH"�� ��������� ��������� � ����������.");
					SCM(playerid,-1,"{F7D757}| "cWH"����� �������� ��������� �� ����������, ������� /hook ��� ���.");
					found = true;
					break;
				}
			}
		}
	}
	if(found == false) SCM(playerid, -1, "{B22222}| "cWH"���������� �� ��� ������ ���������.");
	return 1;
}
CMD:serverstats(playerid)
