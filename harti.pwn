	{
		new string_stats[401];
		GetNetworkStats(string_stats, sizeof(string_stats));
		ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, ""cMain"������� ���������� �������", string_stats, "Close", "");
	}
	return 0x1;
}
cmd:arrestcar(playerid)
{
	if(PI[playerid][pMember] != TEAM_MVD) return SendClientMessage(playerid, COLOR_DARKORANGE, "�� �� �������� � ���!");
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_DARKORANGE, "�� ������ ���������� � ����������!");
	new car = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(car)!=525) return SCM(playerid,COLOR_DARKORANGE,"����� ��������� ���� �� �/�, �� ������ ���������� � ����������.");
	if(!PlayerToPoint(5.0, playerid, 2542.1277,-2408.6106,22.0044)) return SCM(playerid,COLOR_DARKORANGE,"�� ������ ���������� � ������ �� �/�!");
	if(!IsTrailerAttachedToVehicle(car)) return SCM(playerid,COLOR_DARKORANGE,"�� ������� ��� ����������!");
	new ar_id = GetVehicleTrailer(car);
	new bool:found = false;
	foreach(new i:Player)
	{
		for(new z; z < MAX_LOAD_VEHICLE; z++)
		{
			if(PlayerVehicle[i][z] == ar_id)
			{
				format(global_string,sizeof(global_string),"{9ACD32}�����/������:\t"cWH"%s\n\
					{9ACD32}��������:\t"cWH"%s\n\n\n\
					������� ������� ������ ���������� ������������� �������� � ������ ������:\n\n\
					������: ������������ ��������, 1000",
				VehicleNames[GetVehicleModel(ar_id)-400],GetName(i));
				ShowPlayerDialog(playerid, 12001, DIALOG_STYLE_INPUT, ""cMain"����� ����������", global_string,"����", "������");
				SetPVarInt(playerid,"arrestcar",i);
				SetPVarInt(playerid, "arrestcarsql", PlayerVehicleSQL[i][z]);
				SetPVarInt(playerid, "arrestcarid", PlayerVehicle[i][z]);
				found = true;
				break;
			}
		}
	}
	if(found == false) SCM(playerid, -1, "������ �/� ������ ��������� �� ������������!");
	return 1;

}
cmd:unarrestcar(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_MVD) return SendClientMessage(playerid, COLOR_DARKORANGE, "�� �� �������� � ���!");
	if(!PlayerToPoint(5.0, playerid, 2542.1277,-2408.6106,22.0044)) return SCM(playerid,COLOR_DARKORANGE,"�� ������ ���������� � ������ �� �/�!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/unarrestcar [id ������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[params[0]] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "�������� ����������!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	format(stringer1, 128, "SELECT * FROM `ownable_cars` WHERE c_owner = '%s' AND `c_arrest` = 1", GetName(params[0]));
	mysql_tquery(db_prod, stringer1, "ChkPlayerArrestCar", "i", playerid);
	SetPVarInt(playerid,#P_Dps_Id, params[0]);
	return 1;
}
