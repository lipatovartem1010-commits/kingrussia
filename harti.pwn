cmd:iznas(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid)) return SCM(playerid, COLOR_GREY, "������ ������������ � ������");
	if(iznas_time[playerid] > unix) return SendClientMessage(playerid, COLOR_RED, "������� ����� ������������ ��� � 5 �����");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/iznas [id ������]");
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, COLOR_GREY, "����� �� � ����!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 2.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	if(TYPE_VIP[playerid] != VIP_STATE_NONE && VipData[TYPE_VIP[playerid]][VipIznas] == 1) return SCM(playerid,COLOR_GRAD1, "��, ��, � ������ �������� ����. (�� VIP)");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, ""cER"�� ������� ���� ID!");
	if(PI[params[0]][pAdmin] >= 1) return SCM(playerid,COLOR_GRAD1, "��, ��, � ������ �������� ����.");
	new Float:angle;
	GetPlayerFacingAngle(playerid, angle);
	SetPlayerFacingAngle(params[0], angle + 180);
	SendClientMessage(params[0], COLOR_RED, "��� ����������� ������");
	format(global_string, sizeof(global_string), "�����������(�) %s",GetName(params[0]));
	MeAction(playerid, global_string);
	ApplyAnimation(params[0], "SNM", "SPANKINGW",4.1,0,1,1,1,1,1);
	ApplyAnimation(playerid, "SNM", "SPANKEDW",4.1,0,1,1,1,1,1);
	iznas_time[playerid] = unix+(60*5);
	if(random(2))
	{
		PI[playerid][pWanted]++;
		SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);
		SetPlayerCriminal(playerid, "�����������", "������������� ��������");
	}
	return true;
}
cmd:hi(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/hi [id ������]");
	if(!IsPlayerConnected(params[0])) return SendErr(playerid, "����� �� � ����");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_WHITE, ""cER"�� �� ������ ������ ���� ������ ����!");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	SendPlayerProposition(playerid, params[0], PROPOSITION_TYPE_HANDSHAKE);
	return 1;
}

cmd:usedrugs(playerid)
{
	new ok = SearchInventoryItem(playerid, 44);
	if(!ok) return SendClientMessage(playerid, -1, ""cER"� ��� ��� ����������!");
	if(DrugsTime[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "����������� ��������� ����� ��� � 2 ������!");

	new Float:health;
	GetPlayerHealth(playerid, health);
	if(TYPE_VIP[playerid] != VIP_STATE_NONE) SetPlayerHealth(playerid, health + float(VipData[TYPE_VIP[playerid]][VipDrugs]));
	if(TYPE_VIP[playerid] == VIP_STATE_NONE) SetPlayerHealth(playerid, health + 15);
	GetPlayerHealth(playerid, health);

	if(health > 120) return SendClientMessage(playerid, -1, "��� ����� �� ����������, ���������� ���������");
	if(PlayerItem2[playerid][ok] == 0) PlayerItem1[playerid][ok] = 0;
	PlayerItem2[playerid][ok]--;

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
	SendClientMessage(playerid, COLOR_GREY, "�� ���������� 40 ����� ����������!");

	SetTimerEx("DrugEffectGone", 60000, false, "i", playerid);
	DrugsTime[playerid] = unix+60;

	if(PI[playerid][pSex] == 1) MeAction(playerid, "������ ������� � ��������� ��������");
	else MeAction(playerid, "������� ������� � ���������� ��������");

	SetPlayerDrunkLevel(playerid, 3000);
	SetPlayerWeather(playerid, -68);
	SaveItem(playerid,ok);
	return 1;
}

cmd:offawarn(playerid, params[])
{
	if(g_player_full_access[playerid])
	{
		new adm_name[24], adm_reason[60];
		if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
		if(sscanf(params, "s[24]s[32]", adm_name, adm_reason)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/offawarn [��� ������] [�������]");
		if(GetPlayerID(adm_name) != INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "����� � ����, ����������� ������� /awarn");
		mysql_format(db_prod, stringer1, 128, "SELECT * FROM `admin` WHERE `name`='%s'", adm_name);
		mysql_tquery(db_prod, stringer1, "OffWarnAdmin", "iss", playerid, adm_name, adm_reason);
	}
	return true;
}

