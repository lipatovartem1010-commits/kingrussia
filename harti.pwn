			}
			else
			{
				if(PI[playerid][YachtID] != INVALID_VEHICLE_ID)
				{
					DestroyYacht(playerid);
					SendClientMessage(playerid, COLOR_RED, "���� ��������� � �������");
				}
			}
		}
	case 1:
		{
			if(PI[playerid][YachtID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_RED, "���� ���� �� ��������� �� ������");

