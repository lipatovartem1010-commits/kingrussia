			ShowPlayerDialog(playerid,4800+1,DIALOG_STYLE_MSGBOX,""cMain"�������������� �����",global_string,"������","�����");
		}
	case 1:
		{
			format(global_string, 128,""cWH"����� - ��������� ��� �������, � ������ � ������� �����������, ����������.");
			ShowPlayerDialog(playerid,4800+2,DIALOG_STYLE_MSGBOX,""cMain"�����",global_string,"������","�����");
		}
	}
	return 1;
}
DLG(4801, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		format(string, sizeof(string),""cWH"�������������� ����� - ����� �� ���� ��� �� ������ � ��� ������ ��������� �� ������� {FFFF00}����� ALT.");
		ShowPlayerDialog(playerid,4800+1,DIALOG_STYLE_MSGBOX,""cMain"�������������� �����",string,"������","�����");
		return 1;
	}
	new a = GetPlayerHouse(playerid);
	if(HouseInfo[a][hAutoDoors]) return SendClientMessage(playerid,COLOR_GREY,""cER"� ��� ��� ������� �������������� ����� � ����!");
	if(GetPlayerRubble(playerid) < 25000) return SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
	SetPlayerMoney(playerid, -25000);
	HouseInfo[a][hAutoDoors] = 1;
	MysqlUpdateHouseInt(a, "hAutoDoors", HouseInfo[a][hAutoDoors]);
	SendClientMessage(playerid, COLOR_LIME, "������ � ����� ���� ������� �������������� �����!");
	UpdateDynamic3DTextLabelText(HouseInfo[a][hPickupExit], COLOR_WHITE, ""cWH"��� ������ �����������:\n "cMain"ALT\n"cWH"���������� �����: \n"cMain"/home");
	return 1;
}

DLG(15419, playerid, response, listitem, inputtext[])
{
