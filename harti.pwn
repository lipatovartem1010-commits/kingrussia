DLG(77, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	switch(listitem)
	{
	case 0:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "������ ���� ���������� �� ����� �����");
			new full = 0, CB[16];
			foreach(new i: Player)
			{
				if(PlayerLogged[i] == false || playerid == i) continue;
				if(Ether[i] == true && PI[i][pMember] == PI[playerid][pMember]) full++;
			}
			if(full > 0) return SendClientMessage(playerid, COLOR_GREY, "���� �����! � ����� ���������� ��� �������!");
			if(Ether[playerid] == false)
			{
				if(PI[playerid][pMember] == TEAM_SMI && PI[playerid][pNews] != 1) PI[playerid][pNews] = 1;
				Ether[playerid] = true;
				format(string, 90, "[F] %s ����� � ������ ����",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_LIGHTBLUE, string);
			}
			else if(Ether[playerid] == true)
			{
				Ether[playerid] = false;
				Convert(InEther[playerid],CB);

				if(EtherSms == true) { format(string, 90, "[F] %s �������� ����� ���",GetName(playerid)); SendFMes(PI[playerid][pMember], COLOR_LIGHTRED, string); }
				if(EtherCall == true) { format(string, 90, "[F] %s �������� ����� �������",GetName(playerid)); SendFMes(PI[playerid][pMember], COLOR_LIGHTRED, string); }
				format(string, 90, "[F] %s ����� �� ������� ����� (����� � �����: %s, �������: %d, ���: %d)",GetName(playerid), CB, CallNews, SmsNews);
				SendFMes(PI[playerid][pMember], COLOR_LIGHTRED, string);

				SmsNews = 0;
				CallNews = 0;
				EtherSms = false;
				EtherCall = false;
				InEther[playerid] = 0;
				if(Mobile[playerid] != -1) MobileCrash(playerid);
			}
		}
	case 1:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "������ ���� ���������� �� ����� �����");
			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ������ �����!");
			ShowPlayerDialog(playerid, 77+1, 1, ""cMain"����", ""cWH"������� ID ��� ��� ������:", "�������", "������");
		}
