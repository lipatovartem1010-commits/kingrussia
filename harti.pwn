		{
			if(!PI[playerid][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "�� �� ��������� ������ �����-���� �����");
			if(!family_info[PI[playerid][pFamily]][f_spawn]) return SendClientMessage(playerid, COLOR_GREY, "����� ����� �� �������� ���������� � ���� ����");
			PI[playerid][pSpawnChange] = 4;
