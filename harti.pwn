callback::IsPlayerFullAccess(playerid)
{
	format(stringer1, 128, "SELECT name, rank from fullaccess where name = '%s'", GetName(playerid));
	mysql_tquery(db_prod, stringer1, "IsPlayerFullAccess_Step2", "i", playerid);
	return 1;
}

callback::IsPlayerFullAccess_Step2(playerid)
{
	if(cache_get_row_count())
	{
		g_player_full_access[playerid] = true;
		cache_get_field_content(0, "rank", stringer1, db_prod, 64);
		strmid(full_access_rank[playerid], stringer1, 0, strlen(stringer1), 64);
	}
	return 1;
}

callback::CheckFullAccess(playerid, a_name[])
{
	if(cache_num_rows()) return SendClientMessage(playerid, COLOR_RED, "� ������� �������������� ��� ���� FullDostup");

	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `fullaccess` (`name`) values ('%e')", a_name);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	SendMes(playerid, COLOR_GREEN, "�������������� %s ��� ����� FullDostup", a_name);

	new id = GetPlayerID(a_name);
	if(id != INVALID_PLAYER_ID)
	{
		SendMes(id, COLOR_GREEN, "������������� %s ����� ��� FullDostup", GetName(playerid));
		IsPlayerFullAccess(id);
	}
	return 1;
}
