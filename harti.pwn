	format(fmt_text, sizeof fmt_text, ""cWH"������: {66CC00}%d ���.\n"cWH"�������: {A52A2A}%d ��.\n"cWH"���������: "cMain"%d ��������\n\n"cWH"��������������: {63B135}/use",
	HouseInfo[cupboardid][hMoney], HouseInfo[cupboardid][hPatrons],HouseInfo[cupboardid][hDrugs]);
