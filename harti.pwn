	format(global_string, 4000, "\
	"cWH"����� ���������� �������������� {F5AE20}%s (%d �������) %s:\n\n\
	"cWH"- ��������: \t{AEADAD}%s\t "cWH"| ����: "cMain"%s\n\
	"cWH"- ������: \t{AEADAD}%d\t "cWH"| ����. �������: "cMain"%s\n\
	"cWH"- �������: \t{AEADAD}%d\t "cWH"| ����. �������: "cMain"%s\n\
	"cWH"- ����� ����: \t{AEADAD}%d\t "cWH"| ����. �������: "cMain"%s\n\
	"cWH"- �������: \t{AEADAD}%d\t "cWH"| ����. �������: "cMain"%s\n\
	"cWH"- �����: \t{AEADAD}%d\t "cWH"| ����. �������: "cMain"%s\n\
	"cWH"- �������� � ������: \t{AEADAD}%d\t "cWH"| ����. �������: "cMain"%s\n\n\
	"cWH"- ���������: \t{FB2424}%d\n\n\
	"cWH"���������� ������� ��������������:\n\n\
	"cWH"- �����������: \t{E0D730}%s\t"cWH"| ����� �������: %s\n\
	"cWH"- �������: \t{E0D730}%s\t"cWH"| ����� �������: %s\n\
	"cWH"- �����: \t{E0D730}%s\t"cWH"| ����� �������: %s\n\
	"cWH"- �������: \t{E0D730}%s\t"cWH"| ����� �������: %s\n\
	"cWH"- �������: \t{E0D730}%s\t"cWH"| ����� �������: %s\n\
	"cWH"- �������: \t{E0D730}%s\t"cWH"| ����� �������: %s\n\
	"cWH"- �����������: \t{E0D730}%s\t"cWH"| ����� �������: %s\n\
	"cWH"- ����� �� ��� �����: \t{E0D730}%s",
