cmd:inv(playerid)
{
	if(PI[playerid][pJail] > 0) return SendClientMessage(playerid, -1, ""cER"� ������ ��������� ����������!");
	if(IsPlayerEvent(playerid)) return SendClientMessage(playerid, -1, ""cER"� ���� ����������� ��������� ����������!");
	string = "";
	new num, id;
	PlayerVesItem[playerid]=0;
	for(new s = 1; s < MAX_SLOT; s++)
	{
		if(PlayerItem1[playerid][s] == 0)continue;
		id = PlayerItem1[playerid][s];
		PlayerUseList[playerid][num] = s;
		PlayerVesItem[playerid] += Item[id][iGG]*PlayerItem2[playerid][s];
		num++;
		if(Item[id][iStek] == 1)
		{
			if(id == 44) format(string,sizeof(string),"%s{808080}[%d�] "cWH"%s "cMain"(%d �����)\n",string,PlayerItem2[playerid][s]*Item[id][iGG],Item[id][iName],PlayerItem2[playerid][s]);
			else format(string,sizeof(string),"%s{808080}[%d�] "cWH"%s "cMain"(%d ��)\n",string,PlayerItem2[playerid][s]*Item[id][iGG],Item[id][iName],PlayerItem2[playerid][s]);
		}
		else
		{
			switch(PlayerItem1[playerid][s])
			{
				case 107: format(string,sizeof(string),"%s"cWH"%s (ID: %d)\n",string,Item[id][iName],PlayerItem2[playerid][s]);
				case 126: format(string,sizeof(string),"%s{808080}[%d�] "cWH"%s (�����: %s)\n",string,Item[id][iGG],Item[id][iName],PlayerItem3[playerid][s]);
				default: format(string,sizeof(string),"%s{808080}[%d�] "cWH"%s\n",string,Item[id][iGG],Item[id][iName]);
			}
		}
	}
	if(num > 0)
	{
		format(stringer,sizeof(stringer),"{808080}[%d/16]"cWH" ��������� [{fcdd76}%d"cWH"� / {ff7f50}%d"cWH"�]",num,PlayerVesItem[playerid],PI[playerid][pSprunk]);
		ShowPlayerDialog(playerid, 2200+2, DIALOG_STYLE_LIST, stringer, string, "�������", "�����");
	}
	else SendClientMessage(playerid,COLOR_GREY,""cER"��������� ������!");
	return true;
}

cmd:giveinv(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(PI[playerid][pBuyAdmin]) return SendClientMessage(playerid, COLOR_GREY, "�������� ��������������� ��������� ������������ /giveinv");
	if(sscanf(params, "iii",params[0],params[1],params[2])) return SendClientMessage(playerid, -1, ""cPS"���������: /giveinv [playerid] [Item] [kolv]");

	new newslot,kolv;
	if(Item[params[1]][iStek]==0){kolv=1;}
	else kolv=params[2];
	if(CheckMaxVes(params[0],params[1],kolv,newslot)==1) return SendClientMessage(playerid,COLOR_GREY,"� ������ ��� ���������� �����!");
	PlayerItem1[params[0]][newslot]=params[1];
	PlayerItem2[params[0]][newslot]+=kolv;
	SaveItem(params[0],newslot);

	format(string, sizeof(string), ""cAD"%s ������� ������� %s � ���������� %d", GetName(params[0]),Item[params[1]][iName],kolv);
	SendClientMessage(params[0], COLOR_GREY, string);
	fLogs("[admin] %s /giveinv %s %i %i", GetName(playerid), GetName(params[0]), params[1], params[2]);
	return true;
}

cmd:checkinv(playerid, params[])
{
	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "i",params[0])) return SendClientMessage(playerid, -1, ""cPS"���������: /checkinv [playerid]");

	string = "";
	new num;
	for(new s = 1; s < MAX_SLOT; s++)
	{
		if(PlayerItem1[params[0]][s]==0)continue;
		if(PlayerItem1[params[0]][s]>0)
		{
			new id=PlayerItem1[params[0]][s];
			PlayerUseList[playerid][num]=s;
			num++;
			if(Item[id][iStek]==1){format(string,sizeof(string),"%s{808080}[%d�] "cWH"%s "cMain"(%d ��)\n",string,PlayerItem2[params[0]][s]*Item[id][iGG],Item[id][iName],PlayerItem2[params[0]][s]);}
			else
			{
				switch(PlayerItem1[params[0]][s])
				{
				case 126:format(string,sizeof(string),"%s{808080}[%d�] "cWH"%s (�����: %s)\n",string,Item[id][iGG],Item[id][iName],PlayerItem3[params[0]][s]);
				default:format(string,sizeof(string),"%s{808080}[%d�] "cWH"%s\n",string,Item[id][iGG],Item[id][iName]);
				}
			}
		}
	}
	if(num > 0)
	{
		g_player_listitem_use[playerid] = params[0];
		new str[62];
		format(str,sizeof(str),""cWH" ��������� {808080}%s",GetName(params[0]));
		ShowPlayerDialog(playerid, 2200+10, DIALOG_STYLE_LIST, str, string, "�������", "�����");
		fLogs("[admin] %s /checkinv %s", GetName(playerid), GetName(params[0]));
	}
	else SendClientMessage(playerid,COLOR_GREY,""cER"��������� ������!");
	return true;
}

