				if(RoomsInfo[i][rLock] == 1) return SendClientMessage(playerid, -1,"���� �������� �������");
				RoomsInfo[i][rLock] = 1;
				GameTextForPlayer(playerid, "~r~�������", 5000, 5);
				format(string, 90, "%s ������ ����� � ������ ����� ��������", PI[playerid][pName]);
				ProxDetector(20.0,playerid,string,COLOR_PURPLE);
				SetRoomsInt(i, "rLock", RoomsInfo[i][rLock]);
			}
		}
		case 1: callcmd::rpanel(playerid);
		case 2: ShowPlayerDialog(playerid, 8050+5, 0, "������� ��������", "�� ������ ������� ���� ��������?", "��", "���");
	}
	return 1;
}
DLG(8055, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		new accountid = PI[playerid][pMainBankAccount];

		if(!IsValidBankAccount(playerid, accountid))
		return SendClientMessage(playerid, COLOR_RED, "� ��� �� ���������� �������� ���������� ����");

