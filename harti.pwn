	return 1;
}

cmd:giverank(playerid, params[])
{
	if(PI[playerid][pRank] < 9) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	new targetid;
	if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/giverank [id ������]");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(targetid == playerid) return SendClientMessage(playerid, -1, ""cER"�� �� ������ ���� ���� ����!");
	if(!PI[targetid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "����� �� ��������� � �����������!");
	if(PI[targetid][pLeader] > 0) return SendClientMessage(playerid, COLOR_GREY, "����� ����� ������ �����������!");
	if(GetDistanceBetweenPlayers(playerid, targetid) > 8.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������� ������!");
	if(PI[targetid][pMember] != PI[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "����� ���������� � ������ �����������!");
	new str[45], str2[765], full = 0;
	for(new i = 1; i < MAX_RANGS-1; i++)
	{
		if(i == 8 && PI[playerid][pRank] == 9 && !PI[playerid][pMainSub]) break;
		format(str, sizeof(str), "���� �%d - %s\n", i, frakRangName[PI[playerid][pMember]][i]);
		strcat(str2, str);
		full++;
	}
	if(full == 0) return SendClientMessage(playerid, -1, ""cER"���������� � �������������!");
	PlayerRank[playerid] = targetid;
	ShowPlayerDialog(playerid, 49+1, 2, ""cMain"����", str2, "�������", "������");
	return 1;
}

