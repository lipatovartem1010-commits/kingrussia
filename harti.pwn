IsIpFound(text[])
{
	new count = 8;
	mfor(i, (strlen(text) - 1)) if(text[i] >= '0' && text[i] <= '9')
	{
		if(--count <= 0) return 1;

	}
	return 0;
}

CheckString(text[])
{
	static const WebSites[][] =
	{
		".ws", ".ru", ".tk", ".rp", "www", ".org", ".net", ".cc", ".��", ".by", ".biz", ".su", ".info", ".com", "vk.",
		"�������", "����� ������", "new ip", "��� �������", "mq", "����", "�����", "positiv", "���� ���", "������", "���� ��", "176.32.39.240",
		"217.106", "106.106", "����������", "���������", "���������", "pravda_prp", "����", "�������", "�������", "�������", "������� �����",
		"���� �����"
	};

	for(new i = 0; i < sizeof(WebSites); i++)
	{
		if(strfind(text, WebSites[i], true) != -1) return 1;
	}
	return 0;
}

CheckReport(text[])
{
	static const RepBot[][] = {"����� ���","����� ���","������� ���","�������","����� �����"};
