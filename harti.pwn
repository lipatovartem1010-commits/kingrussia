cmd:finvite(playerid, params[])
{
	if(PI[playerid][pFamilySozd] == 0 && PI[playerid][pFamilyZam] == 0) return SendClientMessage(playerid, COLOR_GREY, "��������� � ����� ����� ������ ��������� � ����������� �����.");
	if(sscanf(params, "d", params [0])) return SendClientMessage(playerid, COLOR_GREY, "��������: /finvite [id]");
	if(!IsPlayerConnected(params [0]) || params[0] == playerid) return SendClientMessage(playerid, COLOR_GREY, "������ �� ������ ID ������");
	if(GetDistanceBetweenPlayers(playerid, params[0]) > 5.0) return SendClientMessage(playerid, COLOR_GREY, "���� ����� ��������� ������ �� ���.");
	if(PI[params[0]][pFamily] > 0) return SendClientMessage(playerid, COLOR_GREY, "���� ����� ��� ������� � �����!");
	new text_string [46 + MAX_PLAYER_NAME + 32];
	format(text_string,sizeof(text_string),"�� ���������� %s �������������� � ����� %s",GetName(params[0]),family_info [PI[playerid][pFamily]] [f_name]);
	SendClientMessage(playerid,-1,text_string);

	format(string,sizeof(string),""cWH"%s ���������� ��� �������������� � ����� %s.\n�� �������� ��������������?",GetName(playerid),family_info[PI[playerid][pFamily]] [f_name]);
	ShowPlayerDialog(params[0],707,DIALOG_STYLE_MSGBOX,""cMain"����������� � �����",string,"��","���");
	player_family_invite[params[0]] = playerid;
	return 1;
}
cmd:funinvite(playerid, params[])
{
	new text[64];
	if(sscanf(params, "ds[64]",params[0],text)) return SendClientMessage(playerid, COLOR_GRAD2, "�����������: /funinvite [id] [�������]");
	if(PI[playerid][pFamilySozd] == 0 && PI[playerid][pFamilyZam] == 0) return SendClientMessage(playerid, COLOR_GREY,"�������� �� ����� ����� ������ ����������� � ���������.");
	if(params[0] == playerid) return SendClientMessage(playerid, COLOR_GRAD1, "�� �� ������ ������� ������ ����!");


	if(PI[params[0]][pFamilySozd] > 0 && GetString(family_info [PI[playerid][pFamily]] [f_creator], GetName(params[0])))
		return SendClientMessage(playerid, COLOR_GREY, "�� �� ������ ������� ��������� �����!");
	if(PI[playerid][pFamily] != PI[params[0]][pFamily]) return SendClientMessage(playerid, COLOR_GREY, "������ ����� �� ������� � ����� �����.");

	format(string, sizeof(string), "%s ������ ��� �� �����. �������: %s",GetName(playerid), text);
	SendClientMessage(params[0], 0xFFD39BFF, string);
	format(string, sizeof(string), "�� ������� ������ %s �� �����. ������� %s",GetName(params[0]), text);
	SendClientMessage(playerid, 0xFFD39BFF, string);
	family_info [ PI[params[0]][pFamily]] [ f_online ] -= 1;
	family_info [ PI[params[0]][pFamily] ] [ f_members_amount ] -= 1;
	PI[params[0]][pFamilySozd] =
	PI[params[0]][pFamily] =
	PI[params[0]][pFamilyZam] = 0;

	if(playerFamilyNameTag[params[0]] != INVALID_3DTEXT_ID)
	{
		UpdateDynamic3DTextLabelText(playerFamilyNameTag[ params[0] ], -1, " ");

		DestroyDynamic3DTextLabel(playerFamilyNameTag[params[0]]);
		playerFamilyNameTag[params[0]] = INVALID_3DTEXT_ID;
	}
	format(string,sizeof(string),"{%s}[%s]{FFD39B} %s(%s) ������ ������ %s �� �����. �������: %s",family_chat_color [family_info[PI[playerid][pFamily]] [f_chat_color ]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid), family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], GetName(params[0]),text);
	family_message(PI[playerid][pFamily],-1, string);
	format(string, sizeof string, "UPDATE `accounts` SET family = 0, familyzam = 0, familyrank = 0, familysozd = 0 WHERE name = '%s'", GetName(params[0]));
	mysql_function_query ( db_prod, string, false, "", "");
	return true;
}

OnServerUpdateFamilyData(field[], data, reason)
{
	STRING_GLOBAL[0] = EOS;
	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPDATE `family_system` SET `%s` = '%d' WHERE `fam_id` = '%d' LIMIT 1", field, data, reason);
	mysql_tquery(db_prod, STRING_GLOBAL, "", "");
	return 0x1;
}

cmd:setfamrank(playerid, params[])
{
	if(!PI[playerid][pFamily]) return SendClientMessage(playerid, -1, "�� �� �������� � �����!");
	if(!PI[playerid][pFamilySozd] && !PI[playerid][pFamilyZam]) return SendClientMessage(playerid, -1, "������ ����� ������ ��������� ����� � �����������");
	if(sscanf(params, "ii", params[0], params[1])) return SendClientMessage(playerid, -1, "�����������: /setfamrank [id ������] [����(�� 1 �� 6)]");
	if(params[1] < 1 || params[1] > 6) return SendClientMessage(playerid, -1, "���� �� 1 �� 6");
	if(playerid == params[0]) return SendErr(playerid, "������ ������ ���� ����");
	if(PI[playerid][pFamily] != PI[params[0]][pFamily]) return SendClientMessage(playerid, -1, "����� �� ������� � ����� �����");

	if(PI[params[0]][pFamilySozd] || PI[params[0]][pFamilyZam])
		return SendClientMessage(playerid, COLOR_RED, "�� �� ������ ���������� ���� ���������");

	format(string, sizeof(string), "{%s}[%s]{FFD39B} %s[%s] ��������� %d-� ���� ����� ����� %s",family_chat_color [family_info [PI[playerid][pFamily]] [f_chat_color]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid),family_rank_name[PI[playerid][pFamily]][PI[playerid][pFamilyRank] - 1], params[1], GetName(params[0]));
	family_message(PI[playerid][pFamily],-1, string);
	PI[params[0]][pFamilyRank] = params[1];
	MysqlUpdatePlayerInt(params[0], "familyrank", PI[params[0]][pFamilyRank]);
	return true;
}
cmd:k(playerid, params[])
{
	if(PI[playerid][pFamily] == 0)
		return SendErr(playerid, "�� �� �������� � �����");

	if(sscanf(params, "s[128]", params[0]))
		return SendInf(playerid, "/k [�����]");

	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, -1, PlayerHaveMuteTime);
	if(IsIpFound(params[0]) || CheckString(params[0])) return PlayerGetsChatBan(playerid, params[0]);

	format(string, sizeof(string), "{%s}[%s]{FFD39B} %s[%d]: %s",family_chat_color [family_info [PI[playerid][pFamily]] [f_chat_color]],family_info [PI[playerid][pFamily]] [f_name],GetName(playerid), playerid,params);
	family_message(PI[playerid][pFamily],-1, string);
	SetPlayerChatBubble(playerid, "���������� ��������� � �����",COLOR_PURPLE,30.0,10000);
	return true;
}
cmd:news(playerid, params[])
{
	if(PI[playerid][pMember] != TEAM_SMI) return SendClientMessage(playerid, COLOR_GREY, YouCanNot);
	if(IsPlayerInAnyVehicle(playerid))
	{
		new full = 0;
		for(new i = 1; i <= TOTALVEH; i++)
		{
			if(PI[playerid][pMember] == TEAM_SMI)
			{
				if(VehInfo[i][vFraction] == TEAM_SMI)
				{
					NewsPanel(playerid);
					full++;
					break;
				}
			}
		}
		if(full == 0) SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ����� ��� � ��������� ����������!");
	}
	else
	{
		if(IsPlayerInRangeOfPoint(playerid, 150.0, -92.6928,64.2366,1201.0000)) NewsPanel(playerid);
		else SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ����� ��� � ��������� ����������!");
	}
	return 1;
}

cmd:ad(playerid, params[])
{
	if(SearchInventoryItem(playerid,47)==0){return SendClientMessage(playerid, -1, ""cER"� ��� ��� ��������!");}
	if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_GREY, PlayerHaveMuteTime);
	if(PI[playerid][pTime] < 2) return SendClientMessage(playerid, -1, ""cPS"�� ������ ������ �� ������� ����� 2 �����!");
	if(PI[playerid][pPhoneNumber] <= 1) return SendClientMessage(playerid, -1, ""cER"� ��� ��� SIM-�����!");
	if(PI[playerid][pNews] == 0) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���� ����������� �� �����-���� ������� (/radio)");
	if(TOTALADVERT >= 15) return SendClientMessage(playerid, COLOR_GREY, "����� ���������, ���������� �����!");
	if(AdvertTime_[playerid] > unix) return SendClientMessage(playerid, COLOR_GREY, "�������� ���������� ����� ��� � ������!");
	if(sscanf(params, "s[128]", params[0])) return SendClientMessage(playerid, COLOR_WHITE, ""cPS"/ad [�����]");
	if(GetPlayerRubble(playerid) < strlen(params[0])*AdvertPrice) return SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
	TOTALADVERT++;

	strmid(AdvertInfo[TOTALADVERT][aText],params[0],0,strlen(params[0]),128);
	strmid(AdvertInfo[TOTALADVERT][aName],GetName(playerid),0,strlen(GetName(playerid)),MAX_PLAYER_NAME);
	AdvertInfo[TOTALADVERT][aPhone] = PI[playerid][pPhoneNumber];
	SetPlayerMoney(playerid, -(strlen(params[0]) * AdvertPrice));
	FracBank[8] += strlen(params[0]) * AdvertPrice;
	MysqlUpdateOtherInt("lsnbank", FracBank[8]);

	SendClientMessage(playerid, COLOR_LIGHTRED, "���� ���������� ���� ���������� �� ���������");
	SendFMes(18, COLOR_LIME, "� �������� ��������� ����� ����������!");
	format(stringer1, sizeof(stringer1), "~r~���� %d�~n~~w~������������ ���������: %d �������", strlen(params[0]) * AdvertPrice, strlen(params[0]));
	GameTextForPlayer(playerid, stringer1, 5000, 5);
	AdvertTime_[playerid] = unix + 60;
	return 1;
}

