GiveHealth(playerid, Float: Heal)
{
	new Float:amount;
	GetPlayerHealth(playerid, amount);
	SetPlayerHealth(playerid, amount + Heal);
	return 1;
}
CarDoorsEx(vehicleid, status)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 0;

	new bool:bovar;
	if(!status) bovar = false;
	else bovar = true;

	IsLocked[vehicleid] = bovar;

	new eengine, elights, ealarm, edoors, ebonnet, eboot, eobjective;
	GetVehicleParamsEx(vehicleid, eengine, elights, ealarm, edoors, ebonnet, eboot, eobjective);
	SetVehicleParamsEx(vehicleid, eengine, elights, ealarm, status, ebonnet, eboot, eobjective);

	return 1;
}
GetInflationPrice(money) return money;
GetPlayerRooms(playerid)
{
	new room = 0;

	if(PI[playerid][pRoom] != -1)
	room = PI[playerid][pRoom];

	return room;
}
GetPlayerHouse(playerid)
{
	new house = 0;

	if(PI[playerid][pHouse] != -1)
	house = PI[playerid][pHouse];

	return house;
}
GetPlayerArendHouse(name[])
{
	new house = 0;

	for(new i = TOTALHOUSE; i > 0; i --)
	{
		if(!strcmp(HouseInfo[i][hOwner], name, true)) house++;
	}

	return house;
}
GetPlayerBizz(playerid)
{
	new bizz = 0;
	if(PI[playerid][pBiz] != -1) bizz = PI[playerid][pBiz];
	return bizz;
}
ConvertSeconds(number)
{
	new chou = floatround(number / 3600);
	new cmin = floatround((number / 60) - (chou * 60));
	new csec = floatround(number - ((chou * 3600) + (cmin * 60)));
	new stringd[12];
	if(chou) format(stringd, 12, "%d:%02i:%02i", chou, cmin, csec);
	else format(stringd, 12, "%d:%02i", cmin, csec);
	return stringd;
}
Convert(seconds, stringTo[], size = sizeof(stringTo))
{
	stringTo[0] = 0x0;
	new result[4];
	result[0] = floatround(seconds / (3600 * 24));
	result[1] = floatround(seconds / 3600);
	result[2] = floatround((seconds / 60) - (result[1] * 60));
	result[3] = floatround(seconds - ((result[1] * 3600) + (result[2] * 60)));
	switch(result[0])
	{
	case 0:
		{
			switch(result[1])
			{
			case 0: format(stringTo,size,"%02d:%02d",result[2],result[3]);
			default: format(stringTo,size,"%d:%02d:%02d",result[1],result[2],result[3]);
			}
		}
	}
	return 1;
}

IsPlayerInInvalidNosVehicle(playerid)
{
	#define MAX_INVALID_NOS_VEHICLES 52
	static const InvalidNosVehicles[MAX_INVALID_NOS_VEHICLES] =
	{
		581,523,462,521,463,522,461,448,468,586,417,425,469,487,512,520,563,593,
		509,481,510,472,473,520,595,484,430,453,432,476,497,513,533,577,
		452,446,447,454,590,569,537,538,570,449,519,460,488,511,519,548,592
	};
	if(IsPlayerInAnyVehicle(playerid))
	{
		for(new i = 0; i < MAX_INVALID_NOS_VEHICLES; i++)
		{
			if(GetVehicleModel(GetPlayerVehicleID(playerid)) == InvalidNosVehicles[i]) return 1;
		}
	}
	return 0;
}
