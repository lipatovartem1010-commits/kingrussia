DLG(18240, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;

	new count, id;

	if(sscanf(inputtext, "p<,>ii", id, count))
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
		"cWH"� ������ ���� �� ������ ������� ������ �� ������ �� ������:\n\n\
		"cWH"���� �1: {4ed74d}%s\n\
		"cWH"���� �2: {4ed74d}%s\n\n\
		{f7ff00}� ������ ������ ������ �����, �� �������� �� ���� ��������� ����� ����� ������\n\
		��������: ��������� 100.000 ��� - �������� 200.000 ���\n\
		����������� ������: 10.000 ������, ������������: 1.000.000 ������\n\n\
		������: 1, 10000", fights_player[0], fights_player[1]);
		ShowPlayerDialog(playerid, 18239+1, DIALOG_STYLE_INPUT, ""cMain"������� ����� ������:", global_string, "�������", "������");
		SendClientMessage(playerid, COLOR_RED, "������� �������� ���������");
		return 0x1;
	}
	if(id <= 0 || id >= 3)
	{
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
		"cWH"� ������ ���� �� ������ ������� ������ �� ������ �� ������:\n\n\
		"cWH"���� �1: {4ed74d}%s\n\
		"cWH"���� �2: {4ed74d}%s\n\n\
		{f7ff00}� ������ ������ ������ �����, �� �������� �� ���� ��������� ����� ����� ������\n\
		��������: ��������� 100.000 ��� - �������� 200.000 ���\n\
		����������� ������: 10.000 ������, ������������: 1.000.000 ������\n\n\
		������: 1, 10000", fights_player[0], fights_player[1]);
		ShowPlayerDialog(playerid, 18239+1, DIALOG_STYLE_INPUT, ""cMain"������� ����� ������:", global_string, "�������", "������");
		SendClientMessage(playerid, COLOR_RED, "������� �������� ���������");
		return 0x1;
	}

	if(!strcmp(fights_player[id-1], "None"))
	return SendClientMessage(playerid, COLOR_RED, "�������� ��� �� ���������������.");

	if(GetPlayerRubble(playerid) < count) return SendClientMessage(playerid, COLOR_RED, "� ��� ��� ����� ������� �� �����");
	if(!(10000 <= count <= 1000000)) return SendClientMessage(playerid, COLOR_RED, "������ ��������� �� ����� ����� 10.000 � �� ����� 1.000.000 ���");

	if(fights_duel) return SendClientMessage(playerid, COLOR_RED, "��� ��� ��� ;)");

	SetPlayerMoney(playerid, -count);
	fights_bank += count;

	fights_money[playerid] += count;
