callback::CheckTickets(playerid, find)
{
	new rows, fields;
	cache_get_data(rows, fields);
	global_string = "";
	if(rows)
	{
		if(find) return SCM(playerid,-1,"� ��� ������� ������������ ������, �������� ����������!");
		new Names2[MAX_PLAYER_NAME],full,Date[12];
		for(new idx = 0; idx < rows; idx++)
		{
			cache_get_field_content(idx,"Name",Names2);
			cache_get_field_content(idx,"Date",Date);
			format(stringer,sizeof stringer,""cWH"%d. {B4B3B2}� %d "cWH"� ������: {B4B3B2}%d ������ "cWH" ����: {B4B3B2}%s\n",idx+1,cache_get_field_content_int(idx, "Num", db_prod),cache_get_field_content_int(idx, "Sum", db_prod),Date);
			strcat(global_string,stringer);
			full++;
			SetPlayerListitemValue(playerid, idx, cache_get_field_content_int(idx, "Num", db_prod));
		}
		format(stringer1,sizeof stringer1,""cMain"������ %s | ����� %d",Names2,full);
		ShowPlayerDialog(playerid,12006,DIALOG_STYLE_LIST,stringer1,global_string,"�����","������");
	}
	else
	{
		if(find) return ShowPlayerDialog(playerid,12005,DIALOG_STYLE_MSGBOX,""cMain"����� ����������","{B4B3B2}�� ������ ��������� � ��� ����� �������� 5000 ������.\n�� ��������?","��","���");
		ShowPlayerDialog(playerid,0,DIALOG_STYLE_MSGBOX,""cMain"������","���������� � ������� �� �������!","�������","");
	}
	return 1;
}
