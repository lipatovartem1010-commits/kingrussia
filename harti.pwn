	if(params < 1 || params > 9999999) { ShowPlayerDialog(playerid, 3800+3, 1, ""cMain"����� ��������", ""cWH"������� ����� �������� ��������:", "�������", "�����"); return SendClientMessage(playerid, -1, ""cER"�������� ����� ��������!"); }
