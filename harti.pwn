		case 5: ShowPlayerDialog(playerid, 106+27, 1, ""cMain"�������� ��������", ""cWH"������� �-�� ������, ������� ������ �������� {FFFF00}(1��. = 2�):", "�������", "������");
		case 6:
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
			"cMain"1."cWH" ����������� ������\t"cMain"���������: %d/10"cWH"\t"cMain"���������:"cMain" %d ����"cWH"", BizzInfo[i][bUpdate], (BizzInfo[i][bUpdate] + 1) * 1000);
			ShowPlayerDialog(playerid, 5003, DIALOG_STYLE_LIST, ""cMain"���������", STRING_GLOBAL, "�������", "������");
