			{FFFFFF}�� �������� ��� ���������� ����� "cMain"���������� ����", 0xAFAFAFFF, 461.9609,1679.4919,12.1884, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

			DonateText[1] = CreateDynamic3DTextLabel("\
