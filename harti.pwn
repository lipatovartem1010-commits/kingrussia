	else if(PI[targetid][pVip] != -1) status_text = "VIP";
	else status_text = "�����";
	new sctring[1400], str[250];
	format(str,sizeof(str),""cWH"���:\t"cMain"%s\n",GetName(targetid));
	strcat(sctring,str);
	format(str,sizeof(str),""cWH"�������:\t{FFAA44}%d\n",PI[targetid][pLevel]);
