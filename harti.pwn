callback::OnPlayerSetPhoneNumber(playerid, number)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(GetPlayerRubble(playerid) < 3000) return SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
	if(rows)
	{
		SendClientMessage(playerid, COLOR_GREY, "����� ����� ��� ������������");
		ShowPlayerDialog(playerid, 5000, DIALOG_STYLE_INPUT, ""cMain"������� SIM-�����", ""cWH"������� ����� ������������ �����", "������", "�������");
		return 1;
	}
	PI[playerid][pPhoneNumber] = number;
	SCMF(playerid, -1, ""cDA"�� ������ SIM-�����. ��� �����: "cWH"%d", PI[playerid][pPhoneNumber]);

	SetPlayerMoney(playerid, -3000);
	MysqlUpdatePlayerInt(playerid, "phonenumber", PI[playerid][pPhoneNumber]);
