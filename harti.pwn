DLG(5236, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(strlen(inputtext) == 0)
		return SendClientMessage(playerid, COLOR_RED, "�� �� ����� ���");

		if(strlen(inputtext) > 64)
		{
			return SendClientMessage(playerid, COLOR_RED, "������������ ���������� �������� - 64!");
		}

		new to_player = INVALID_PLAYER_ID;

		to_player = friend_to_player[playerid];

		if(to_player == INVALID_PLAYER_ID)
		return SendClientMessage(playerid, COLOR_RED, "���� ����� �� � ����");

		if(PlayerLogged[to_player] == false) return SendClientMessage(playerid, COLOR_RED, "���� ����� �� � ����");

		if(Phone[to_player] == false)
		return SendClientMessage(playerid, -1, ""cPS"����� �������� �������!");

		if(PI[to_player][pJail] > 0)
		return SendClientMessage(playerid, -1, ""cPS"������� �������� ����������!");

		global_string = "";
		format(global_string, 144, "SMS: "cWH"%s {FFFF00}�����������: "cWH"%s {FFFF00}���.: "cWH"%d", inputtext, GetName(playerid), PI[playerid][pPhoneNumber]);
		SendClientMessage(to_player, COLOR_YELLOW, global_string);

		global_string = "";
		format(global_string, 144, "SMS: "cWH"%s {FFFF00}����������: "cWH"%s {FFFF00}���.: "cWH"%d", inputtext, GetName(to_player), PI[to_player][pPhoneNumber]);
		SendClientMessage(playerid, COLOR_YELLOW, global_string);

		PI[playerid][pPhoneBalance] -= 10;
		SendClientMessage(playerid, COLOR_WHITE, "���� ��������� ����������");
		MeAction(playerid, "������ ��������� �������");
	}
	return 1;
}
DLG(9437, playerid, response, listitem, inputtext[])
{
	if(response)
	{
		if(strlen(inputtext) == 0)
