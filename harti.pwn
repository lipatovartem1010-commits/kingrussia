new add_player;
stock check_acsid(playerid, accs) {

	new names_acs[19], acs_close = 0, access = -1;

	switch accs do {
	    case 612: names_acs = "����";
	    case 613: names_acs = "��� #1";
	    case 614: names_acs = "��� #2";
	    case 615: names_acs = "��� #3";
     	case 616: names_acs = "��� #4";
     	case 617: names_acs = "��� #5";
     	case 618: names_acs = "��� #6";
		case 619: names_acs = "����� �������";
		case 620: names_acs = "������ �������";
		case 621: names_acs = "������� �� �����";
		case 622: names_acs = "������ (�������)";
		case 623: names_acs = "������� ������";
		case 624: names_acs = "������ ������";
		case 625: names_acs = "����� ������";
		case 626: names_acs = "������� ������";
		case 627: names_acs = "������� ������";
		case 628: names_acs = "��������� ������";
		case 629: names_acs = "׸���� ������";
		case 630: names_acs = "����-׸���� ������";
		case 631: names_acs = "������� ������";
		case 632: names_acs = "����� ������";
		case 633: names_acs = "����� �� �����";
		case 634: names_acs = "���������� ����";
		case 635: names_acs = "���� ��";
		case 636: names_acs = "����������";
	    default: names_acs = "�����������", acs_close = 1;

	}

	if(acs_close == 1) return SendClientMessage(add_player, -1, "�� ���������� ID");


	SCMF(playerid, COLOR_YELLOW, "��� ��� �������� ����� ��������� '%s' �����������: /accs (����� ��� �����)", names_acs);
	SCM(playerid, COLOR_YELLOW, "��������� �������� ����� ���������� � ����.");

	mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "INSERT INTO `accounts_accessories` (`owner`, `name`, `objectid`) VALUES ('%d', '%e', '%d')", PI[playerid][pID], names_acs, accs);
	mysql_tquery(db_prod, STRING_GLOBAL, "accessories_in", "ii", playerid, access);

	acs_close = 0;

	return accs;
}
cmd:idacs(playerid) {

    if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	return ShowPlayerDialog(playerid, 0, 0, "ID �����������",
	"{FFFF00}ID:{c0c0c0} 612{FFFF00} - ����\n\
	{FFFF00}ID:{c0c0c0} 613{FFFF00} - ��� #1\nID:{c0c0c0} 614{FFFF00} - ��� #2\nID:{c0c0c0} 615{FFFF00} - ��� #3\nID:{c0c0c0} 616{FFFF00} - ��� #4\n{FFFF00}ID:{c0c0c0} 617{FFFF00} - ��� #4\n{FFFF00}ID:{c0c0c0} 618{FFFF00} - ��� #5\n\
	{FFFF00}ID:{c0c0c0} 619{FFFF00} - ����� �������\n{FFFF00}ID{c0c0c0} 621{FFFF00} - ������� �� �����\n\
	{FFFF00}ID{c0c0c0} 622{FFFF00} - ������ (�������)\n{FFFF00}ID{c0c0c0} 623{FFFF00} - ������� ������\n{FFFF00}ID{c0c0c0} 624{FFFF00} - ������ ������\n\
	{FFFF00}ID{c0c0c0} 625{FFFF00} - ����� ������\n{FFFF00}ID{c0c0c0} 626{FFFF00} - ������� ������\n{FFFF00}ID{c0c0c0} 627{FFFF00} - ������� ������\n{FFFF00}ID{c0c0c0} 628{FFFF00} - ��������� ������\n\
	{FFFF00}ID{c0c0c0} 629{FFFF00} - ׸���� ������\n{FFFF00}ID{c0c0c0} 630{FFFF00} - ����-׸���� ������\n{FFFF00}ID{c0c0c0} 631{FFFF00} - ������� ������\n\
	{FFFF00}ID{c0c0c0} 632{FFFF00} - ����� ������\n{FFFF00}ID{c0c0c0} 633{FFFF00} - ����� �� �����\n{FFFF00}ID{c0c0c0} 634{FFFF00} - ���������� ����\n\
	{FFFF00}ID{c0c0c0} 635{FFFF00} - ���� ��\n{FFFF00}ID{c0c0c0} 636{FFFF00} - ����������", "x", "");

}
cmd:additem(playerid, params[]) {

    new id, acs;

	if(PI[playerid][pAdmin] < 11) return 1;
	if(AdminLogged[playerid] == false) return SendClientMessage(playerid, -1, YouAreNotLoggedInAsAdmin);
	if(sscanf(params, "dd", id, acs)) return SendClientMessage(playerid, -1, "/additem [id player] [id acs (/idacs)]");
	if(acs == check_acsid(id, acs)) add_player = playerid, SCMF(playerid, -1, "�� ������� ������ '%d' ��������� ������ (����������: 1)", acs);
	else return SendClientMessage(playerid, -1, "������� ���������� ������������! ������ ID ����������: /idacs");

	return 1;
}
CMD:gt(playerid)
{
	STRING_GLOBAL[0] = EOS;

	format(STRING_GLOBAL, sizeof STRING_GLOBAL, "int %d world %d", GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
	SendClientMessage(playerid, -1, STRING_GLOBAL);
}

CMD:stream(playerid)
{
	if(streamer_mode[playerid] != 1)
	{
		SendClientMessage(playerid, 0xa48bcaFF, "�� ������� ������������ ����� ��������.");

		streamer_mode[playerid] = 1;

		HideWarningPanelAC(playerid);
	}

	else
	{
		SendClientMessage(playerid, 0xa48bcaFF, "�� ������� �������������� ����� ��������.");

		streamer_mode[playerid] = 0;

		ShowWarningPanelAC(playerid);
	}
}

