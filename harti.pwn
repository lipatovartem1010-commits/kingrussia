			DonateText[2] = CreateDynamic3DTextLabel("\
			{FFFF00}�������� ���� �������\n\
			{FFFFFF}��� ���������� �� "cMain"500{FFFFFF} ������ �������� � ������� "cMain"30%{FFFFFF} �� ����� ����������\n\
			{FFFFFF}��� ���������� �� "cMain"1.000{FFFFFF} ������ �������� � ������� "cMain"40%{FFFFFF} �� ����� ����������\n\
			{FFFFFF}��� ����������� �� "cMain"2.500{FFFFFF} ������ �������� � ������� "cMain"50%{FFFFFF} �� ����� ����������\n\n\
			{FFFFFF}�� �������� ��� ���������� ����� "cMain"���������� ����", 0xAFAFAFFF, 1807.0496,2513.7751,15.6717, 20.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, -1, -1, -1);

