stock RPTD_Euro(playerid)
{
	for(new i; i < 2; i++)
	{
		if(euro_PTD[playerid][i] == PlayerText:INVALID_TEXT_DRAW) return SendErr(playerid, "������ �������� RPTD_Euro #2");

