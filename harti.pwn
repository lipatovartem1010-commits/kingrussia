callback::GmTest(playerid, targetid, Float:oldhealth)
{
	new Float: newhealth;
	GetPlayerHealth(targetid, newhealth);
	new mes[256];
	if(oldhealth == newhealth) string = "{FF0000}�������� ����� ���������� God Mode(GM)";
	if(oldhealth != newhealth) string = "{05E900}�������� ����� ����, ���������� ��� HP ����������";
	format(mes, sizeof(mes), ""cWH"����: "cMain"%.0f.0 (HP)\n"cWH"�����: "cMain"%.0f.0 (HP)\n"cWH"����������� ��: "cMain"%.0f.0 (HP)\n\n%s", oldhealth, newhealth, oldhealth-newhealth, string);
	ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, GetName(targetid), mes, "�������", "");
	SetPlayerHealth(targetid, oldhealth);
	StartGMTest[playerid] = false;
	return 1;
}

callback::StealMats(playerid)
{
	if(PI[playerid][pAFK] >= 3) return 1;
	if(!IsPlayerInRangeOfPoint(playerid, 10.0, -2490.0676,-654.9683,29.6725))
	{
		PI[playerid][pInTakeMats] = 0;
		return 1;
	}

	new newslot;
	new ammo = random(5) + 1;
	new mats = random(5) + 5;

	if(gArmyWarehouse[1] > ammo)
	{
		if(CheckMaxVes(playerid,42,ammo,newslot)==1)return SendClientMessage(playerid,COLOR_GREY,"� ��� ��� ���������� ����� � ���������!");
		gArmyWarehouse[1] -= ammo;
		PlayerItem1[playerid][newslot]=42;
		PlayerItem2[playerid][newslot]+=ammo;
		SaveItem(playerid,newslot);
	}
	if(Mats[4] > mats)
	{
		Mats[4] -= mats;
		PI[playerid][pMats] += mats;
	}
	if(!Mats[4] && !gArmyWarehouse[1]) return SendClientMessage(playerid, COLOR_RED, "����� ����");

	format(global_string, 256,""cWH"��������: {63BD4E}%d ��.\n"cWH"����������: {63BD4E}%d ��.", gArmyWarehouse[1], Mats[4]);
	UpdateDynamic3DTextLabelText(gArmyWarehouseText,0xFFFFFFFF,global_string);

	format(stringer1, sizeof(stringer1), "~b~��������: ~g~+%d~n~~b~����������: ~r~+%d", ammo, mats);
	GameTextForPlayer(playerid, stringer1, 1500, 6);
	return 1;
}
