			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ������ �����!");
			ShowPlayerDialog(playerid, 77+2, 1, ""cMain"����", ""cWH"������� ID ��� ��� ������:", "�������", "������");
		}
	case 3:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "������ ���� ���������� �� ����� �����");
			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ������ �����!");
			if(EtherCall == false)
			{
				EtherCall = true;
				format(string, 90, "[F] %s ������� ����� �������",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_GREEN, string);
			}
			else
			{
				EtherCall = false;
				format(string, 90, "[F] %s �������� ����� �������",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_RED, string);
			}
		}
	case 4:
		{
			if(PI[playerid][pRank] < 8) return SendClientMessage(playerid, COLOR_RED, "������ ���� ���������� �� ����� �����");
			if(Ether[playerid] == false) return SendClientMessage(playerid, -1, ""cPS"�� ������ ���������� � ������ �����!");
			if(EtherSms == false)
			{
				EtherSms = true;
				format(string, 90, "[F] %s ������� ����� ���",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_GREEN, string);
			}
			else
			{
				EtherSms = false;
				format(string, 90, "[F] %s �������� ����� ���",GetName(playerid));
				SendFMes(PI[playerid][pMember], COLOR_RED, string);
			}
		}
	case 5:
		{
			if(PI[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_RED, "���������� ��� ������ �����");
			if(PI[playerid][pMuted] > 0) return SendClientMessage(playerid, COLOR_RED, "�� ����� ���� �� �� ������ ��������� ����������");
			AdvertList(playerid);
		}
	}
	return 1;
}
DLG(78, playerid, response, listitem, inputtext[])
{
	if(!response) return 1;
	new targetid;
	if(sscanf(inputtext, "u",targetid)) ShowPlayerDialog(playerid, 77+1, 1, ""cMain"����", ""cWH"������� ID ��� ��� ������:", "�������", "������");
	if(targetid == playerid) return SendClientMessage(playerid, -1, ""cER"�� �� ������ ���������� ����!");
	if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, PlayerIsNotOnline);
	if(PlayerLogged[targetid] == false) return SendClientMessage(playerid, -1, PlayerIsNotAuthorized);
	if(IsPlayerInAnyVehicle(playerid)&&!IsPlayerInVehicle(targetid, GetPlayerVehicleID(playerid)) || !IsPlayerInAnyVehicle(playerid) && GetDistanceBetweenPlayers(playerid,targetid) > 10.0) return SendClientMessage(playerid, COLOR_GREY, "����� ������ ���������� � ���� � ����������!");
	if(EtherLive[targetid] == true) return SendClientMessage(playerid, COLOR_GREY, "����� ��� � ������ �����!");
	if(PI[playerid][pMember] == TEAM_SMI && PI[targetid][pNews] != 1)
	{
		SendMes(playerid, COLOR_GREY, "����� ������ ������� �����: %s", Fraction_Name[TEAM_SMI]);
		return 1;
	}
	EtherLive[targetid] = true;
	Etherfrac[targetid] = PI[playerid][pMember];
	SendMes(playerid, COLOR_LIGHTBLUE, "�� ���������� � ����: %s", GetName(targetid));
	SendMes(targetid, COLOR_LIGHTBLUE, "%s ��������� ��� � ����", GetName(playerid));
	return 1;
}
