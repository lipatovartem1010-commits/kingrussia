				family_info[f][f_money], family_info[f][f_euro], family_info[f][f_narko], family_info[f][f_patr]);
				ShowPlayerDialog(playerid, 7708, DIALOG_STYLE_LIST, ""cMain"����� �����", global_string, "�������", "�����");
			}
			else SendMes(playerid, COLOR_RED, "������ � ������ �������� � %d �����", family_info[f][f_sklad_dostup]);
		}
