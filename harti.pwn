						if(!IsPlayerInAnyVehicle(proposition_id)) ApplyAnimation(proposition_id,"GANGS","hndshkfa",4.0,0,0,0,0,0);
					}
				case PROPOSITION_TYPE_TICKET:
					{
						if(GetPlayerRubble(playerid) < value_1)
						{
							SendMes(proposition_id, -1, ""cER"� ������ %s ������������ �������!", GetName(playerid));
							SendClientMessage(playerid, -1, ""cER"� ��� �� ������� �����!");
						}
						else
