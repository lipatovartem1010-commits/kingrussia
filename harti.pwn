								SetPlayerSkin(playerid, PI[playerid][pModel]);
								SetPlayerSkin(proposition_id, PI[playerid][pModel]);

								MysqlUpdatePlayerInt(playerid, "model", PI[playerid][pModel]);
								MysqlUpdatePlayerInt(proposition_id, "model", PI[proposition_id][pModel]);
