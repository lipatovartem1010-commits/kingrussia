DLG(83, playerid, response, listitem, inputtext[])
{
	if(!response)
	{
		AdvertID[playerid] = 0;
		AdvertList(playerid);
		return 1;
	}
	switch(listitem)
	{
	case 0:
		{
			format(string, sizeof(string), ""cWH"�����: %s - �������: %s",AdvertInfo[AdvertID[playerid]][aText],AdvertInfo[AdvertID[playerid]][aName]);
			ShowPlayerDialog(playerid, 77+7, 0, ""cMain"����������", string, "�����", "");
		}
	case 1:
		{
			format(string, sizeof(string), ""cWH"�����: %s - �������: %s",AdvertInfo[AdvertID[playerid]][aText],AdvertInfo[AdvertID[playerid]][aName]);
			ShowPlayerDialog(playerid, 77+8, 1, ""cMain"����������", string, "�������", "�����");
		}
	case 2:
		{
			for(new i = AdvertID[playerid]; i <= TOTALADVERT - 1; i++)
			{
				AdvertInfo[i][aPhone] = AdvertInfo[i+1][aPhone];
				strmid(AdvertInfo[i][aText],AdvertInfo[i+1][aText],0,strlen(AdvertInfo[i+1][aText]), 128);
				strmid(AdvertInfo[i][aName],AdvertInfo[i+1][aName],0,strlen(AdvertInfo[i+1][aName]), MAX_PLAYER_NAME);
			}
			if(TOTALADVERT > 0) TOTALADVERT--;
			SendClientMessage(playerid, COLOR_LIGHTRED, "���������� �������");
			AdvertID[playerid] = 0;
			AdvertList(playerid);
		}
	case 3:
		{
			if(AdvertTime > unix)
			{
				AdvertID[playerid] = 0;
				SendClientMessage(playerid, COLOR_GREY, "���������� ���������� ����� ��� � 15 ������!");
				return AdvertList(playerid);
			}

			format(string, sizeof(string), "%s �����������: %s (���.: %d)",AdvertInfo[AdvertID[playerid]][aText], AdvertInfo[AdvertID[playerid]][aName], AdvertInfo[AdvertID[playerid]][aPhone]);
			SendClientMessageToAll(COLOR_GREEN, string);

			format(string, sizeof(string), "   �������� ���������� %s: %s[%d]",frakRangName[PI[playerid][pMember]][PI[playerid][pRank]], GetName(playerid), playerid);
			SendClientMessageToAll(COLOR_GREEN, string);
			for(new i = AdvertID[playerid]; i <= TOTALADVERT - 1; i++)
			{
				AdvertInfo[i][aPhone] = AdvertInfo[i+1][aPhone];
				strmid(AdvertInfo[i][aText],AdvertInfo[i+1][aText],0,strlen(AdvertInfo[i+1][aText]), 128);
				strmid(AdvertInfo[i][aName],AdvertInfo[i+1][aName],0,strlen(AdvertInfo[i+1][aName]), MAX_PLAYER_NAME);
			}
			if(TOTALADVERT > 0) TOTALADVERT--;
			AdvertTime = unix + 15;
			AdvertID[playerid] = 0;
			AdvertList(playerid);

			STRING_GLOBAL[0] = EOS;
			mysql_format(db_prod, STRING_GLOBAL, sizeof(STRING_GLOBAL), "SELECT * FROM `news` WHERE `user_id` = %d", PI[playerid][pID]);
			mysql_tquery(db_prod, STRING_GLOBAL, "OnMemoryCheckPlayerID", "i", playerid);
		}
	case 4:
		{
			format(string, sizeof(string), "[AD] %s: %s ��������: %s", AdvertInfo[AdvertID[playerid]][aName], AdvertInfo[AdvertID[playerid]][aText], GetName(playerid));
			SendAdminMessage(COLOR_YELLOW, string);
			for(new i = AdvertID[playerid]; i <= TOTALADVERT - 1; i++)
			{
				AdvertInfo[i][aPhone] = AdvertInfo[i+1][aPhone];
				strmid(AdvertInfo[i][aText],AdvertInfo[i+1][aText],0,strlen(AdvertInfo[i+1][aText]), 128);
				strmid(AdvertInfo[i][aName],AdvertInfo[i+1][aName],0,strlen(AdvertInfo[i+1][aName]), MAX_PLAYER_NAME);
			}
			if(TOTALADVERT > 0) TOTALADVERT--;
			SendClientMessage(playerid, COLOR_LIGHTRED, "���������� ���������� �������������");
			AdvertID[playerid] = 0;
			AdvertList(playerid);
		}
	}
	return 1;
}
