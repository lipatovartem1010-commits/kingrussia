		stringer1 = ""cMain"1. "cWH"������ ���. �����\n"cMain"2. "cWH"���������� � �������";
		if(g_gov_info[listitem][GOV_FRACTION] != 0) strcat(stringer1, "\n"cMain"3. "cWH"������� �������");
		ShowPlayerDialog(playerid, 4521, DIALOG_STYLE_LIST,""cMain"�������� ���. ��������",stringer1,"�����", "������");
